---
import PageFrame from '../site-standard/PageFrame.astro';
import Container from '../site-standard/Container.astro';
import Section from '../site-standard/Section.astro';
import ActiveCountryContext from '../site-standard/ActiveCountryContext.astro';
import StatusBadge from '../site-standard/StatusBadge.astro';
import ExchangeLogo from '../ExchangeLogo.astro';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';

export interface Props {
  slug: string;
  name: string;
  statusLabel: string;
  headline: string;
  detailText: string;
  officialUrl: string;
  commercialHref?: string | null;
  commercialCtaLabel?: string | null;
  promoCode?: string | null;
  promoCodeAuthority?: 'owner_confirmed' | 'unconfirmed';
}

const {
  slug,
  name,
  statusLabel,
  headline,
  detailText,
  officialUrl,
  commercialHref = null,
  commercialCtaLabel = null,
  promoCode = null,
  promoCodeAuthority = 'unconfirmed',
} = Astro.props;

const showConfirmedPromoCode = promoCodeAuthority === 'owner_confirmed' && Boolean(promoCode);
---

<PageFrame family="exchange" class="exchange-review-product exchange-review-product--unverified">
  <section class="unverified-hero" aria-labelledby="unverified-title" data-exchange={slug}>
    <Container size="wide" class="unverified-hero__inner">
      <div class="unverified-identity">
        <div class="unverified-logo"><ExchangeLogo slug={slug} name={name} size={72} variant="square" lazy={false} /></div>
        <p class="cbw-eyebrow">Exchange review · offer under review</p>
        <h1 id="unverified-title">{name} exchange review</h1>
        <p class="unverified-lede">{detailText}</p>
        <div class="unverified-country">
          <ActiveCountryContext
            compact={true}
            note={`Country context does not prove that ${name}, its products or any promotion are available in the active market.`}
          />
        </div>
      </div>

      <aside class="unverified-state-card">
        <StatusBadge label={statusLabel} tone="review" />
        <span>Current public state</span>
        <strong>{headline}</strong>
        <p>
          Bonus amounts, eligibility, KYC or deposit requirements, expiry and country availability remain under re-verification.
        </p>
        {showConfirmedPromoCode && promoCode && (
          <div class="unverified-code">
            <span>Owner-confirmed code</span>
            <PromoCodeCopy code={promoCode} exchange={name} />
          </div>
        )}
        {commercialHref ? (
          <a class="cbw-action unverified-primary" href={commercialHref} target="_blank" rel="noopener noreferrer sponsored">
            {commercialCtaLabel || `Register on ${name}`} →
          </a>
        ) : (
          <a class="cbw-action unverified-primary" href={officialUrl} target="_blank" rel="noopener noreferrer nofollow">
            Visit {name} official site →
          </a>
        )}
        <small>A confirmed registration route or code does not verify the missing offer or country facts.</small>
      </aside>
    </Container>
  </section>

  <Section container="prose" spacing="standard" tone="primary">
    <div class="cbw-prose">
      <h2>What is available now</h2>
      <p>
        This page remains useful as an exchange profile, but claim-bearing promotion details are intentionally withheld until the underlying offer record is verified again.
        Use the active market shown above as context, not as an availability guarantee.
      </p>
      <h2>What to check before using the exchange</h2>
      <ul>
        <li>Whether the exchange accepts residents of your current country.</li>
        <li>Which products, funding methods and withdrawal routes are available to your account.</li>
        <li>The current KYC and account-verification requirements shown by the exchange.</li>
        <li>The live promotion terms, if a campaign is available to you.</li>
      </ul>
      <p>
        Check the <a href={officialUrl} target="_blank" rel="noopener noreferrer nofollow">official {name} website</a> for current account-level terms,
        or return to the <a href="/exchanges/">exchange directory</a> to compare other profiles.
      </p>
    </div>
  </Section>
</PageFrame>

<style>
  .exchange-review-product--unverified { background: var(--cbw-surface-page); }
  .unverified-hero { color: #fff; background: radial-gradient(circle at 84% 10%,rgba(247,147,26,.14),transparent 28%),linear-gradient(135deg,#091321,#13233e 72%,#1a3456); }
  .unverified-hero__inner { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(300px,.7fr); gap: var(--cbw-space-7); align-items: center; padding-block: var(--cbw-space-7); }
  .unverified-logo { margin-bottom: var(--cbw-space-3); }
  .unverified-identity h1 { margin: 0; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(44px,6vw,70px); line-height: .92; letter-spacing: -.025em; text-transform: uppercase; }
  .unverified-lede { max-width: 720px; margin: var(--cbw-space-3) 0 0; color: rgba(255,255,255,.72); font-size: 13px; line-height: 1.6; }
  .unverified-country { max-width: 720px; margin-top: var(--cbw-space-4); }
  .unverified-state-card { display: grid; gap: var(--cbw-space-3); padding: var(--cbw-space-5); border: 1px solid rgba(255,255,255,.15); border-radius: var(--cbw-radius-panel); background: rgba(255,255,255,.075); }
  .unverified-state-card > span,.unverified-code > span { color: rgba(255,255,255,.5); font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .unverified-state-card > strong { font-family: 'Barlow Condensed','Inter',sans-serif; font-size: 29px; line-height: 1; text-transform: uppercase; }
  .unverified-state-card > p,.unverified-state-card > small { margin: 0; color: rgba(255,255,255,.58); font-size: 9px; line-height: 1.55; }
  .unverified-code { display: grid; gap: 5px; }
  .unverified-code :global(.pcc-row) { max-width: 100%; }
  .unverified-primary { width: 100%; min-height: 44px; font-size: 11px; }
  @media (max-width: 820px) { .unverified-hero__inner { grid-template-columns: 1fr; gap: var(--cbw-space-5); } .unverified-state-card { max-width: 560px; } }
  @media (max-width: 480px) { .unverified-identity h1 { font-size: 43px; } }
</style>
