---
/**
 * GovernedExchangePage (Issue #266, authority split #269).
 *
 * Factual offer claims and commercial link/code authority are intentionally independent.
 * A confirmed affiliate link MUST NOT unlock rich promo copy. The rich promo surface is
 * rendered only when the factual offer state itself is verified; otherwise we render the
 * neutral re-verification surface and may expose only the exact owner-confirmed promo code
 * plus an internal /go/<slug>/ registration hop backed by #269 commercial-route authority.
 */
import CleanLayout from '../../layouts/CleanLayout.astro';
import ExchangePromoPageV2 from './ExchangePromoPageV2.astro';
import ExchangeUnverifiedNotice from './ExchangeUnverifiedNotice.astro';
import '../../styles/exchange-page-standard-v1-responsive.css';
import type { ExchangePromoPageConfig } from '../../data/exchangePages/types';
import { resolvePublicOfferView } from '../../data/publicOfferView';
import { resolvePublicCommercialRoute } from '../../data/publicCommercialRoute';
import { NEUTRAL_PUBLIC_DETAIL } from '../../data/contracts/publicOfferAuthority';

export interface Props {
  config: ExchangePromoPageConfig;
}

const { config } = Astro.props;

// One explicit build/render clock for both projections.
const nowMs = Date.now();
const view = resolvePublicOfferView(config.slug, nowMs);
const commercialRoute = resolvePublicCommercialRoute(config.slug, nowMs);

// IMPORTANT: link authority alone never unlocks claim-bearing rich content.
// ExchangePromoPageV2 still contains claim-bearing config fields, so it is allowed only when
// the factual offer itself is verified AND the commercial destination is independently safe.
const claimsVerified = view?.publicState === 'verified' && view?.showVerifiedBadge === true;
const richPromoAllowed = claimsVerified && commercialRoute.externalAllowed === true;

const confirmedPromoCode = view?.promoCodeAuthority === 'owner_confirmed'
  ? view.promoCode
  : null;
const commercialHref = commercialRoute.externalAllowed
  ? `/go/${config.slug}/`
  : null;

const officialUrl = `https://www.${config.officialDomain}`;
const neutralTitle = `${config.name} exchange — offer under re-verification | CryptoBonusWorld`;
const neutralDescription = `${config.name} promotion details are being re-verified. Current promotion terms are not verified yet — check the exchange directly for current terms.`;
---

<CleanLayout
  title={richPromoAllowed ? config.pageTitle : neutralTitle}
  description={richPromoAllowed ? config.pageDescription : neutralDescription}
  canonical={config.canonicalUrl}
  ogImage={config.ogImage}
  ogTitle={richPromoAllowed ? config.ogTitle : neutralTitle}
  ogDescription={richPromoAllowed ? config.ogDescription : neutralDescription}
>
  {richPromoAllowed ? (
    <ExchangePromoPageV2 config={config} />
  ) : (
    <ExchangeUnverifiedNotice
      slug={config.slug}
      name={config.name}
      statusLabel={view?.statusLabel ?? 'Under re-verification'}
      headline={view?.bonusHeadline ?? 'Offer details are being re-verified'}
      detailText={NEUTRAL_PUBLIC_DETAIL}
      officialUrl={officialUrl}
      commercialHref={commercialHref}
      commercialCtaLabel={commercialRoute.ctaLabel}
      promoCode={confirmedPromoCode}
      promoCodeAuthority={view?.promoCodeAuthority ?? 'unconfirmed'}
    />
  )}
</CleanLayout>
