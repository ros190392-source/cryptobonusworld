---
import CleanLayout from '../../layouts/CleanLayout.astro';
import PageFrame from '../../components/site-standard/PageFrame.astro';
import FirstViewport from '../../components/site-standard/FirstViewport.astro';
import Section from '../../components/site-standard/Section.astro';
import ActiveCountryContext from '../../components/site-standard/ActiveCountryContext.astro';
import ExchangeDirectoryCard from '../../components/site-standard/ExchangeDirectoryCard.astro';
import { getFeaturedExchanges } from '../../data/exchanges';
import { getOffer } from '../../data/offers';
import { buildHomepageTop10 } from '../../data/homepageTop10';

const nowMs = Date.now();
const exchanges = getFeaturedExchanges();
const fitBySlug = new Map(buildHomepageTop10(nowMs).map(entry => [entry.slug, entry.bestFor]));
const cards = exchanges.map(exchange => ({
  exchange,
  offer: getOffer(exchange.slug),
  bestFor: fitBySlug.get(exchange.slug),
}));
---

<CleanLayout
  title="Crypto Promo & Referral Codes by Exchange | CryptoBonusWorld"
  description="Browse tracked crypto exchange promo and referral codes in one card view. Code confirmation, offer claims and country eligibility remain separate."
  canonical="https://cryptobonusworld.com/promo-codes/"
>
  <PageFrame family="directory" class="promo-directory-product">
    <FirstViewport
      family="directory"
      container="wide"
      eyebrow="Promo & referral codes"
      title="Tracked codes by exchange"
      lede="Compare exchange cards with current code and offer status. A confirmed referral code does not by itself prove a bonus amount, account eligibility or country availability."
    >
      <div class="promo-country">
        <ActiveCountryContext
          compact={true}
          note="The active market helps you review local context, but code confirmation remains separate from country eligibility."
        />
      </div>
    </FirstViewport>

    <Section container="wide" spacing="compact" tone="page" id="promo-codes">
      <header class="cbw-section-header cbw-section-header--split">
        <div>
          <p class="cbw-section-eyebrow">Tracked exchange codes</p>
          <h2 class="cbw-section-title">Promo-code cards</h2>
          <p class="cbw-section-lede">The same exchange-card language as the homepage and directory. Current offer and local eligibility states remain visible instead of being compressed into a wide table.</p>
        </div>
        <a class="promo-directory-link" href="/exchanges/">All exchange profiles →</a>
      </header>

      <div class="promo-card-grid cbw-card-grid cbw-card-grid--2" data-promo-card-grid>
        {cards.map(({ exchange, offer, bestFor }) => (
          <ExchangeDirectoryCard exchange={exchange} offer={offer} bestFor={bestFor} mode="promo" />
        ))}
      </div>

      <div class="promo-foot cbw-panel">
        <div>
          <strong>How to read these cards</strong>
          <span>A code can be owner-confirmed while bonus terms or local eligibility remain under review. Check the exchange-owned terms before acting on a promotion.</span>
        </div>
        <nav aria-label="Promo-code help links">
          <a href="/methodology/">How we verify</a>
          <a href="/faq/">FAQ</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        </nav>
      </div>
    </Section>
  </PageFrame>
</CleanLayout>

<style>
  .promo-directory-product { background: var(--cbw-surface-page); }
  .promo-country { max-width: 760px; margin-top: var(--cbw-space-4); }
  .promo-card-grid { --cbw-card-columns: 2; }
  .promo-directory-link { color: #925204; font-size: 11px; font-weight: 900; white-space: nowrap; }
  .promo-foot { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: var(--cbw-space-5); align-items: center; margin-top: var(--cbw-space-5); box-shadow: none; }
  .promo-foot > div { display: grid; gap: 3px; }
  .promo-foot strong { color: var(--cbw-text-primary); font-size: 12px; }
  .promo-foot span { max-width: var(--cbw-width-prose); color: var(--cbw-text-secondary); font-size: 10px; line-height: 1.5; }
  .promo-foot nav { display: flex; flex-wrap: wrap; gap: var(--cbw-space-3); }
  .promo-foot a { color: #925204; font-size: 10px; font-weight: 900; }
  @media (max-width: 699px) {
    .promo-card-grid { --cbw-card-columns: 1; }
    .promo-foot { grid-template-columns: 1fr; }
  }
</style>
