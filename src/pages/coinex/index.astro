---
/**
 * /coinex/ — governed neutral CoinEx status surface (Issue #269).
 *
 * The exact current CoinEx registration destination and referral code are
 * owner-confirmed commercial values. They remain independent from factual offer
 * claims: bonus amount, eligibility, KYC/deposit requirements, expiry, country
 * availability and other terms stay under re-verification.
 */
import CleanLayout from '../../layouts/CleanLayout.astro';
import ExchangeUnverifiedNotice from '../../components/exchange/ExchangeUnverifiedNotice.astro';
import { resolvePublicOfferView } from '../../data/publicOfferView';
import { resolvePublicCommercialRoute } from '../../data/publicCommercialRoute';
import { NEUTRAL_PUBLIC_DETAIL } from '../../data/contracts/publicOfferAuthority';

const slug = 'coinex';
const name = 'CoinEx';
const nowMs = Date.now();
const view = resolvePublicOfferView(slug, nowMs);
const route = resolvePublicCommercialRoute(slug, nowMs);
const commercialHref = route.externalAllowed ? `/go/${slug}/` : null;
const confirmedPromoCode = route.promoCodeAuthority === 'owner_confirmed'
  ? route.promoCode
  : null;

const pageTitle = 'CoinEx exchange — offer under re-verification | CryptoBonusWorld';
const pageDesc = 'CoinEx registration link and referral code are owner confirmed. Bonus, eligibility, KYC/deposit, expiry and country terms remain under re-verification.';
---

<CleanLayout
  title={pageTitle}
  description={pageDesc}
  canonical="https://cryptobonusworld.com/coinex/"
  ogImage="/media/exchanges/coinex/final/coinex-og-final-v1-1200x630-869369dc.jpg"
  ogTitle={pageTitle}
  ogDescription={pageDesc}
>
  <ExchangeUnverifiedNotice
    slug={slug}
    name={name}
    statusLabel={view?.statusLabel ?? 'Under re-verification'}
    headline={view?.bonusHeadline ?? 'Offer details are being re-verified'}
    detailText={NEUTRAL_PUBLIC_DETAIL}
    officialUrl="https://www.coinex.com/"
    commercialHref={commercialHref}
    commercialCtaLabel={route.ctaLabel}
    promoCode={confirmedPromoCode}
    promoCodeAuthority={route.promoCodeAuthority}
  />
</CleanLayout>
