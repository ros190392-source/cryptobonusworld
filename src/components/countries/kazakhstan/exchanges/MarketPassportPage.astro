---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import PageFrame from '../../../site-standard/PageFrame.astro';
import FirstViewport from '../../../site-standard/FirstViewport.astro';
import Section from '../../../site-standard/Section.astro';
import StatusBadge from '../../../site-standard/StatusBadge.astro';
import ExchangeLogo from '../../../ExchangeLogo.astro';
import {
  assertPortalRouteRecord,
  resolvePortalRoute,
} from '../../../../data/contracts/portalRouteGuards';
import {
  KZ_BINANCE_CANDIDATE,
  KZ_BYBIT_CANDIDATE,
  KZ_OKX_CANDIDATE,
} from '../../../../data/candidates/kzP0MarketProfileCandidates';
import type { CountryMarketProfileV1Candidate } from '../../../../data/contracts/researchToMarketProfileV1Bridge';

const exchangeIds = ['binance', 'bybit', 'okx'] as const;
type ExchangeId = typeof exchangeIds[number];

interface PassportConfig {
  exchangeId: ExchangeId;
  exchangeName: string;
  candidate: CountryMarketProfileV1Candidate;
}

const configs: Record<ExchangeId, PassportConfig> = {
  binance: { exchangeId: 'binance', exchangeName: 'Binance', candidate: KZ_BINANCE_CANDIDATE },
  bybit: { exchangeId: 'bybit', exchangeName: 'Bybit', candidate: KZ_BYBIT_CANDIDATE },
  okx: { exchangeId: 'okx', exchangeName: 'OKX', candidate: KZ_OKX_CANDIDATE },
};

const { exchangeId } = Astro.props as { exchangeId: ExchangeId };
const config = configs[exchangeId];
if (!config) throw new Error(`Unsupported Kazakhstan exchange passport: ${exchangeId}`);

const candidate = config.candidate;
const profile = candidate.proposedProfile;
const nowMs = Date.now();
const stale = Number.isFinite(Date.parse(candidate.source.nextReviewAt))
  && Date.parse(candidate.source.nextReviewAt) <= nowMs;

const routeRecord = assertPortalRouteRecord({
  routeId: `market-passport:${exchangeId}:kz:noindex-preview`,
  reviewPath: '/__design/cbw-v2/market-passport/',
  publicPath: `/countries/kazakhstan/exchanges/${exchangeId}/`,
  publicationState: 'draft',
  indexabilityAuthorized: false,
});

let publicResolutionRejected = false;
try { resolvePortalRoute(routeRecord, 'public'); } catch { publicResolutionRejected = true; }

const boundaryPass =
  publicResolutionRejected
  && candidate.source.exchangeId === exchangeId
  && candidate.source.countryCode === 'KZ'
  && candidate.publicAuthority === false
  && candidate.importable === false
  && (exchangeId !== 'okx' || candidate.state === 'blocked');

if (!boundaryPass) {
  throw new Error(`Kazakhstan ${exchangeId} candidate passport failed the governed noindex boundary.`);
}

const humanize = (value: string | undefined | null) =>
  (value ?? 'under_review').replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());

const availability = candidate.state === 'blocked'
  ? 'Blocked'
  : humanize(profile?.availability);
const statusTone = candidate.state === 'blocked'
  ? 'blocked'
  : stale
    ? 'review'
    : profile?.availability === 'available'
      ? 'verified'
      : profile?.availability === 'limited'
        ? 'limited'
        : 'review';
const statusLabel = candidate.state === 'blocked'
  ? 'Candidate blocked'
  : stale
    ? 'Evidence refresh required'
    : `${availability} · candidate only`;

const dimensions = [
  ['Availability', candidate.state === 'blocked' ? 'Blocked' : humanize(profile?.availability)],
  ['Regulation', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.regulation.state)],
  ['KYC', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.kyc.state)],
  ['Deposits', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.deposits.state)],
  ['Withdrawals', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.withdrawals.state)],
  ['Fiat & payments', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.fiatPayments.state)],
  ['Products', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.products.state)],
  ['Local bonus / referral', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.bonusAvailability.state)],
  ['Restrictions', candidate.state === 'blocked' ? 'Under review' : humanize(profile?.restrictions.state)],
] as const;

const limitations = candidate.limitations.slice(0, 6);
const unresolved = candidate.unresolvedDimensions.slice(0, 8);
---

<CleanLayout
  title={`${config.exchangeName} in Kazakhstan — Review Passport | CryptoBonusWorld`}
  description={`Noindex owner preview of the current ${config.exchangeName} × Kazakhstan candidate evidence. No ranking position or affiliate recommendation is published.`}
  noindex={true}
  bodyClass="kz-passport-preview"
>
  <PageFrame family="country" class="kz-passport-product">
    <div
      data-country-exchange-passport={exchangeId}
      data-candidate-state={candidate.state}
      data-country-code="KZ"
      data-ranking-position="none"
    >
      <FirstViewport
        family="country"
        container="wide"
        eyebrow="Kazakhstan · exchange evidence passport"
        title={`${config.exchangeName} in Kazakhstan`}
        lede="This owner-preview summarizes the current governed candidate only. It does not create a local ranking position, country-specific referral eligibility or permission to publish."
      >
        <div class="passport-identity">
          <span class="passport-flag" aria-hidden="true">🇰🇿</span>
          <ExchangeLogo slug={exchangeId} name={config.exchangeName} size={48} variant="square" lazy={false} />
          <div>
            <strong>{config.exchangeName} × Kazakhstan</strong>
            <StatusBadge label={statusLabel} tone={statusTone} />
          </div>
        </div>
      </FirstViewport>

      <Section container="standard" spacing="compact" tone="page" ariaLabel={`${config.exchangeName} Kazakhstan candidate summary`}>
        <div class="passport-summary cbw-panel">
          <div>
            <p class="cbw-section-eyebrow">Current candidate posture</p>
            <h2>{availability}</h2>
            <p>
              {candidate.state === 'blocked'
                ? 'The candidate is blocked and no CountryMarketProfile is materialized from the current evidence.'
                : stale
                  ? 'The evidence review window has passed. Current availability must be rechecked before any later promotion review.'
                  : 'The candidate contains reviewable evidence, but it remains non-importable and carries no public authority.'}
            </p>
          </div>
          <dl>
            <div><dt>Evidence checked</dt><dd>{candidate.source.lastCheckedAt.slice(0, 10)}</dd></div>
            <div><dt>Next review</dt><dd>{candidate.source.nextReviewAt.slice(0, 10)}</dd></div>
            <div><dt>Ranking position</dt><dd>None</dd></div>
            <div><dt>Public authority</dt><dd>No</dd></div>
          </dl>
        </div>
      </Section>

      <Section container="standard" spacing="compact" tone="primary" ariaLabel={`${config.exchangeName} Kazakhstan evidence dimensions`}>
        <header class="cbw-section-header">
          <p class="cbw-section-eyebrow">Evidence dimensions</p>
          <h2 class="cbw-section-title">What the candidate currently says</h2>
          <p class="cbw-section-lede">Each dimension remains independent. A positive licence or visible product surface cannot by itself establish local account, product or campaign eligibility.</p>
        </header>

        <div class="passport-dimensions cbw-grid cbw-grid--3">
          {dimensions.map(([label, value]) => (
            <article class="cbw-card passport-dimension">
              <span>{label}</span>
              <strong>{value}</strong>
            </article>
          ))}
        </div>

        {profile?.fiatPayments.methods?.length ? (
          <div class="payment-note cbw-card">
            <span>Observed local payment evidence</span>
            <strong>{profile.fiatPayments.methods.join(' · ')}</strong>
            <small>Method visibility is not universal account eligibility.</small>
          </div>
        ) : null}
      </Section>

      <Section container="prose" spacing="compact" tone="secondary" ariaLabel={`${config.exchangeName} Kazakhstan review limitations`}>
        <details class="passport-review-details cbw-panel" data-passport-review-details>
          <summary>What still needs verification</summary>
          <div class="passport-review-copy">
            {limitations.length > 0 && (
              <div>
                <h2>Material limitations</h2>
                <ul>{limitations.map(item => <li>{item}</li>)}</ul>
              </div>
            )}
            {unresolved.length > 0 && (
              <div>
                <h2>Unresolved dimensions</h2>
                <ul>{unresolved.map(item => <li>{humanize(item)}</li>)}</ul>
              </div>
            )}
            <p>
              This preview contains no affiliate action. A later public or commercial state would require a separate governed promotion decision using fresh evidence.
            </p>
          </div>
        </details>

        <a class="passport-back" href="/countries/kazakhstan/">← Kazakhstan market preview</a>
      </Section>
    </div>
  </PageFrame>
</CleanLayout>

<style>
  :global(body.kz-passport-preview) { background: var(--cbw-surface-page, #f7f8f4); }
  .kz-passport-product :global(.cbw-first-viewport--country) { --cbw-first-viewport-target: 230px; }
  .passport-identity { display: grid; grid-template-columns: auto 48px minmax(0,1fr); gap: 11px; align-items: center; margin-top: 18px; }
  .passport-flag { display: inline-flex; width: 48px; height: 48px; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.15); border-radius: var(--cbw-radius-control); background: rgba(255,255,255,.07); font-size: 30px; }
  .passport-identity > div { display: grid; gap: 5px; justify-items: start; }
  .passport-identity strong { color: #fff; font-size: 13px; }
  .passport-summary { display: grid; gap: var(--cbw-space-6); }
  .passport-summary h2 { margin: 0; color: var(--cbw-text-primary); font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(30px,4vw,42px); line-height: 1; text-transform: uppercase; }
  .passport-summary p { max-width: 640px; margin: 8px 0 0; color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.65; }
  .passport-summary dl { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin: 0; }
  .passport-summary dl div { display: grid; gap: 2px; padding: 10px 11px; border-radius: var(--cbw-radius-control); background: var(--cbw-surface-secondary); }
  .passport-summary dt,.passport-dimension span,.payment-note span { color: var(--cbw-text-muted); font-size: 8px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
  .passport-summary dd { margin: 0; color: var(--cbw-text-primary); font-size: 11px; font-weight: 900; }
  .passport-dimensions { align-items: stretch; }
  .passport-dimension { display: grid; gap: 7px; min-height: 84px; align-content: center; }
  .passport-dimension strong { color: var(--cbw-text-primary); font-size: 12px; line-height: 1.4; }
  .payment-note { display: grid; gap: 4px; margin-top: var(--cbw-space-4); }
  .payment-note strong { color: var(--cbw-text-primary); font-size: 12px; }
  .payment-note small { color: var(--cbw-text-muted); font-size: 9px; line-height: 1.5; }
  .passport-review-details summary { display: flex; min-height: 46px; align-items: center; justify-content: space-between; color: var(--cbw-text-primary); font-size: 13px; font-weight: 900; cursor: pointer; list-style: none; }
  .passport-review-details summary::-webkit-details-marker { display: none; }
  .passport-review-details summary::after { content: '+'; color: var(--cbw-text-muted); font-size: 18px; font-weight: 500; }
  .passport-review-details[open] summary::after { content: '−'; }
  .passport-review-copy { display: grid; gap: 16px; padding-top: 14px; border-top: 1px solid var(--cbw-border-standard); color: var(--cbw-text-secondary); font-size: 11px; line-height: 1.65; }
  .passport-review-copy h2 { margin: 0 0 7px; color: var(--cbw-text-primary); font-size: 13px; }
  .passport-review-copy ul { margin: 0; padding-left: 18px; }
  .passport-review-copy p { margin: 0; }
  .passport-back { display: inline-flex; margin-top: 14px; color: #925204; font-size: 10px; font-weight: 900; text-decoration: none; }
  @media (min-width: 760px) {
    .passport-summary { grid-template-columns: minmax(0,1.25fr) minmax(280px,.75fr); align-items: center; }
  }
  @media (max-width: 639px) {
    .kz-passport-product :global(.cbw-first-viewport--country) { --cbw-first-viewport-target: 270px; }
    .passport-identity { grid-template-columns: auto 44px minmax(0,1fr); }
    .passport-flag { width: 44px; height: 44px; font-size: 27px; }
    .passport-summary dl { grid-template-columns: 1fr; }
  }
</style>
