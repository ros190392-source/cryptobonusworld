---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ExchangePreviewHub from '../../../../components/exchange-preview/ExchangePreviewHub.astro';
import { batch01 } from '../../../../data/exchangePreview/batch-01';
import { batch02 } from '../../../../data/exchangePreview/batch-02';

const allEntries = [...batch01, ...batch02];
---

<CleanLayout
  title="All Exchange Owner Previews | CryptoBonusWorld"
  description="Noindex owner-review directory for all twenty prepared exchange preview pages. No verified codes, bonuses or affiliate actions are published."
  noindex={true}
>
  <ExchangePreviewHub
    hubId="all"
    title="All Exchange Owner Previews"
    eyebrow="Preview exchange directory · all prepared pages"
    lede="Twenty prepared exchange previews are grouped here for owner review. The directory shows presentation readiness only; commercial facts and production activation remain independently governed."
    entries={allEntries}
    expectedCount={20}
  />
</CleanLayout>
