---
import CleanLayout from '../layouts/CleanLayout.astro';
import HomepageTop10 from '../components/home/HomepageTop10.astro';
import PageFrame from '../components/site-standard/PageFrame.astro';
import FirstViewport from '../components/site-standard/FirstViewport.astro';
import Section from '../components/site-standard/Section.astro';
import Container from '../components/site-standard/Container.astro';

const pathways = [
  {
    number: '01',
    title: 'Choose a market',
    text: 'Country controls availability, restrictions, KYC and local payment context.',
  },
  {
    number: '02',
    title: 'Compare evidence states',
    text: 'Verified offers, research records and profiles under review remain visibly separate.',
  },
  {
    number: '03',
    title: 'Check the terms',
    text: 'Open the exchange profile and confirm current regional terms before registering or depositing.',
  },
];

const countryCards = [
  {
    flag: '🇰🇿',
    name: 'Kazakhstan',
    note: 'Three validated review profiles and a governed evidence matrix.',
    status: 'Pilot · review only',
    tone: 'pilot',
  },
  {
    flag: '🇵🇱',
    name: 'Poland',
    note: 'European regulatory and country evidence is being normalized.',
    status: 'Profiles in progress',
    tone: 'progress',
  },
  {
    flag: '🇩🇪',
    name: 'Germany',
    note: 'Existing GEO evidence is queued for the new profile contracts.',
    status: 'Under review',
    tone: 'review',
  },
  {
    flag: '🇧🇷',
    name: 'Brazil',
    note: 'Planned market expansion after the first country factory pilot.',
    status: 'Source mapping planned',
    tone: 'planned',
  },
];

const trustItems = [
  {
    number: '01',
    title: 'Official-source-first',
    text: 'Regulators and exchange-owned sources lead evidence collection.',
  },
  {
    number: '02',
    title: 'Country-specific truth',
    text: 'Global exchange facts never silently override local restrictions.',
  },
  {
    number: '03',
    title: 'Freshness and limitations',
    text: 'Checked dates, gaps and conflicts remain visible instead of being smoothed over.',
  },
  {
    number: '04',
    title: 'Affiliate separation',
    text: 'Commercial status cannot create a ranking row or improve its position.',
  },
];

const updates = [
  {
    date: 'July 2026',
    label: 'Research record',
    title: 'Binance Kazakhstan evidence lifecycle completed',
    detail: 'Local entity, licence, KYC and public P2P surfaces mapped with explicit limitations.',
  },
  {
    date: 'July 2026',
    label: 'Product update',
    title: 'One governed Homepage Top-10 published',
    detail: 'Verified offers and neutral research rows now share one clearly labeled comparison surface.',
  },
  {
    date: 'In progress',
    label: 'Platform work',
    title: 'Country and language foundations',
    detail: 'Country facts and translated presentation are being built as separate controlled layers.',
  },
];

const guideBlocks = [
  {
    h3: 'What is a crypto referral code?',
    p: 'A crypto referral code (also called a promo code or invite code) is a short identifier you enter during sign-up at a crypto exchange. It links your new account to a partner, which can unlock a welcome bonus, fee discount, or other new-user reward that is not available to accounts created without a code.',
  },
  {
    h3: 'How to claim a crypto sign-up bonus',
    p: 'Open the exchange’s official offer page through a verified link, create a new account, and apply the code if it is not already pre-filled. Most exchanges also require identity verification (KYC) and a qualifying deposit before any reward becomes available — complete these steps before making further deposits so you do not miss a bonus tier.',
  },
  {
    h3: 'Why bonus amounts are not guaranteed',
    p: 'Advertised bonus figures are maximum amounts, not typical results. Reaching the full advertised amount usually requires completing several tasks — a deposit above a set threshold, a minimum trading volume, and finishing KYC — within a limited time window, often 30 days. Most users receive a partial reward rather than the headline figure.',
  },
  {
    h3: 'Common bonus requirements',
    p: 'Bonus programs vary by exchange, but frequently include identity verification (KYC), a minimum first deposit, a trading volume milestone, and a deadline to complete all tasks. Some rewards are issued as trading fee vouchers rather than withdrawable cash. Always read the current terms on the exchange’s official page before depositing.',
  },
  {
    h3: 'Referral link vs promo code',
    p: 'A referral link and a promo code often unlock the same offer, but work differently. A referral link usually applies the code automatically when you register through it. A promo code must be entered manually during sign-up, typically in a dedicated field. We list both where available — use the link where possible, and keep the code visible as a backup.',
  },
  {
    h3: 'How CryptoBonusWorld checks exchange codes',
    p: 'We check each listed code and bonus offer directly against the exchange’s own promotions page, not third-party forums or expired affiliate databases. Each exchange page on this site shows the date it was last verified. Promotions change frequently — if something looks outdated, check the individual exchange page for the latest information.',
  },
];

const faqs = [
  {
    q: 'What is a crypto referral code?',
    a: 'It’s a code entered at sign-up that links your account to a partner offer. Applying it can unlock a welcome bonus or fee discount that is not available otherwise. See the guide above for more detail on how these work.',
  },
  {
    q: 'Do I need to enter the code manually?',
    a: 'It depends on the exchange. Some auto-apply the code when you use our link — you just complete registration. Others require you to paste the code into a field during signup. Copy the code before clicking, just in case.',
  },
  {
    q: 'Are crypto exchange bonuses guaranteed?',
    a: 'No. Welcome bonuses are not guaranteed for every user. Advertised amounts are maximums — reaching them typically requires completing multiple tasks such as a deposit, a trading volume milestone, and KYC within a set window. Many users receive a partial bonus. Always read the full terms on the exchange’s official website before depositing.',
  },
  {
    q: 'Why do offers differ by country?',
    a: 'Bonus programs are subject to local regulations, exchange licensing, and KYC requirements. An offer available in one country may be restricted or unavailable in another. Always check the exchange’s terms for your region before signing up.',
  },
  {
    q: 'Are these affiliate links?',
    a: 'Yes. Links marked “Check offer” are affiliate referral links. If you register through one, CryptoBonusWorld may earn a commission from the exchange. This does not cost you anything extra and does not change your bonus. See our affiliate disclosure for details.',
  },
  {
    q: 'Which exchange bonus is best?',
    a: 'There is no single “best” bonus for everyone — it depends on your priorities, region, eligibility, and how much activity each reward requires. Compare the verification badge and current details on each exchange page before deciding.',
  },
  {
    q: 'How often are codes checked?',
    a: 'We check each exchange’s promo codes regularly, with the date of the last check shown on each exchange page. Promotions change frequently — if a code looks outdated, check the most recent version on the official exchange website.',
  },
  {
    q: 'Can a code expire?',
    a: 'Yes. Exchanges can change or discontinue a promo code or referral offer at any time, without notice. We recheck listed codes regularly and update or remove them if they stop working. If a code on this site appears expired, check the individual exchange page for the latest version.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<CleanLayout
  title="Compare Crypto Exchanges by Offer & Evidence | CryptoBonusWorld"
  description="Compare 10 crypto exchanges in one governed view. See verified offers, research status, country context, limitations, and current evidence before choosing an exchange."
  ogImage="/og-default.png"
  bodyClass="cbw-homepage-ranking-first"
>
  <PageFrame family="homepage" class="homepage-v2">
    <main>
      <FirstViewport
        family="homepage"
        container="wide"
        eyebrow="Checked by country · backed by evidence"
        title="Find the right crypto exchange for your market."
        lede="Compare 10 exchanges with offer, research and country-context states kept clearly separate."
      >
        <div class="hero-meta" aria-label="Market, language and ranking context">
          <span><b>Country</b> Global</span>
          <span><b>Language</b> English</span>
          <span><b>Ranking</b> 10 governed rows</span>
          <a href="#exchanges">Open Top 10 ↓</a>
          <a href="#markets">Markets ↓</a>
        </div>
      </FirstViewport>

      <HomepageTop10 />

      <Section container="wide" spacing="compact" tone="page" class="path-section" ariaLabel="How CryptoBonusWorld works">
        <div class="path-grid">
          {pathways.map(path => (
            <article class="path-card">
              <span>{path.number}</span>
              <h2>{path.title}</h2>
              <p>{path.text}</p>
            </article>
          ))}
        </div>
      </Section>

      <Section container="wide" spacing="standard" tone="secondary" id="markets" class="markets">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Country-first discovery</p>
            <h2>Explore markets, not duplicate rankings.</h2>
            <p>Country cards show research readiness only. They do not create a second exchange table on the homepage.</p>
          </div>
          <span class="section-state">Country pages in controlled preview</span>
        </header>

        <div class="country-grid">
          {countryCards.map(country => (
            <article class="country-card">
              <div class="country-top"><span class="country-flag">{country.flag}</span><span class={`country-tone tone-${country.tone}`}></span></div>
              <h3>{country.name}</h3>
              <p>{country.note}</p>
              <strong>{country.status}</strong>
            </article>
          ))}
        </div>
      </Section>

      <section class="trust">
        <Container size="wide" class="trust-grid">
          <div class="trust-copy">
            <p class="eyebrow">Why trust CryptoBonusWorld</p>
            <h2>Evidence is a product feature, not a footnote.</h2>
            <p>We show what was checked, what remains uncertain, and when a profile needs review. Missing evidence produces a visible limitation — not an invented answer.</p>
            <a class="trust-link" href="#guide">Read the bonus guide</a>
          </div>
          <div class="trust-list">
            {trustItems.map(item => (
              <article><span>{item.number}</span><div><strong>{item.title}</strong><p>{item.text}</p></div></article>
            ))}
          </div>
        </Container>
      </section>

      <Section container="wide" spacing="standard" tone="primary" class="updates">
        <header class="section-heading">
          <div><p class="eyebrow">Research and product changes</p><h2>Latest governed updates</h2></div>
        </header>
        <div class="updates-list">
          {updates.map(update => (
            <article class="update-row">
              <span class="update-date">{update.date}</span>
              <div><strong>{update.title}</strong><p>{update.detail}</p></div>
              <span class="update-label">{update.label}</span>
            </article>
          ))}
        </div>
      </Section>

      <Section container="prose" spacing="standard" tone="secondary" id="guide" class="guide">
        <p class="eyebrow">Guide</p>
        <h2>Crypto exchange bonuses guide</h2>
        <div class="guide-list">
          {guideBlocks.map(block => (
            <article><h3>{block.h3}</h3><p>{block.p}</p></article>
          ))}
        </div>
      </Section>

      <Section container="prose" spacing="standard" tone="primary" id="faq" class="faq">
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map(item => (
            <details><summary>{item.q}</summary><p>{item.a}</p></details>
          ))}
        </div>
      </Section>

      <Section container="prose" spacing="compact" tone="page" class="disclosure">
        <p>
          <strong>Disclosure:</strong> CryptoBonusWorld may earn a commission when you register through approved links on this site.
          This does not affect editorial status or ranking position. Advertised bonus amounts are maximums and depend on eligibility,
          KYC, deposits, trading activity, deadlines, and local terms. Verify current conditions on the official exchange website before
          registering or depositing. Cryptocurrency trading carries significant risk and nothing here is financial advice.
          Read our <a href="/affiliate-disclosure/">affiliate disclosure</a>.
        </p>
      </Section>

      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </main>
  </PageFrame>
</CleanLayout>

<style>
  :global(body.cbw-homepage-ranking-first) { background: var(--cbw-surface-page); }
  .homepage-v2 { color: var(--cbw-text-primary); background: var(--cbw-surface-page); }
  .eyebrow { margin: 0 0 var(--cbw-space-3); color: var(--cbw-action); font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--cbw-text-primary); font-family: 'Barlow Condensed', sans-serif; font-size: clamp(34px, 5vw, 54px); letter-spacing: -.025em; line-height: .98; text-transform: uppercase; }

  :global(.homepage-v2 .cbw-first-viewport) {
    background: radial-gradient(circle at 82% 10%, rgba(247,147,26,.2), transparent 30%), linear-gradient(135deg,#0c1729,#13233e 68%,#1c355b);
  }
  :global(.homepage-v2 .cbw-first-viewport__inner) { padding-block: 16px; }
  :global(.homepage-v2 .cbw-display-title) { max-width: var(--cbw-width-standard); font-size: clamp(40px, 4.6vw, 58px); }
  :global(.homepage-v2 .cbw-lede) { max-width: var(--cbw-width-prose); margin-top: 8px; font-size: 14px; line-height: 1.5; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
  .hero-meta span, .hero-meta a { display: inline-flex; min-height: 28px; align-items: center; gap: 5px; padding: 0 10px; border: 1px solid rgba(255,255,255,.15); border-radius: var(--cbw-radius-pill); color: rgba(255,255,255,.75); background: rgba(255,255,255,.05); font-size: 9px; text-decoration: none; }
  .hero-meta b { color: #fff; }
  .hero-meta a { color: #ffd291; border-color: rgba(247,147,26,.34); background: rgba(247,147,26,.1); font-weight: 900; }

  .path-grid { display: grid; gap: var(--cbw-space-3); }
  .path-card { padding: var(--cbw-space-5); border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: var(--cbw-surface-primary); box-shadow: var(--cbw-shadow-panel); }
  .path-card > span { color: var(--cbw-action); font-size: 10px; font-weight: 900; }
  .path-card h2 { margin-top: var(--cbw-space-3); font-size: 25px; }
  .path-card p { margin: var(--cbw-space-2) 0 0; color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.6; }

  .section-heading { display: grid; gap: var(--cbw-space-4); align-items: end; margin-bottom: var(--cbw-space-7); }
  .section-heading p:last-child { max-width: var(--cbw-width-prose); margin: var(--cbw-space-3) 0 0; color: var(--cbw-text-secondary); line-height: 1.65; }
  .section-state { align-self: start; padding: 7px 10px; border-radius: var(--cbw-radius-pill); color: #fff; background: var(--cbw-text-primary); font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .country-grid { display: grid; gap: var(--cbw-space-3); }
  .country-card { padding: var(--cbw-space-5); border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: var(--cbw-surface-primary); }
  .country-top { display: flex; justify-content: space-between; align-items: center; }
  .country-flag { font-size: 30px; }
  .country-tone { width: 10px; height: 10px; border-radius: var(--cbw-radius-pill); background: #9ca3af; }
  .tone-pilot { background: var(--cbw-evidence); }
  .tone-progress { background: var(--cbw-action); }
  .tone-review { background: #3b82f6; }
  .country-card h3 { margin: var(--cbw-space-4) 0 var(--cbw-space-2); font-size: 20px; }
  .country-card p { min-height: 42px; margin: 0; color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.55; }
  .country-card strong { display: block; margin-top: var(--cbw-space-4); color: #925204; font-size: 9px; text-transform: uppercase; }

  .trust { padding-block: var(--cbw-space-10); color: #fff; background: #13233e; }
  .trust-grid { display: grid; gap: var(--cbw-space-7); }
  .trust-copy h2 { color: #fff; }
  .trust-copy > p:last-of-type { color: #bdc9d8; line-height: 1.65; }
  .trust-link { display: inline-flex; min-height: 44px; align-items: center; margin-top: var(--cbw-space-5); padding-inline: var(--cbw-space-5); border-radius: var(--cbw-radius-control); color: var(--cbw-text-primary); background: #fff; font-size: 12px; font-weight: 900; text-decoration: none; }
  .trust-list { display: grid; gap: var(--cbw-space-3); }
  .trust-list article { display: grid; grid-template-columns: auto 1fr; gap: var(--cbw-space-3); padding: var(--cbw-space-4); border: 1px solid rgba(255,255,255,.12); border-radius: var(--cbw-radius-card); background: rgba(255,255,255,.05); }
  .trust-list article > span { color: var(--cbw-action); font-size: 10px; font-weight: 900; }
  .trust-list strong { display: block; }
  .trust-list p { margin: var(--cbw-space-2) 0 0; color: #bdc9d8; font-size: 11px; line-height: 1.55; }

  .updates-list { overflow: hidden; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); }
  .update-row { display: grid; gap: var(--cbw-space-3); padding: var(--cbw-space-5); border-top: 1px solid #e4e8e3; }
  .update-row:first-child { border-top: 0; }
  .update-date { color: var(--cbw-text-muted); font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .update-row strong { display: block; }
  .update-row p { margin: var(--cbw-space-2) 0 0; color: var(--cbw-text-secondary); font-size: 11px; line-height: 1.55; }
  .update-label { align-self: start; justify-self: start; padding: 6px 8px; border-radius: var(--cbw-radius-pill); color: #8a4d00; background: #fff0dc; font-size: 8px; font-weight: 900; text-transform: uppercase; }

  .guide-list { display: grid; gap: var(--cbw-space-6); margin-top: var(--cbw-space-7); }
  .guide-list article { padding-top: var(--cbw-space-5); border-top: 1px solid var(--cbw-border-standard); }
  .guide-list h3 { margin: 0; font-size: 17px; }
  .guide-list p { margin: var(--cbw-space-2) 0 0; color: var(--cbw-text-secondary); font-size: 14px; line-height: 1.75; }
  .faq-list { display: grid; gap: var(--cbw-space-2); margin-top: var(--cbw-space-7); }
  .faq details { overflow: hidden; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-control); background: var(--cbw-surface-primary); }
  .faq summary { display: flex; justify-content: space-between; gap: var(--cbw-space-4); padding: var(--cbw-space-4) var(--cbw-space-5); color: #111827; font-size: 14px; font-weight: 700; cursor: pointer; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: #9ca3af; font-size: 18px; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin: 0; padding: 0 var(--cbw-space-5) var(--cbw-space-4); color: var(--cbw-text-secondary); font-size: 13px; line-height: 1.7; }
  .disclosure p { margin: 0; color: #6b7280; font-size: 11px; line-height: 1.7; }
  .disclosure strong { color: #374151; }
  .disclosure a { color: #166534; font-weight: 800; }

  @media (min-width: 720px) {
    .path-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .section-heading { grid-template-columns: minmax(0,1fr) auto; }
    .country-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .update-row { grid-template-columns: 110px minmax(0,1fr) auto; align-items: center; }
  }
  @media (min-width: 920px) {
    .country-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .trust-grid { grid-template-columns: 1.05fr .95fr; align-items: center; }
  }
  @media (max-width: 639px) {
    :global(.homepage-v2 .cbw-first-viewport__inner) { padding-block: 12px; }
    :global(.homepage-v2 .cbw-display-title) { font-size: 42px; line-height: .92; }
    :global(.homepage-v2 .cbw-lede) { font-size: 13px; line-height: 1.4; }
    .hero-meta { margin-top: 9px; gap: 5px; }
    .hero-meta span, .hero-meta a { min-height: 25px; padding-inline: 8px; font-size: 8px; }
    .trust { padding-block: var(--cbw-space-9); }
  }
</style>
