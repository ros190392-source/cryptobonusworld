---
import InfoLayout from '../layouts/InfoLayout.astro';
import FirstViewport from '../components/site-standard/FirstViewport.astro';
import Section from '../components/site-standard/Section.astro';
import StatusBadge from '../components/site-standard/StatusBadge.astro';
import { buildOrganizationSchema, SITE_URL } from '../utils/seo';

const orgSchema = buildOrganizationSchema();
const aboutSchema = {
  ...orgSchema,
  mainEntityOfPage: {
    '@type': 'AboutPage',
    '@id': `${SITE_URL}/about/`,
    name: 'About CryptoBonusWorld',
    url: `${SITE_URL}/about/`,
  },
};
---

<InfoLayout
  title="About CryptoBonusWorld — Country-Aware Exchange Comparison"
  description="About CryptoBonusWorld: a country-aware crypto exchange comparison product that separates ranking, evidence, local availability and affiliate offers."
  canonical="/about/"
  schema={aboutSchema}
>
  <FirstViewport
    family="trust"
    container="standard"
    eyebrow="About CryptoBonusWorld"
    title="One exchange comparison product, built around your market."
    lede="We organize exchange rankings, country evidence and offer status so users can see what is known, what is still under review, and what needs confirmation on the exchange itself."
  >
    <div class="trust-meta">
      <StatusBadge label="Country-aware" tone="review" />
      <StatusBadge label="Evidence-bound" tone="verified" />
      <StatusBadge label="Affiliate-separated" tone="neutral" />
    </div>
  </FirstViewport>

  <Section container="prose" spacing="standard" tone="primary">
    <div class="cbw-prose">
      <h2>What the product does</h2>
      <p>
        CryptoBonusWorld helps users compare crypto exchanges in a consistent format. The product starts with the active country,
        shows the best available ranking context, and then explains each exchange through concise cards and review pages.
      </p>
      <p>
        A global exchange offer and a country-specific availability claim are not the same thing. When local evidence is incomplete,
        we show an under-review state instead of turning a global claim into a local recommendation.
      </p>

      <h2>How we keep the product honest</h2>
      <div class="about-grid cbw-card-grid cbw-card-grid--2">
        <article class="cbw-card">
          <strong>Country truth stays separate</strong>
          <p>IP or a manual country choice sets context. It does not prove that an exchange, product or promotion is available there.</p>
        </article>
        <article class="cbw-card">
          <strong>Evidence has a state</strong>
          <p>Verified, limited, under-review and blocked states stay visible rather than being flattened into one marketing claim.</p>
        </article>
        <article class="cbw-card">
          <strong>Commercial links are separate</strong>
          <p>Affiliate relationships and promo codes cannot create a ranking position or country-availability fact.</p>
        </article>
        <article class="cbw-card">
          <strong>Missing evidence fails closed</strong>
          <p>When a required fact is missing, stale or conflicting, the public product keeps that limitation instead of guessing.</p>
        </article>
      </div>

      <h2>How CryptoBonusWorld is funded</h2>
      <p>
        CryptoBonusWorld may earn affiliate commissions when a user follows an approved referral link and registers with an exchange.
        This commercial relationship is disclosed and is kept separate from country evidence and ranking authority.
        Read the <a href="/affiliate-disclosure/">Affiliate Disclosure</a> for details.
      </p>

      <h2>Research and editorial standards</h2>
      <p>
        Our methodology explains how source evidence, country context, freshness and commercial status are separated.
        See <a href="/methodology/">How We Verify</a>, the <a href="/editorial-policy/">Editorial Policy</a>,
        and the <a href="/update-policy/">Update Policy</a>.
      </p>

      <h2>Contact</h2>
      <p>For corrections, product feedback or business inquiries, use the <a href="/contact/">Contact page</a>.</p>
    </div>
  </Section>
</InfoLayout>

<style>
  .trust-meta { display: flex; flex-wrap: wrap; gap: var(--cbw-space-2); margin-top: var(--cbw-space-4); }
  .about-grid { margin-block: var(--cbw-space-5); }
  .about-grid article { margin: 0; }
  .about-grid strong { display: block; margin-bottom: var(--cbw-space-2); color: var(--cbw-text-primary); font-size: 13px; }
  .about-grid p { margin: 0; font-size: 12px; line-height: 1.6; }
</style>
