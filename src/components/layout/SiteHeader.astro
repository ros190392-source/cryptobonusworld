---
import { HEADER_COUNTRIES } from '../../data/header/headerCatalog';
import { HEADER_LANGUAGES } from '../../data/header/headerContext';

const currentPath = Astro.url.pathname;
const exchangeActive = [
  '/exchanges', '/bybit', '/mexc', '/okx', '/bitget', '/kucoin', '/bingx',
].some(path => currentPath.startsWith(path));

const exchanges = [
  { href: '/exchanges/', label: 'All Exchanges' },
  { href: '/bybit/', label: 'Bybit' },
  { href: '/mexc/', label: 'MEXC' },
  { href: '/okx/', label: 'OKX' },
  { href: '/bitget/', label: 'Bitget' },
  { href: '/kucoin/', label: 'KuCoin' },
  { href: '/bingx/', label: 'BingX' },
];

const initialCountry = HEADER_COUNTRIES[0]!;
const initialLanguage = HEADER_LANGUAGES[0]!;
---

<header
  class="site-header"
  data-site-header
  data-country-context="global"
  data-country-source="global"
  data-language-context="en"
  data-language-source="fallback"
>
  <div class="header-shell">
    <a href="/" class="brand" aria-label="CryptoBonusWorld home">
      <span class="brand-mark" aria-hidden="true">
        <img
          src="/brand/cbw-header-mark-final.png"
          srcset="/brand/cbw-header-mark-final@1x.png 1x, /brand/cbw-header-mark-final@2x.png 2x"
          alt=""
          width="40"
          height="40"
          fetchpriority="high"
        />
      </span>
      <span class="brand-copy">
        <span class="brand-name"><span>Crypto</span><strong>Bonus</strong><span>World</span></span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/#exchanges" class="nav-link">Top 10</a>

      <details class:list={['nav-dropdown', { 'is-active': exchangeActive }]} data-nav-dropdown>
        <summary>Exchanges <span aria-hidden="true">⌄</span></summary>
        <div class="dropdown-panel">
          {exchanges.map(item => (
            <a href={item.href} class:list={{ 'is-current': currentPath === item.href }}>
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <a href="/promo-codes/" class:list={['nav-link', { 'is-active': currentPath.startsWith('/promo-codes') }]}>Promo Codes</a>
      <a href="/methodology/" class:list={['nav-link', { 'is-active': currentPath.startsWith('/methodology') }]}>How We Verify</a>
    </nav>

    <div class="header-actions">
      <details class="context-picker country-picker" data-country-picker>
        <summary aria-label="Choose country: General" data-country-summary>
          <span class="picker-flag" aria-hidden="true" data-country-flag>{initialCountry.flag}</span>
          <span class="picker-current-name" data-country-name>{initialCountry.name}</span>
          <span class="picker-current-code" data-country-short>GL</span>
          <span class="picker-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="picker-panel country-panel">
          <div class="picker-heading">Country</div>
          <div class="picker-list" data-country-list>
            {HEADER_COUNTRIES.map(country => (
              <button
                type="button"
                class="picker-option country-option"
                data-country-option
                data-country-code={country.code}
                data-country-name={country.name}
                data-country-flag={country.flag}
                aria-pressed={country.code === 'global' ? 'true' : 'false'}
              >
                <span class="option-flag" aria-hidden="true">{country.flag}</span>
                <span>{country.name}</span>
                <small>{country.code === 'global' ? 'General' : country.code}</small>
              </button>
            ))}
          </div>
          <p class="picker-note">IP suggests a country. Your manual choice always wins.</p>
        </div>
      </details>

      <details class="context-picker language-picker" data-language-picker>
        <summary aria-label="Choose language: English" data-language-summary>
          <span data-language-short>{initialLanguage.shortLabel}</span>
          <span class="picker-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="picker-panel language-panel">
          <div class="picker-heading">Language</div>
          <div class="picker-list">
            {HEADER_LANGUAGES.map(language => (
              <button
                type="button"
                class="picker-option language-option"
                data-language-option
                data-language-code={language.code}
                data-language-short={language.shortLabel}
                data-language-name={language.label}
                aria-pressed={language.code === 'en' ? 'true' : 'false'}
              >
                <strong>{language.shortLabel}</strong>
                <span>{language.label}</span>
              </button>
            ))}
          </div>
          <p class="picker-note">Language is a presentation preference. Country facts stay separate.</p>
        </div>
      </details>

      <button
        class="menu-button"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-button
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-navigation" hidden data-mobile-panel>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/#exchanges" class="mobile-primary">Top 10 <span>→</span></a>
      <a href="/promo-codes/">Promo Codes <span>›</span></a>
      <a href="/methodology/">How We Verify <span>›</span></a>

      <details class="mobile-exchanges">
        <summary>Exchanges <span>+</span></summary>
        <div>
          {exchanges.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  import {
    HEADER_LANGUAGES,
    HEADER_LANGUAGE_STORAGE_KEY,
    parseCloudflareTraceCountry,
    resolveHeaderCountry,
    resolveHeaderLanguage,
    serializeHeaderCountrySelection,
    serializeHeaderLanguage,
  } from '../../data/header/headerContext';
  import { COUNTRY_CONTEXT_STORAGE_KEY } from '../../data/contracts/countryContext';

  const IP_SESSION_KEY = 'cbw_ip_country_proposal_v1';

  function safeGet(storage, key) {
    try {
      return storage.getItem(key);
    } catch {
      return null;
    }
  }

  function safeSet(storage, key, value) {
    try {
      storage.setItem(key, value);
      return true;
    } catch {
      return false;
    }
  }

  function initializeHeader(header) {
    if (!(header instanceof HTMLElement) || header.dataset.contextReady === 'true') return;
    header.dataset.contextReady = 'true';

    const menuButton = header.querySelector('[data-menu-button]');
    const mobilePanel = header.querySelector('[data-mobile-panel]');
    const navDropdown = header.querySelector('[data-nav-dropdown]');
    const countryPicker = header.querySelector('[data-country-picker]');
    const languagePicker = header.querySelector('[data-language-picker]');
    const countrySummary = header.querySelector('[data-country-summary]');
    const countryFlag = header.querySelector('[data-country-flag]');
    const countryName = header.querySelector('[data-country-name]');
    const countryShort = header.querySelector('[data-country-short]');
    const languageSummary = header.querySelector('[data-language-summary]');
    const languageShort = languageSummary?.querySelector('[data-language-short]');

    const countryOptions = [...header.querySelectorAll('[data-country-option]')];
    const languageOptions = [...header.querySelectorAll('[data-language-option]')];

    const countryMeta = new Map(
      countryOptions
        .filter(option => option instanceof HTMLButtonElement)
        .map(option => [
          option.dataset.countryCode,
          {
            name: option.dataset.countryName || 'General',
            flag: option.dataset.countryFlag || '🌍',
          },
        ]),
    );

    const closeContextPickers = (except = null) => {
      [countryPicker, languagePicker].forEach(picker => {
        if (picker instanceof HTMLDetailsElement && picker !== except) picker.open = false;
      });
    };

    const applyCountry = (decision) => {
      const code = decision.countryCode || 'global';
      const meta = countryMeta.get(code) || countryMeta.get('global') || { name: 'General', flag: '🌍' };
      header.dataset.countryContext = code;
      header.dataset.countrySource = decision.source;
      if (countryFlag) countryFlag.textContent = meta.flag;
      if (countryName) countryName.textContent = meta.name;
      if (countryShort) countryShort.textContent = code === 'global' ? 'GL' : code;
      if (countrySummary instanceof HTMLElement) {
        countrySummary.setAttribute('aria-label', `Choose country: ${meta.name}`);
      }
      countryOptions.forEach(option => {
        if (option instanceof HTMLButtonElement) {
          option.setAttribute('aria-pressed', option.dataset.countryCode === code ? 'true' : 'false');
        }
      });
      header.dispatchEvent(new CustomEvent('cbw:country-context-change', {
        bubbles: true,
        detail: { countryCode: code, source: decision.source },
      }));
    };

    const applyLanguage = (decision) => {
      header.dataset.languageContext = decision.language.code;
      header.dataset.languageSource = decision.source;
      if (languageShort) languageShort.textContent = decision.language.shortLabel;
      if (languageSummary instanceof HTMLElement) {
        languageSummary.setAttribute('aria-label', `Choose language: ${decision.language.label}`);
      }
      languageOptions.forEach(option => {
        if (option instanceof HTMLButtonElement) {
          option.setAttribute('aria-pressed', option.dataset.languageCode === decision.language.code ? 'true' : 'false');
        }
      });
      header.dispatchEvent(new CustomEvent('cbw:language-context-change', {
        bubbles: true,
        detail: { language: decision.language.code, source: decision.source },
      }));
    };

    const storedCountry = safeGet(window.localStorage, COUNTRY_CONTEXT_STORAGE_KEY);
    const cachedIpCountry = safeGet(window.sessionStorage, IP_SESSION_KEY);
    applyCountry(resolveHeaderCountry({
      storedRaw: storedCountry,
      ipCountryCode: cachedIpCountry || undefined,
    }));

    const browserLanguages = [
      ...(Array.isArray(navigator.languages) ? navigator.languages : []),
      navigator.language,
    ];
    applyLanguage(resolveHeaderLanguage({
      storedRaw: safeGet(window.localStorage, HEADER_LANGUAGE_STORAGE_KEY),
      browserLanguages,
    }));

    countryOptions.forEach(option => {
      if (!(option instanceof HTMLButtonElement)) return;
      option.addEventListener('click', () => {
        const code = option.dataset.countryCode;
        const serialized = serializeHeaderCountrySelection(code);
        if (!serialized) return;
        safeSet(window.localStorage, COUNTRY_CONTEXT_STORAGE_KEY, serialized);
        applyCountry(resolveHeaderCountry({ storedRaw: serialized }));
        if (countryPicker instanceof HTMLDetailsElement) countryPicker.open = false;
      });
    });

    languageOptions.forEach(option => {
      if (!(option instanceof HTMLButtonElement)) return;
      option.addEventListener('click', () => {
        const code = option.dataset.languageCode;
        const serialized = serializeHeaderLanguage(code);
        if (!serialized) return;
        safeSet(window.localStorage, HEADER_LANGUAGE_STORAGE_KEY, serialized);
        applyLanguage(resolveHeaderLanguage({ storedRaw: serialized }));
        if (languagePicker instanceof HTMLDetailsElement) languagePicker.open = false;
      });
    });

    [countryPicker, languagePicker].forEach(picker => {
      if (!(picker instanceof HTMLDetailsElement)) return;
      picker.addEventListener('toggle', () => {
        if (picker.open) closeContextPickers(picker);
      });
    });

    document.addEventListener('click', event => {
      if (!(event.target instanceof Node) || header.contains(event.target)) return;
      closeContextPickers();
      if (navDropdown instanceof HTMLDetailsElement) navDropdown.open = false;
    });

    const closeMenu = () => {
      if (!(menuButton instanceof HTMLButtonElement) || !(mobilePanel instanceof HTMLElement)) return;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open navigation menu');
      menuButton.classList.remove('is-open');
      mobilePanel.hidden = true;
      document.body.classList.remove('cbw-menu-open');
    };

    const openMenu = () => {
      if (!(menuButton instanceof HTMLButtonElement) || !(mobilePanel instanceof HTMLElement)) return;
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Close navigation menu');
      menuButton.classList.add('is-open');
      mobilePanel.hidden = false;
      document.body.classList.add('cbw-menu-open');
      closeContextPickers();
    };

    if (menuButton instanceof HTMLButtonElement && mobilePanel instanceof HTMLElement) {
      menuButton.addEventListener('click', () => {
        menuButton.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      });
      mobilePanel.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    }

    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      closeMenu();
      closeContextPickers();
      if (navDropdown instanceof HTMLDetailsElement) navDropdown.open = false;
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeMenu();
    });

    if (!storedCountry && !cachedIpCountry) {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 2500);
      fetch('/cdn-cgi/trace', {
        cache: 'no-store',
        credentials: 'same-origin',
        signal: controller.signal,
        headers: { Accept: 'text/plain' },
      })
        .then(response => response.ok ? response.text() : Promise.reject(new Error('geo trace unavailable')))
        .then(trace => {
          const proposed = parseCloudflareTraceCountry(trace);
          if (proposed) safeSet(window.sessionStorage, IP_SESSION_KEY, proposed);
          const latestStored = safeGet(window.localStorage, COUNTRY_CONTEXT_STORAGE_KEY);
          applyCountry(resolveHeaderCountry({
            storedRaw: latestStored,
            ipCountryCode: proposed || undefined,
          }));
        })
        .catch(() => {
          const latestStored = safeGet(window.localStorage, COUNTRY_CONTEXT_STORAGE_KEY);
          applyCountry(resolveHeaderCountry({ storedRaw: latestStored }));
        })
        .finally(() => window.clearTimeout(timer));
    }
  }

  document.querySelectorAll('[data-site-header]').forEach(initializeHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 300;
    color: #fff;
    background: rgba(10, 20, 36, .97);
    border-bottom: 1px solid rgba(255,255,255,.09);
    box-shadow: 0 7px 26px rgba(4, 10, 20, .17);
    backdrop-filter: blur(14px);
  }

  .header-shell {
    width: min(var(--cbw-page-max, 1180px), 100%);
    min-height: 56px;
    margin: 0 auto;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
  }
  .brand-mark img { width: 100%; height: 100%; object-fit: contain; }

  .brand-copy, .brand-name { display: flex; }
  .brand-copy { min-width: 0; }
  .brand-name {
    align-items: baseline;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1;
  }
  .brand-name span { color: rgba(255,255,255,.82); }
  .brand-name strong { color: #f7931a; font-weight: 900; }

  .desktop-nav { display: none; align-items: center; gap: 1px; }
  .nav-link, .nav-dropdown > summary {
    min-height: 36px;
    padding: 0 9px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 8px;
    color: rgba(255,255,255,.68);
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition: color .15s, background .15s;
  }
  .nav-dropdown > summary::-webkit-details-marker,
  .context-picker > summary::-webkit-details-marker,
  .mobile-exchanges > summary::-webkit-details-marker { display: none; }
  .nav-link:hover, .nav-link:focus-visible,
  .nav-link.is-active, .nav-dropdown.is-active > summary,
  .nav-dropdown > summary:hover, .nav-dropdown > summary:focus-visible {
    color: #fff;
    background: rgba(255,255,255,.07);
  }

  .nav-dropdown { position: relative; }
  .nav-dropdown[open] > summary { color: #fff; background: rgba(255,255,255,.07); }
  .nav-dropdown[open] > summary span { transform: rotate(180deg); }
  .nav-dropdown > summary span { font-size: 10px; transition: transform .15s; }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 210px;
    padding: 7px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 12px;
    background: #13233e;
    box-shadow: 0 22px 60px rgba(0,0,0,.35);
  }
  .dropdown-panel a {
    min-height: 40px;
    padding: 0 11px;
    display: flex;
    align-items: center;
    border-radius: 8px;
    color: rgba(255,255,255,.72);
    font-size: 13px;
    font-weight: 700;
  }
  .dropdown-panel a:hover, .dropdown-panel a:focus-visible,
  .dropdown-panel a.is-current { color: #13233e; background: #f7931a; }

  .header-actions {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }

  .context-picker { position: relative; }
  .context-picker > summary {
    min-height: 44px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    color: rgba(255,255,255,.86);
    background: rgba(255,255,255,.045);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    list-style: none;
    cursor: pointer;
    user-select: none;
    transition: border-color .15s, background .15s, color .15s;
  }
  .context-picker > summary:hover,
  .context-picker > summary:focus-visible,
  .context-picker[open] > summary {
    color: #fff;
    border-color: rgba(247,147,26,.55);
    background: rgba(255,255,255,.075);
  }
  .context-picker[open] .picker-chevron { transform: rotate(180deg); }
  .picker-chevron { color: rgba(255,255,255,.45); font-size: 9px; transition: transform .15s; }
  .picker-flag { font-size: 18px; line-height: 1; }
  .picker-current-name { display: none; max-width: 84px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .picker-current-code { min-width: 18px; text-align: center; letter-spacing: .02em; }
  .language-picker > summary { min-width: 48px; }

  .picker-panel {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    z-index: 20;
    width: min(300px, calc(100vw - 24px));
    padding: 9px;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 13px;
    background: #13233e;
    box-shadow: 0 22px 60px rgba(0,0,0,.38);
  }
  .country-panel { width: min(320px, calc(100vw - 24px)); }
  .language-panel { width: min(240px, calc(100vw - 24px)); }
  .picker-heading {
    padding: 4px 6px 8px;
    color: rgba(255,255,255,.48);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .picker-list {
    max-height: min(360px, 55vh);
    overflow-y: auto;
    display: grid;
    gap: 3px;
  }
  .picker-option {
    width: 100%;
    min-height: 44px;
    padding: 0 9px;
    display: flex;
    align-items: center;
    gap: 9px;
    border: 0;
    border-radius: 9px;
    color: rgba(255,255,255,.78);
    background: transparent;
    font: inherit;
    font-size: 12px;
    font-weight: 750;
    text-align: left;
    cursor: pointer;
  }
  .picker-option:hover, .picker-option:focus-visible { color: #fff; background: rgba(255,255,255,.07); }
  .picker-option[aria-pressed='true'] { color: #13233e; background: #f7931a; }
  .picker-option small { margin-left: auto; color: currentColor; opacity: .62; font-size: 9px; font-weight: 900; }
  .option-flag { width: 24px; text-align: center; font-size: 18px; }
  .language-option strong { min-width: 25px; font-size: 10px; letter-spacing: .04em; }
  .picker-note { margin: 8px 6px 2px; color: rgba(255,255,255,.46); font-size: 10px; line-height: 1.45; }

  .menu-button {
    width: 44px;
    height: 44px;
    padding: 0;
    display: flex;
    flex: 0 0 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    color: #fff;
    background: rgba(255,255,255,.05);
  }
  .menu-button span { width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .2s, opacity .2s; }
  .menu-button.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-button.is-open span:nth-child(2) { opacity: 0; }
  .menu-button.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-panel {
    max-height: calc(100dvh - 56px);
    overflow-y: auto;
    padding: 10px 12px 18px;
    border-top: 1px solid rgba(255,255,255,.08);
    background: #0a1424;
  }
  .mobile-panel[hidden] { display: none; }

  .mobile-nav { display: flex; flex-direction: column; gap: 5px; }
  .mobile-nav > a, .mobile-exchanges > summary {
    min-height: 46px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    color: rgba(255,255,255,.82);
    background: rgba(255,255,255,.035);
    font-size: 13px;
    font-weight: 800;
    list-style: none;
  }
  .mobile-nav > a:hover, .mobile-nav > a:focus-visible,
  .mobile-exchanges > summary:hover, .mobile-exchanges > summary:focus-visible { border-color: rgba(247,147,26,.5); color: #fff; }
  .mobile-nav .mobile-primary { color: #13233e; border-color: #f7931a; background: #f7931a; }
  .mobile-exchanges[open] > summary span { transform: rotate(45deg); }
  .mobile-exchanges > summary span { font-size: 20px; font-weight: 500; transition: transform .15s; }
  .mobile-exchanges > div { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; padding: 7px 0 0; }
  .mobile-exchanges a { min-height: 44px; padding: 0 11px; display: flex; align-items: center; border-radius: 9px; color: rgba(255,255,255,.67); background: rgba(255,255,255,.03); font-size: 12px; font-weight: 700; }
  .mobile-exchanges a:hover, .mobile-exchanges a:focus-visible { color: #13233e; background: #f7931a; }

  @media (max-width: 420px) {
    .brand-copy { display: none; }
    .header-shell { gap: 6px; }
  }

  @media (min-width: 620px) {
    .header-shell { padding: 0 20px; }
    .picker-current-name { display: inline; }
    .picker-current-code { display: none; }
  }

  @media (min-width: 900px) {
    .header-shell { min-height: 60px; padding: 0 24px; gap: 12px; }
    .brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
    .brand-name { font-size: 18px; }
    .desktop-nav { display: flex; }
    .context-picker > summary { min-height: 36px; border-radius: 9px; }
    .country-picker > summary { padding-inline: 9px; }
    .menu-button, .mobile-panel { display: none !important; }
  }

  @media (min-width: 1120px) {
    .header-shell { padding: 0 28px; }
    .desktop-nav { gap: 2px; }
  }
</style>
