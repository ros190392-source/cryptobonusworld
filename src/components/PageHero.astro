---
export interface Props {
  img: string;
  variant?: 'tall' | 'short';
  class?: string;
}
const { img, variant = 'tall', class: cls = '' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${variant}`, cls]} style={`--ph-img:url('${img}')`}>
  <div class="page-hero__inner">
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    min-height: 0;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background-color: #0a1424;
    background-image: var(--ph-img);
    background-position: center right;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(90deg,rgba(7,12,21,.97) 0%,rgba(7,12,21,.93) 38%,rgba(7,12,21,.62) 72%,rgba(7,12,21,.25) 100%);
  }
  .page-hero--tall { max-height: 300px; }
  .page-hero--short { max-height: 260px; }
  .page-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--cbw-width-standard, 960px);
    margin-inline: auto;
    padding: 28px var(--cbw-gutter, 20px);
    box-sizing: border-box;
  }
  .page-hero :global(.ph-content) { max-width: var(--cbw-width-prose, 760px); }
  .page-hero :global(.ph-eyebrow) {
    display: inline-flex;
    margin: 0 0 10px;
    padding: 4px 10px;
    border: 1px solid rgba(247,166,0,.3);
    border-radius: 999px;
    color: #f7c24b;
    background: rgba(247,166,0,.11);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .page-hero :global(.ph-title) {
    margin: 0;
    color: #fff;
    font-family: 'Barlow Condensed', Inter, sans-serif;
    font-size: clamp(40px,5vw,62px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: .95;
    text-transform: uppercase;
  }
  .page-hero :global(.ph-sub) {
    max-width: 680px;
    margin: 10px 0 0;
    color: rgba(255,255,255,.76);
    font-size: 14px;
    line-height: 1.55;
  }
  .page-hero :global(.ph-caveat) {
    max-width: 680px;
    margin: 6px 0 0;
    color: rgba(255,255,255,.55);
    font-size: 10px;
    line-height: 1.5;
  }
  .page-hero :global(.ph-updated) { margin: 8px 0 0; color: rgba(255,255,255,.48); font-size: 9px; }
  .page-hero :global(.ph-chips) { display: flex; flex-wrap: wrap; gap: 6px; margin: 11px 0 0; padding: 0; list-style: none; }
  .page-hero :global(.ph-chip) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 999px;
    color: rgba(255,255,255,.82);
    background: rgba(255,255,255,.05);
    font-size: 9px;
    font-weight: 800;
  }
  .page-hero :global(.ph-actions) { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .page-hero :global(.ph-content a) { color: #ffd291; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 768px) {
    .page-hero { background-position: center right -40px; }
    .page-hero::before { background: linear-gradient(90deg,rgba(7,12,21,.96) 0%,rgba(7,12,21,.9) 58%,rgba(7,12,21,.68) 100%); }
    .page-hero--tall { max-height: 280px; }
    .page-hero--short { max-height: 240px; }
    .page-hero__inner { padding-block: 24px; }
  }
  @media (max-width: 480px) {
    .page-hero--tall { max-height: 260px; }
    .page-hero--short { max-height: 230px; }
    .page-hero__inner { padding-block: 20px; }
    .page-hero :global(.ph-title) { font-size: 42px; }
    .page-hero :global(.ph-sub) { font-size: 12px; line-height: 1.42; }
    .page-hero :global(.ph-chip) { padding: 4px 8px; font-size: 8px; }
  }
</style>
