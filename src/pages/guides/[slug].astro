---
import RedirectPage from '../../components/site-standard/RedirectPage.astro';
import guides from '../../data/guides.json';

export function getStaticPaths() {
  return guides.map(guide => ({ params: { slug: guide.slug } }));
}
---

<RedirectPage
  target="/"
  canonical="https://cryptobonusworld.com/"
  message="This legacy guide has been retired. Current comparison and research context now lives in the governed homepage and exchange profiles."
  targetLabel="the CryptoBonusWorld homepage"
/>
