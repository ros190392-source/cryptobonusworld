---
import RedirectPage from '../../components/site-standard/RedirectPage.astro';
import legacyExchanges from '../../data/exchanges.json';

export function getStaticPaths() {
  const LIVE_PROMO_SLUGS = new Set(['bybit', 'mexc', 'okx', 'bitget', 'kucoin', 'bingx']);
  const HAS_DEDICATED_PAGE = new Set(['coinex']);
  return legacyExchanges
    .filter(exchange => !LIVE_PROMO_SLUGS.has(exchange.slug) && !HAS_DEDICATED_PAGE.has(exchange.slug))
    .map(exchange => ({ params: { slug: exchange.slug }, props: { exchangeName: exchange.name } }));
}

const { exchangeName } = Astro.props;
---

<RedirectPage
  target="/exchanges/"
  canonical="https://cryptobonusworld.com/exchanges/"
  message={`The retired ${exchangeName} review is no longer maintained as a standalone public page. Use the governed exchange directory for current profiles and evidence states.`}
  targetLabel="the exchange directory"
/>
