---
import CleanLayout from '../layouts/CleanLayout.astro';
import PageFrame from '../components/site-standard/PageFrame.astro';
import FirstViewport from '../components/site-standard/FirstViewport.astro';
import Section from '../components/site-standard/Section.astro';
---

<CleanLayout
  title="Contact — CryptoBonusWorld"
  description="Contact CryptoBonusWorld to report incorrect data, suggest an exchange, submit a content correction or send a business inquiry."
  canonical="https://cryptobonusworld.com/contact/"
  noindex={true}
>
  <PageFrame family="utility" class="contact-product">
    <FirstViewport
      family="utility"
      container="standard"
      eyebrow="Contact CryptoBonusWorld"
      title="Report a problem or send a correction"
      lede="Use this form for data corrections, exchange suggestions, partnership inquiries and technical feedback. Exchange account disputes should go directly to the exchange's support team."
    />

    <Section container="standard" spacing="compact" tone="page" ariaLabel="Contact CryptoBonusWorld">
      <div class="contact-grid" data-contact-grid>
        <section class="contact-reasons cbw-panel" aria-labelledby="contact-reasons-title">
          <p class="cbw-section-eyebrow">What we can review</p>
          <h2 id="contact-reasons-title">Send us evidence or feedback</h2>
          <ul>
            <li><strong>Incorrect data</strong><span>Outdated bonus, restriction, availability or exchange information.</span></li>
            <li><strong>Exchange suggestions</strong><span>Products or exchanges you think should enter the research queue.</span></li>
            <li><strong>Affiliate partnerships</strong><span>Business inquiries from exchange or affiliate-program representatives.</span></li>
            <li><strong>Content corrections</strong><span>Factual errors, unclear wording or evidence that should be rechecked.</span></li>
            <li><strong>Technical issues</strong><span>Broken links, display problems or other site feedback.</span></li>
          </ul>
          <aside class="contact-boundary">
            <strong>Exchange account support is separate.</strong>
            <span>We cannot resolve withdrawals, verification, account restrictions or disputes inside an exchange account. Contact the exchange directly for those cases.</span>
          </aside>
        </section>

        <section class="contact-form-panel cbw-panel" aria-labelledby="contact-form-title">
          <p class="cbw-section-eyebrow">Message</p>
          <h2 id="contact-form-title">Contact form</h2>
          <form class="contact-form" name="contact" method="POST" data-netlify="true" action="/contact/?sent=true" data-contact-form>
            <input type="hidden" name="form-name" value="contact" />

            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" placeholder="Your name" required />
            </label>

            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" placeholder="Your email address" required />
            </label>

            <label>
              <span>Subject</span>
              <select name="subject">
                <option value="bonus-data">Incorrect data</option>
                <option value="exchange-suggestion">Exchange suggestion</option>
                <option value="affiliate">Affiliate partnership</option>
                <option value="content">Content correction</option>
                <option value="technical">Technical issue</option>
                <option value="other">Other</option>
              </select>
            </label>

            <label>
              <span>Message</span>
              <textarea name="message" rows="6" placeholder="Describe the page, fact or issue and include enough detail for us to reproduce or recheck it." required></textarea>
            </label>

            <button type="submit" class="contact-submit">Send message</button>
          </form>
        </section>
      </div>
    </Section>
  </PageFrame>
</CleanLayout>

<style>
  .contact-product :global(.cbw-first-viewport--utility) { --cbw-first-viewport-target: 200px; }
  .contact-grid { display: grid; gap: var(--cbw-space-4); }
  .contact-reasons h2,.contact-form-panel h2 { margin: 0; color: var(--cbw-text-primary); font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(26px,3vw,34px); line-height: 1; text-transform: uppercase; }
  .contact-reasons ul { display: grid; gap: 10px; margin: 18px 0 0; padding: 0; list-style: none; }
  .contact-reasons li { display: grid; gap: 3px; padding: 10px 11px; border-radius: var(--cbw-radius-control); background: var(--cbw-surface-secondary); }
  .contact-reasons li strong { color: var(--cbw-text-primary); font-size: 11px; }
  .contact-reasons li span { color: var(--cbw-text-secondary); font-size: 10px; line-height: 1.5; }
  .contact-boundary { display: grid; gap: 4px; margin-top: 14px; padding: 12px 13px; border: 1px solid #efd5ae; border-radius: var(--cbw-radius-control); background: #fff7ea; }
  .contact-boundary strong { color: #7d5206; font-size: 10px; }
  .contact-boundary span { color: #765d39; font-size: 9px; line-height: 1.55; }
  .contact-form { display: grid; gap: 12px; margin-top: 18px; }
  .contact-form label { display: grid; gap: 5px; }
  .contact-form label > span { color: var(--cbw-text-muted); font-size: 8px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .contact-form input,.contact-form select,.contact-form textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-control); color: var(--cbw-text-primary); background: #fff; font: inherit; font-size: 12px; outline: none; }
  .contact-form input,.contact-form select { min-height: 44px; padding: 0 12px; }
  .contact-form textarea { min-height: 132px; padding: 11px 12px; line-height: 1.55; resize: vertical; }
  .contact-form input:focus-visible,.contact-form select:focus-visible,.contact-form textarea:focus-visible { border-color: #b96d10; box-shadow: 0 0 0 3px rgba(247,147,26,.13); }
  .contact-submit { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; justify-self: start; padding: 0 18px; border: 1px solid #d97807; border-radius: var(--cbw-radius-control); color: #13233e; background: var(--cbw-action); font-size: 11px; font-weight: 900; cursor: pointer; }
  .contact-submit:hover,.contact-submit:focus-visible { background: var(--cbw-action-hover); }
  @media (min-width: 800px) {
    .contact-grid { grid-template-columns: minmax(0,.95fr) minmax(360px,1.05fr); align-items: start; }
  }
  @media (max-width: 639px) {
    .contact-product :global(.cbw-first-viewport--utility) { --cbw-first-viewport-target: 230px; }
    .contact-submit { width: 100%; }
  }
</style>
