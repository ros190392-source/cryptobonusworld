---
import CleanLayout from './CleanLayout.astro';
import PageFrame from '../components/site-standard/PageFrame.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const { title, description = '', canonical, noindex = false, schema } = Astro.props;
const siteBase = 'https://cryptobonusworld.com';
const fullCanonical = canonical
  ? (canonical.startsWith('http') ? canonical : `${siteBase}${canonical}`)
  : undefined;
---

<CleanLayout title={title} description={description} canonical={fullCanonical} noindex={noindex}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <PageFrame family="trust" class="info-page-frame">
    <div class="info-page">
      <slot />
    </div>
  </PageFrame>
</CleanLayout>
