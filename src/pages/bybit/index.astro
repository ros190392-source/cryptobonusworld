---
import CleanLayout from '../../layouts/CleanLayout.astro';
import ExchangePromoPageV2 from '../../components/exchange/ExchangePromoPageV2.astro';
import ExchangeUnverifiedNotice from '../../components/exchange/ExchangeUnverifiedNotice.astro';
import '../../styles/exchange-page-standard-v1-responsive.css';
import { bybitConfig } from '../../data/exchangePages/bybit';
import { deriveBybitPublicOfferPresentation } from '../../data/evidence/offers/bybitPublicPresentation';

// Issue #264: the public Bybit presentation is evidence-driven, never Offer.status. While
// the packet is a draft and every claim is inaccessible, the public state is
// `under_re_verification`, so the commercial promo page (which would expose the
// unconfirmed code, bonus amount, terms and a /go/ affiliate CTA) is NOT rendered — a
// neutral re-verification notice is shown instead. The rich commercial config remains as
// internal candidate data and re-renders automatically only when the state is `verified`.
const presentation = deriveBybitPublicOfferPresentation();
const isVerified = presentation.publicState === 'verified';

// Neutral, non-claiming metadata for the unverified state (no promo code, bonus amount or
// "verified" wording); the commercial meta is used only when truly verified.
const neutralTitle = 'Bybit exchange — offer under re-verification | CryptoBonusWorld';
const neutralDescription =
  'Bybit promotion details are being re-verified. Current promotion terms are not verified yet — check the exchange directly for current terms.';
---

<CleanLayout
  title={isVerified ? bybitConfig.pageTitle : neutralTitle}
  description={isVerified ? bybitConfig.pageDescription : neutralDescription}
  canonical={bybitConfig.canonicalUrl}
  ogImage={bybitConfig.ogImage}
  ogTitle={isVerified ? bybitConfig.ogTitle : neutralTitle}
  ogDescription={isVerified ? bybitConfig.ogDescription : neutralDescription}
>
  {isVerified ? (
    <ExchangePromoPageV2 config={bybitConfig} />
  ) : (
    <ExchangeUnverifiedNotice
      slug="bybit"
      name="Bybit"
      statusLabel={presentation.statusLabel}
      headline={presentation.headline}
      detailText={presentation.detailText}
      officialUrl="https://www.bybit.com"
    />
  )}
</CleanLayout>
