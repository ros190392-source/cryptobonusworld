---
import CleanLayout from '../../layouts/CleanLayout.astro';
import PageFrame from '../../components/site-standard/PageFrame.astro';
import FirstViewport from '../../components/site-standard/FirstViewport.astro';
import Section from '../../components/site-standard/Section.astro';
import ActiveCountryContext from '../../components/site-standard/ActiveCountryContext.astro';
import ExchangeDirectoryCard from '../../components/site-standard/ExchangeDirectoryCard.astro';
import { getFeaturedExchanges } from '../../data/exchanges';
import { getOffer } from '../../data/offers';
import { buildHomepageTop10 } from '../../data/homepageTop10';

const nowMs = Date.now();
const exchanges = getFeaturedExchanges();
const fitBySlug = new Map(buildHomepageTop10(nowMs).map(entry => [entry.slug, entry.bestFor]));
const cards = exchanges.map(exchange => ({
  exchange,
  offer: getOffer(exchange.slug),
  bestFor: fitBySlug.get(exchange.slug),
}));
---

<CleanLayout
  title="Compare Crypto Exchanges by Market | CryptoBonusWorld"
  description="Browse CryptoBonusWorld exchange profiles in one consistent card view. Active country context, offer status and local eligibility remain separate."
  canonical="https://cryptobonusworld.com/exchanges/"
>
  <PageFrame family="directory" class="exchange-directory-product">
    <FirstViewport
      family="directory"
      container="wide"
      eyebrow="Exchange directory"
      title="Compare crypto exchanges"
      lede="Start with the active market, then compare exchange fit, current offer status and review pages without treating a global promotion as local availability."
    >
      <div class="directory-country">
        <ActiveCountryContext
          compact={true}
          note="The directory does not relabel global exchange or offer data as local availability. Country evidence is shown separately when approved."
        />
      </div>
    </FirstViewport>

    <Section container="wide" spacing="compact" tone="page" id="exchanges">
      <header class="cbw-section-header cbw-section-header--split">
        <div>
          <p class="cbw-section-eyebrow">Exchange profiles</p>
          <h2 class="cbw-section-title">Browse current exchange cards</h2>
          <p class="cbw-section-lede">One card language across the homepage and directory: exchange identity, fit, offer state, country caution and actions.</p>
        </div>
        <a class="directory-link" href="/#exchanges">Homepage Top 10 →</a>
      </header>

      <div class="directory-grid cbw-card-grid cbw-card-grid--2" data-exchange-directory-grid>
        {cards.map(({ exchange, offer, bestFor }) => (
          <ExchangeDirectoryCard exchange={exchange} offer={offer} bestFor={bestFor} />
        ))}
      </div>

      <div class="directory-foot cbw-panel">
        <div>
          <strong>Need the verification detail?</strong>
          <span>Methodology and FAQ are now canonical pages instead of repeated blocks inside every directory.</span>
        </div>
        <nav aria-label="Directory help links">
          <a href="/methodology/">How we verify</a>
          <a href="/faq/">FAQ</a>
          <a href="/promo-codes/">Promo codes</a>
        </nav>
      </div>
    </Section>
  </PageFrame>
</CleanLayout>

<style>
  .exchange-directory-product { background: var(--cbw-surface-page); }
  .directory-country { max-width: 760px; margin-top: var(--cbw-space-4); }
  .directory-grid { --cbw-card-columns: 2; }
  .directory-link { color: #925204; font-size: 11px; font-weight: 900; white-space: nowrap; }
  .directory-foot { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: var(--cbw-space-5); align-items: center; margin-top: var(--cbw-space-5); box-shadow: none; }
  .directory-foot > div { display: grid; gap: 3px; }
  .directory-foot strong { color: var(--cbw-text-primary); font-size: 12px; }
  .directory-foot span { color: var(--cbw-text-secondary); font-size: 10px; line-height: 1.5; }
  .directory-foot nav { display: flex; flex-wrap: wrap; gap: var(--cbw-space-3); }
  .directory-foot a { color: #925204; font-size: 10px; font-weight: 900; }
  @media (max-width: 699px) {
    .directory-grid { --cbw-card-columns: 1; }
    .directory-foot { grid-template-columns: 1fr; }
  }
</style>
