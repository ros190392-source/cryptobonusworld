---
/**
 * /go/[exchange]/ — owner-confirmed commercial redirect boundary (Issue #269).
 *
 * Link/code authority is independent from offer-claim authority:
 * - outbound navigation may use ONLY an exact destination returned by
 *   resolvePublicCommercialRoute(), which is bound to the frozen owner-confirmation manifest;
 * - confirmed GEO variants are projected through the same resolver before being serialized;
 * - no subid/UTM/query/path mutation is permitted here;
 * - analytics may observe a click but never changes the destination;
 * - bonus/KYC/deposit/expiry/availability/terms remain neutral / under re-verification.
 */

import exchanges from '../../data/exchanges.json';
import { resolvePublicCommercialRoute } from '../../data/publicCommercialRoute';
import { resolveOwnerConfirmedCommercialAuthority } from '../../data/contracts/ownerConfirmedCommercialAuthority';

export function getStaticPaths() {
  return exchanges.map(ex => ({
    params: { exchange: ex.slug },
    props: { exchange: ex },
  }));
}

const { exchange: ex } = Astro.props;
const nowMs = Date.now();
const defaultDecision = resolvePublicCommercialRoute(ex.slug, nowMs);
const ownerAuthority = resolveOwnerConfirmedCommercialAuthority(ex.slug);
const fallbackUrl = defaultDecision.fallbackUrl;
if (typeof fallbackUrl !== 'string' || !fallbackUrl.startsWith('/') || fallbackUrl.startsWith('//')) {
  throw new Error(`Invalid governed fallback URL for ${ex.slug}: ${String(fallbackUrl)}`);
}
const canonicalHref = `https://cryptobonusworld.com${fallbackUrl}`;

// Project every serialized GEO destination through the exact-value route resolver.
// Raw exchanges.json URLs are never serialized directly by this page.
const confirmedGeoRoutes: Record<string, string> = {};
for (const country of Object.keys(ownerAuthority?.confirmedGeoUrls ?? {})) {
  const geoDecision = resolvePublicCommercialRoute(ex.slug, nowMs, country);
  if (geoDecision.externalAllowed && geoDecision.destinationKind === 'confirmed_geo') {
    confirmedGeoRoutes[country] = geoDecision.destination;
  }
}

const hasConfirmedGeoRoute = Object.keys(confirmedGeoRoutes).length > 0;
const hasConfirmedExternalRoute = defaultDecision.externalAllowed || hasConfirmedGeoRoute;
const continueHref = defaultDecision.externalAllowed ? defaultDecision.destination : fallbackUrl;
const confirmedPromo = defaultDecision.promoCodeAuthority === 'owner_confirmed'
  ? defaultDecision.promoCode
  : null;

const clientRouteData = hasConfirmedExternalRoute
  ? {
      default: defaultDecision.externalAllowed ? defaultDecision.destination : null,
      geo: confirmedGeoRoutes,
    }
  : null;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Opening {ex.name} — CryptoBonusWorld</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonicalHref} />

  <!-- JS-disabled fallback always remains internal; no unconfirmed external URL in meta refresh. -->
  <meta http-equiv="refresh" content={`8;url=${fallbackUrl}`} />

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      display: grid;
      min-height: 100dvh;
      place-items: center;
      padding: 20px;
      color: #536176;
      background:
        radial-gradient(circle at 82% 12%, rgba(247,147,26,.15), transparent 30%),
        #f7f8f4;
      font-family: Inter, system-ui, -apple-system, sans-serif;
    }
    .transition-card {
      width: min(100%, 560px);
      padding: 28px;
      border: 1px solid #dce3dc;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 12px 36px rgba(19,35,62,.08);
    }
    .transition-eyebrow {
      margin: 0 0 14px;
      color: #a65400;
      font-size: 9px;
      font-weight: 900;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .exchange-identity {
      display: grid;
      grid-template-columns: 72px minmax(0,1fr);
      gap: 14px;
      align-items: center;
    }
    .logo-box {
      display: flex;
      width: 72px;
      height: 58px;
      align-items: center;
      justify-content: center;
      padding: 7px;
      border-radius: 10px;
      background: #0c1526;
    }
    .ex-logo { display: block; max-width: 58px; max-height: 42px; width: auto; height: auto; object-fit: contain; }
    h1 {
      margin: 0;
      color: #13233e;
      font-family: 'Barlow Condensed', Inter, sans-serif;
      font-size: clamp(34px, 8vw, 50px);
      font-weight: 800;
      letter-spacing: -.025em;
      line-height: .95;
      text-transform: uppercase;
    }
    .exchange-identity p { margin: 5px 0 0; color: #778391; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .transition-state {
      display: grid;
      gap: 8px;
      margin-top: 20px;
      padding: 14px;
      border-radius: 10px;
      background: #f2f5f1;
    }
    .transition-state p { margin: 0; color: #536176; font-size: 12px; line-height: 1.6; }
    .transition-state strong { color: #13233e; }
    code { color: #13233e; font-weight: 900; overflow-wrap: anywhere; }
    .progress { display: flex; align-items: center; gap: 8px; color: #778391; font-size: 10px; }
    .spinner { width: 16px; height: 16px; border: 2px solid #dce3dc; border-top-color: #f7931a; border-radius: 50%; animation: spin .8s linear infinite; flex: none; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .continue-btn {
      display: flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      margin-top: 16px;
      padding: 0 18px;
      border: 1px solid #d97807;
      border-radius: 10px;
      color: #13233e;
      background: #f7931a;
      font-size: 12px;
      font-weight: 900;
      text-align: center;
      text-decoration: none;
    }
    .continue-btn:hover,.continue-btn:focus-visible { background: #ffad3d; }
    .disclaimer { margin: 14px 0 0; color: #778391; font-size: 9px; line-height: 1.6; }
    @media (max-width: 520px) {
      .transition-card { padding: 22px 18px; border-radius: 14px; }
      .exchange-identity { grid-template-columns: 58px minmax(0,1fr); }
      .logo-box { width: 58px; height: 52px; }
      .ex-logo { max-width: 46px; max-height: 38px; }
    }
  </style>
</head>
<body>
  <main
    class="transition-card"
    data-go-transition={ex.slug}
    data-go-external={hasConfirmedExternalRoute ? 'true' : 'false'}
    data-go-fallback={fallbackUrl}
  >
    <p class="transition-eyebrow">Leaving CryptoBonusWorld · governed registration route</p>

    <div class="exchange-identity">
      <div class="logo-box">
        <img class="ex-logo" src={`/logos/${ex.slug}.png`} alt={`${ex.name} logo`} onerror="this.style.display='none'" />
      </div>
      <div>
        <h1>{ex.name}</h1>
        <p>{hasConfirmedExternalRoute ? 'Owner-confirmed destination available' : 'External destination under re-verification'}</p>
      </div>
    </div>

    <div class="transition-state">
      {hasConfirmedExternalRoute ? (
        <Fragment>
          <p><strong>Registration link:</strong> owner confirmed.</p>
          {confirmedPromo && <p><strong>Promo/referral code:</strong> <code>{confirmedPromo}</code> — owner confirmed.</p>}
          <p><strong>Offer terms:</strong> {defaultDecision.offerTermsLabel}</p>
          <div class="progress"><span class="spinner" aria-hidden="true"></span><span>Opening the confirmed destination…</span></div>
        </Fragment>
      ) : (
        <Fragment>
          <p><strong>No confirmed external destination is available.</strong></p>
          <p>You will stay inside CryptoBonusWorld and continue to the current {ex.name} status surface.</p>
        </Fragment>
      )}
    </div>

    <a
      id="cbw-continue"
      href={continueHref}
      class="continue-btn"
      rel={hasConfirmedExternalRoute ? 'noopener noreferrer sponsored' : 'noopener'}
    >
      {hasConfirmedExternalRoute ? `Continue to ${ex.name}` : `View ${ex.name} status`}
    </a>

    <p class="disclaimer">
      {hasConfirmedExternalRoute
        ? 'Link and displayed code authority are separate from offer truth. This page does not verify bonus amount, country availability, account eligibility, KYC/deposit requirements, expiry or other promotion terms.'
        : 'No unconfirmed external destination is used. Commercial and country facts remain under re-verification.'}
    </p>
  </main>

  {hasConfirmedExternalRoute && clientRouteData && (
  <script define:vars={{ __routeData: clientRouteData, __exchangeSlug: ex.slug, __fallbackUrl: fallbackUrl }} is:inline>
  (function () {
    'use strict';

    var geo = 'unknown', device = 'unknown', sid = 'unknown', abVariant = 'control';
    try {
      geo = (localStorage.getItem('cbw_geo') || 'unknown').trim().toLowerCase();
      device = localStorage.getItem('cbw_device') || 'unknown';
    } catch (_) {}
    try { sid = sessionStorage.getItem('cbw_sid') || 'unknown'; } catch (_) {}
    try { abVariant = localStorage.getItem('cbw_ab') || 'control'; } catch (_) {}

    var searchParams = new URLSearchParams(location.search);
    var placement = searchParams.get('pl') || 'go-redirect';
    var pageType = searchParams.get('pt') || 'unknown';
    var comparePair = searchParams.get('cp') || null;
    var ctxRank = searchParams.get('rank') ? parseInt(searchParams.get('rank'), 10) : null;

    // A caller may select a GEO key, but the resulting value must still come from the
    // frozen resolver-projected map. The URL itself is never accepted from query params.
    var geoOverride = searchParams.get('geo');
    if (geoOverride) geo = geoOverride.trim().toLowerCase();

    var finalUrl = null;
    var linkSource = 'fallback-page';
    if (geo !== 'unknown' && __routeData.geo && __routeData.geo[geo]) {
      finalUrl = __routeData.geo[geo];
      linkSource = 'confirmed-geo';
    } else if (__routeData.default) {
      finalUrl = __routeData.default;
      linkSource = 'confirmed-default';
    }

    function isValidExternal(url) {
      try {
        var parsed = new URL(url);
        return parsed.protocol === 'https:' || parsed.protocol === 'http:';
      } catch (_) {
        return false;
      }
    }

    if (!finalUrl || !isValidExternal(finalUrl)) {
      try { window.location.replace(__fallbackUrl); } catch (_) {}
      return;
    }

    // IMPORTANT: finalUrl is the exact confirmed value. Do not append subids, UTMs,
    // query params, or rewrite its path here. Analytics observes the click separately.
    var clickEvent = {
      schema_version: 1,
      event: 'cbw_affiliate_click',
      timestamp: new Date().toISOString(),
      ts: Date.now(),
      exchange: __exchangeSlug,
      placement: placement,
      page_type: pageType,
      path: document.referrer ? new URL(document.referrer).pathname : '/',
      geo_code: geo,
      device_type: device,
      session_id: sid,
      ab_variant: abVariant,
      link_source: linkSource,
      href: finalUrl,
      is_go_redirect: true,
      contextual_rank: ctxRank,
      compare_pair: comparePair,
    };

    try {
      if (window.cbw && Array.isArray(window.cbw.events)) window.cbw.events.push(clickEvent);
    } catch (_) {}
    try {
      if (window.dataLayer && Array.isArray(window.dataLayer)) {
        window.dataLayer.push(Object.assign({ event: clickEvent.event }, clickEvent));
      }
    } catch (_) {}
    try {
      if (typeof window.plausible === 'function') {
        window.plausible('cbw_affiliate_click', { props: {
          exchange: String(clickEvent.exchange),
          placement: String(clickEvent.placement),
          page_type: String(clickEvent.page_type),
          geo_code: String(clickEvent.geo_code),
          device_type: String(clickEvent.device_type),
          link_source: String(clickEvent.link_source),
        }});
      }
    } catch (_) {}
    try {
      document.dispatchEvent(new CustomEvent('cbw:click', { detail: clickEvent, bubbles: true }));
    } catch (_) {}
    try {
      if (typeof window.posthog !== 'undefined' && typeof window.posthog.capture === 'function') {
        window.posthog.capture('cbw_affiliate_click', clickEvent);
      }
    } catch (_) {}

    try {
      var btn = document.getElementById('cbw-continue');
      if (btn) btn.setAttribute('href', finalUrl);
    } catch (_) {}

    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      console.info('[CBW /go/] Exact owner-confirmed destination:', {
        slug: __exchangeSlug,
        linkSource: linkSource,
        finalUrl: finalUrl,
        geo: geo,
      });
    }

    setTimeout(function () {
      window.location.replace(finalUrl);
    }, 1000);
  })();
  </script>
  )}

  {!hasConfirmedExternalRoute && (
  <script define:vars={{ __internalUrl: fallbackUrl }} is:inline>
    try { window.location.replace(__internalUrl); } catch (_) {}
  </script>
  )}
</body>
</html>
