      "containerRoles": ["shell", "content", "prose"],
      "currentState": "NOINDEX_PUBLIC_SHAPED_PREVIEW_ROUTES_GUARDED",
      "targetTemplate": "MarketPassportTemplateV3",
      "indexabilityAuthorized": false,
      "publicationAuthorized": false,
      "affiliateCtaAuthorized": false,
      "publicGeometryAuthority": false
    },
    {
      "id": "retired-public-hub",
      "routes": [
        "/bonus-codes/",
        "/bonuses/",
        "/categories/",
        "/coins/",
        "/compare/",
        "/countries/",
        "/use-cases/",
        "/reviewers/",
        "/guides/",
        "/guides/{slug}/"
      ],
      "containerRoles": [],
      "currentState": "STANDALONE_META_REFRESH_STUBS",
      "targetTemplate": "RedirectRegistry"
    },
    {
      "id": "affiliate-redirect",
      "routes": ["/go/{exchange}/"],
      "containerRoles": [],
      "currentState": "FUNCTIONAL_REDIRECT",
      "targetTemplate": "AffiliateRedirectContract",
      "layoutAuditExcluded": true
    },
    {
      "id": "preview-design",
      "routes": ["/preview/**", "/__design/**"],
      "containerRoles": ["shell", "wide", "content", "prose"],
      "currentState": "NOINDEX_REVIEW_ONLY",
      "targetTemplate": "ReviewTemplate",
      "publicGeometryAuthority": false
    },
    {
      "id": "system",
      "routes": ["/404.html", "/sitemap.xml"],
      "containerRoles": [],
      "currentState": "SYSTEM_ROUTE",
      "targetTemplate": "SystemContract"
    }
  ],
  "knownCurrentWidths": [
    {"value": 1180, "source": "CleanLayout --cbw-page-max"},
    {"value": 1160, "source": "Homepage and governed Kazakhstan preview .shell rules"},
    {"value": 1120, "source": "CleanLayout --cbw-wide-max / HomepageTop10"},
    {"value": 900, "source": "Methodology .mth-prose/.mth-wide"},
    {"value": 860, "source": "Info/legal .container"},
    {"value": 800, "source": "CleanLayout --cbw-prose-max / Homepage .prose-shell"},
    {"value": 760, "source": "Exchange .p2-inner/.bw-wrap/.seo-intro-inner"}
  ],
  "requiredBuildChecks": [
    "everyPublicAndActivationCandidateRouteHasFamily",
    "noUnregisteredPublicMaxWidth",
    "noFinderHrefOrText",
    "oneH1PerPublicContentRoute",
    "canonicalPreserved",
    "schemaPreserved",
    "affiliateBindingsPreserved",
    "noCtaBoundariesPreserved",
    "firstViewportRulesPass",
    "countryPreviewAuthorizationRemainsClosed",
    "zeroOverflowAtRequiredViewports"
  ]
}
