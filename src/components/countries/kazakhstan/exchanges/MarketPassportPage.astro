---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ReviewStatus from '../../../../components/portal-v2/ReviewStatus.astro';
import {
  assertPortalRouteRecord,
  resolvePortalRoute,
} from '../../../../data/contracts/portalRouteGuards';
import type {
  MarketProfile,
  NormalizedClaim,
  SourcePacket,
} from '../../../../data/contracts/portalFactory';
import {
  binanceKazakhstanClaims,
  binanceKazakhstanMarketProfile,
  binanceKazakhstanSourcePackets,
} from '../../../../data/pilots/kz/binanceReview';
import {
  bybitKazakhstanClaims,
  bybitKazakhstanMarketProfile,
  bybitKazakhstanSourcePackets,
} from '../../../../data/pilots/kz/bybitReview';
import {
  okxKazakhstanClaims,
  okxKazakhstanMarketProfile,
  okxKazakhstanSourcePackets,
} from '../../../../data/pilots/kz/okxReview';
import {
  binanceKazakhstanFactParityPass,
  binanceKazakhstanLocalizedViews,
} from '../../../../data/pilots/kz/binanceLocaleParity';
import {
  binanceKazakhstanPassportReviewPackage,
  bybitKazakhstanPassportReviewPackage,
  kazakhstanReviewContentPackagesPass,
  okxKazakhstanPassportReviewPackage,
  type KazakhstanReviewContentPackage,
} from '../../../../data/pilots/kz/contentPackages';
import { kazakhstanDraftRankingSnapshot } from '../../../../data/pilots/kz/rankingSnapshotDraft';

const exchangeIds = ['binance', 'bybit', 'okx'] as const;
type ExchangeId = typeof exchangeIds[number];

export function getStaticPaths() {
  return exchangeIds.map(exchangeId => ({
    params: { exchange: exchangeId },
    props: { exchangeId },
  }));
}

interface PassportConfig {
  exchangeId: ExchangeId;
  exchangeName: string;
  profile: MarketProfile;
  claims: NormalizedClaim[];
  sources: SourcePacket[];
  packageData: KazakhstanReviewContentPackage;
  rankingState: 'under_review' | 'excluded';
  conflictPreserving: boolean;
  intro: string;
}

const configs: Record<ExchangeId, PassportConfig> = {
  binance: {
    exchangeId: 'binance',
    exchangeName: 'Binance',
    profile: binanceKazakhstanMarketProfile,
    claims: binanceKazakhstanClaims,
    sources: binanceKazakhstanSourcePackets,
    packageData: binanceKazakhstanPassportReviewPackage,
    rankingState: 'under_review',
    conflictPreserving: false,
    intro: 'A validated review profile built from AFSA register records, Binance Kazakhstan documentation and dated public P2P surfaces. Availability remains limited and the local offer is not approved.',
  },
  bybit: {
    exchangeId: 'bybit',
    exchangeName: 'Bybit',
    profile: bybitKazakhstanMarketProfile,
    claims: bybitKazakhstanClaims,
    sources: bybitKazakhstanSourcePackets,
    packageData: bybitKazakhstanPassportReviewPackage,
    rankingState: 'under_review',
    conflictPreserving: false,
    intro: 'A validated Kazakhstan profile with an AFSA licence, mandatory Standard KYC documentation and date-bound P2P fee and limit evidence. Welcome-offer eligibility remains under review.',
  },
  okx: {
    exchangeId: 'okx',
    exchangeName: 'OKX',
    profile: okxKazakhstanMarketProfile,
    claims: okxKazakhstanClaims,
    sources: okxKazakhstanSourcePackets,
    packageData: okxKazakhstanPassportReviewPackage,
    rankingState: 'excluded',
    conflictPreserving: true,
    intro: 'A validated conflicting profile. Technical and KZT P2P surfaces are visible, while AFSA warning and regulated-P2P framework evidence prevent a positive local-authorization conclusion.',
  },
};

const { exchangeId } = Astro.props as { exchangeId: ExchangeId };
const config = configs[exchangeId];
const pkg = config.packageData;

const routeRecord = assertPortalRouteRecord({
  routeId: `market-passport:${exchangeId}:kz:noindex-preview`,
  reviewPath: '/__design/cbw-v2/market-passport/',
  publicPath: `/countries/kazakhstan/exchanges/${exchangeId}/`,
  publicationState: 'draft',
  indexabilityAuthorized: false,
});

let publicResolutionRejected = false;
try {
  resolvePortalRoute(routeRecord, 'public');
} catch {
  publicResolutionRejected = true;
}

const authorizationFlags = [
  ['Recommendation', pkg.recommendationAuthorized],
  ['Publication', pkg.publicationAuthorized],
  ['Ranking rows', pkg.rankingRowsAuthorized],
  ['Affiliate CTA', pkg.affiliateCtaAuthorized],
  ['Indexability', pkg.indexabilityAuthorized],
] as const;

const profileClaimIds = config.profile.claimIds;
const candidateIds = pkg.candidateClaimIds;
const sourceIds = config.sources.map(source => source.packetId);
const packageSourceIds = pkg.sourcePacketIds;
const contradictionCount = config.claims.filter(claim => claim.contradictingPacketIds.length > 0).length;
const dateBoundClaims = config.claims.filter(claim => claim.expiresAt !== undefined);

const bybitRequiredDateBoundIds = [
  'claim:kz:bybit:standard-kyc-mandatory',
  'claim:kz:bybit:p2p-platform-fee-zero',
  'claim:kz:bybit:p2p-kzt-usdt-per-ad-range',
];
const bybitDateBoundPass = exchangeId !== 'bybit' || bybitRequiredDateBoundIds.every(claimId => {
  const claim = config.claims.find(item => item.claimId === claimId);
  return Boolean(claim?.effectiveAt && claim?.expiresAt);
});

const englishIds = binanceKazakhstanLocalizedViews.en.facts.map(item => item.claim.claimId);
const russianIds = binanceKazakhstanLocalizedViews.ru.facts.map(item => item.claim.claimId);
const binanceParityBoundaryPass = exchangeId !== 'binance' || (
  binanceKazakhstanFactParityPass
  && englishIds.length === 10
  && JSON.stringify(englishIds) === JSON.stringify(russianIds)
);

const okxConflictBoundaryPass = exchangeId !== 'okx' || (
  config.profile.availability === 'unknown'
  && config.conflictPreserving
  && config.rankingState === 'excluded'
  && contradictionCount >= 1
  && pkg.recommendationAuthorized === false
);

const rankingBoundaryPass = config.rankingState === 'excluded'
  ? kazakhstanDraftRankingSnapshot.excludedExchangeIds.includes(exchangeId)
  : kazakhstanDraftRankingSnapshot.underReviewExchangeIds.includes(exchangeId);

const foundationPass =
  kazakhstanReviewContentPackagesPass
  && config.profile.approval === 'validated'
  && config.profile.offerEligibility === 'under_review'
  && pkg.approval === 'draft'
  && pkg.approvedClaimIds.length === 0
  && pkg.marketProfileId === config.profile.profileId
  && JSON.stringify(candidateIds) === JSON.stringify(profileClaimIds)
  && JSON.stringify(packageSourceIds) === JSON.stringify(sourceIds.filter(sourceId => packageSourceIds.includes(sourceId)))
  && packageSourceIds.every(sourceId => sourceIds.includes(sourceId))
  && authorizationFlags.every(([, value]) => value === false)
  && kazakhstanDraftRankingSnapshot.rows.length === 0
  && rankingBoundaryPass
  && publicResolutionRejected
  && bybitDateBoundPass
  && binanceParityBoundaryPass
  && okxConflictBoundaryPass;

if (!foundationPass) {
  throw new Error(`Kazakhstan ${exchangeId} market-passport preview failed its governed boundary.`);
}

const titleCase = (value: string) => value
  .replace(/[-_]/g, ' ')
  .replace(/\b\w/g, letter => letter.toUpperCase());

const displayValue = (value: string | number | boolean) => {
  if (typeof value === 'boolean') return value ? 'Yes' : 'No';
  return String(value);
};

const toneForAvailability = (value: string) => {
  if (value === 'available') return 'verified' as const;
  if (value === 'limited') return 'partial' as const;
  if (value === 'unknown') return 'review' as const;
  return 'restricted' as const;
};
---

<CleanLayout
  title={`${config.exchangeName} in Kazakhstan — Review Passport | CryptoBonusWorld`}
  description={`Noindex review passport for ${config.exchangeName} in Kazakhstan. Evidence state, limitations and publication boundaries without ranking or affiliate recommendation.`}
  noindex={true}
  bodyClass="kz-passport-preview"
>
  <div
    class="passport-page"
    data-passport={exchangeId}
    data-availability={config.profile.availability}
    data-offer-eligibility={config.profile.offerEligibility}
    data-ranking-state={config.rankingState}
    data-conflict-preserving={String(config.conflictPreserving)}
  >
    <section class="passport-hero">
      <div class="shell">
        <div class="preview-strip">
          <span>Noindex market passport</span>
          <span>Draft package · no recommendation · no affiliate action</span>
        </div>

        <div class="crumbs">Kazakhstan <span>/</span> Exchanges <span>/</span> {config.exchangeName}</div>

        <div class="hero-grid">
          <div>
            <p class="eyebrow">Exchange × country evidence profile</p>
            <h1>{config.exchangeName} in Kazakhstan</h1>
            <p class="lede">{config.intro}</p>
          </div>

          <aside class="state-card">
            <p class="card-label">Validated review state</p>
            <ReviewStatus
              label={`${config.profile.approval} · ${config.profile.availability}`}
              detail={`Local offer: ${config.profile.offerEligibility.replace(/_/g, ' ')} · Ranking: ${config.rankingState.replace(/_/g, ' ')}`}
              tone={toneForAvailability(config.profile.availability)}
            />
            <dl>
              <div><dt>Candidate claims</dt><dd>{config.claims.length}</dd></div>
              <div><dt>Source packets</dt><dd>{config.sources.length}</dd></div>
              <div><dt>Ranking position</dt><dd>None</dd></div>
              <div><dt>Indexability</dt><dd>Disabled</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="metrics-section">
      <div class="shell metrics-grid">
        <article class="metric-card">
          <span>Availability</span>
          <strong>{titleCase(config.profile.availability)}</strong>
          <small>Country-level review state, not universal product entitlement</small>
        </article>
        <article class="metric-card">
          <span>Offer eligibility</span>
          <strong>{titleCase(config.profile.offerEligibility)}</strong>
          <small>No Kazakhstan affiliate offer is approved by this profile</small>
        </article>
        <article class="metric-card">
          <span>Date-bound claims</span>
          <strong>{dateBoundClaims.length}</strong>
          <small>Claims with explicit expiry and freshness boundaries</small>
        </article>
        <article class="metric-card">
          <span>Contradicting claims</span>
          <strong>{contradictionCount}</strong>
          <small>Contradictions remain visible instead of being averaged away</small>
        </article>
      </div>
    </section>

    <section class="content-section">
      <div class="shell content-grid">
        <div class="main-column">
          {exchangeId === 'okx' && (
            <article class="conflict-banner" data-conflict-banner>
              <p class="eyebrow">Conflict preserved</p>
              <h2>Technical reachability is not local authorization</h2>
              <p>
                OKX remains excluded and non-recommended. Visible platform and KZT P2P surfaces
                coexist with AFSA warning and regulated-P2P framework evidence; no positive
                Kazakhstan authorization conclusion is permitted.
              </p>
            </article>
          )}

          {exchangeId === 'bybit' && (
            <article class="date-banner" data-date-bound-banner>
              <p class="eyebrow">Date-bound evidence</p>
              <h2>KYC, fee and P2P range require freshness labels</h2>
              <p>
                Standard KYC, the published 0% platform fee and the 900–22,000,000 KZT per-ad range
                are retained with explicit effective and expiry timestamps. They do not prove a
                currently active advertisement or account approval.
              </p>
            </article>
          )}

          <header class="section-heading">
            <p class="eyebrow">Validated candidate facts</p>
            <h2>Evidence-backed claims</h2>
            <p>
              Candidate claims are validated for review but remain unapproved for public recommendation.
              Every card keeps confidence, dates, evidence count and limitations.
            </p>
          </header>

          {exchangeId === 'binance' ? (
            <div class="localized-facts" data-locale-switcher>
              <div class="locale-tabs" role="tablist" aria-label="Binance Kazakhstan review language">
                <button type="button" class="active" data-locale-button="en" role="tab" aria-selected="true">English</button>
                <button type="button" data-locale-button="ru" role="tab" aria-selected="false">Русский</button>
                <span>Immutable claim parity: PASS</span>
              </div>

              {(['en', 'ru'] as const).map(locale => (
                <section
                  class="locale-panel"
                  data-locale-panel={locale}
                  hidden={locale === 'ru'}
                  lang={locale}
                >
                  <div class="localized-profile-copy">
                    <strong>{binanceKazakhstanLocalizedViews[locale].profileCopy.title}</strong>
                    <span>{binanceKazakhstanLocalizedViews[locale].profileCopy.statusLabel}</span>
                  </div>
                  <div class="fact-grid">
                    {binanceKazakhstanLocalizedViews[locale].facts.map(({ claim, copy }) => (
                      <article class="fact-card" data-claim-id={claim.claimId}>
                        <div class="fact-head">
                          <span>{copy.label}</span>
                          <ReviewStatus label={claim.confidence} tone={claim.confidence === 'high' ? 'verified' : 'partial'} compact={true} />
                        </div>
                        <h3>{displayValue(claim.value)}</h3>
                        <p>{copy.summary}</p>
                        <dl>
                          <div><dt>Effective</dt><dd>{claim.effectiveAt?.slice(0, 10) ?? 'Not stated'}</dd></div>
                          <div><dt>Expires</dt><dd>{claim.expiresAt?.slice(0, 10) ?? 'No explicit expiry'}</dd></div>
                          <div><dt>Evidence</dt><dd>{claim.supportingPacketIds.length}</dd></div>
                          <div><dt>Approval</dt><dd>{claim.approval}</dd></div>
                        </dl>
                        <small>{claim.limitations[0]}</small>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          ) : (
            <div class="fact-grid">
              {config.claims.map(claim => (
                <article
                  class="fact-card"
                  data-claim-id={claim.claimId}
                  data-date-bound={claim.expiresAt ? 'true' : undefined}
                  data-contradiction={claim.contradictingPacketIds.length ? 'true' : undefined}
                >
                  <div class="fact-head">
                    <span>{titleCase(claim.predicate)}</span>
                    <ReviewStatus
                      label={claim.confidence}
                      tone={claim.contradictingPacketIds.length ? 'restricted' : claim.confidence === 'high' ? 'verified' : 'partial'}
                      compact={true}
                    />
                  </div>
                  <h3>{displayValue(claim.value)}</h3>
                  <dl>
                    <div><dt>Effective</dt><dd>{claim.effectiveAt?.slice(0, 10) ?? 'Not stated'}</dd></div>
                    <div><dt>Expires</dt><dd>{claim.expiresAt?.slice(0, 10) ?? 'No explicit expiry'}</dd></div>
                    <div><dt>Evidence</dt><dd>{claim.supportingPacketIds.length}</dd></div>
                    <div><dt>Contradictions</dt><dd>{claim.contradictingPacketIds.length}</dd></div>
                  </dl>
                  <div class="fact-limitations">
                    <strong>Limitations</strong>
                    <ul>{claim.limitations.map(item => <li>{item}</li>)}</ul>
                  </div>
                </article>
              ))}
            </div>
          )}

          <section class="sources-section">
            <header class="section-heading section-heading-small">
              <p class="eyebrow">Source register</p>
              <h2>Evidence packets</h2>
            </header>
            <div class="source-list">
              {config.sources.map(source => (
                <article class="source-card">
                  <div>
                    <span>{source.sourceClass.replace(/_/g, ' ')}</span>
                    <h3>{source.publisher}</h3>
                  </div>
                  <dl>
                    <div><dt>Accessed</dt><dd>{source.accessedAt.slice(0, 10)}</dd></div>
                    <div><dt>Topics</dt><dd>{source.topics.join(', ')}</dd></div>
                    <div><dt>Warnings</dt><dd>{source.extractionWarnings.length}</dd></div>
                  </dl>
                  <a href={source.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">Open official source ↗</a>
                </article>
              ))}
            </div>
          </section>
        </div>

        <aside class="side-column">
          <section class="side-card">
            <p class="card-label">ContentPackage</p>
            <dl class="side-dl">
              <div><dt>Package</dt><dd>{pkg.packageId}</dd></div>
              <div><dt>Approval</dt><dd>{pkg.approval}</dd></div>
              <div><dt>Approved claims</dt><dd>{pkg.approvedClaimIds.length}</dd></div>
              <div><dt>Candidate claims</dt><dd>{pkg.candidateClaimIds.length}</dd></div>
              <div><dt>Ranking position</dt><dd>None</dd></div>
            </dl>
          </section>

          <section class="side-card">
            <p class="card-label">Authorization flags</p>
            <div class="flag-list">
              {authorizationFlags.map(([label, value]) => (
                <div><span>{label}</span><strong>{value ? 'ON' : 'OFF'}</strong></div>
              ))}
            </div>
          </section>

          <section class="side-card">
            <p class="card-label">Profile limitations</p>
            <ul class="profile-limitations">
              {config.profile.limitations.map(item => <li>{item}</li>)}
            </ul>
          </section>

          <section class:list={['boundary-card', { conflict: config.conflictPreserving }]}>
            <strong>{config.conflictPreserving ? 'Conflict-preserving boundary' : 'Preview-only boundary'}</strong>
            <p>
              This passport is noindex, absent from sitemap, has no ranking position and contains no
              affiliate action. The route guard rejects public resolution until a later approved package exists.
            </p>
          </section>
        </aside>
      </div>
    </section>
  </div>

  {exchangeId === 'binance' && (
    <script is:inline>
      document.querySelectorAll('[data-locale-switcher]').forEach(root => {
        const buttons = Array.from(root.querySelectorAll('[data-locale-button]'));
        const panels = Array.from(root.querySelectorAll('[data-locale-panel]'));
        buttons.forEach(button => {
          button.addEventListener('click', () => {
            const locale = button.getAttribute('data-locale-button');
            buttons.forEach(item => {
              const selected = item === button;
              item.classList.toggle('active', selected);
              item.setAttribute('aria-selected', selected ? 'true' : 'false');
            });
            panels.forEach(panel => {
              panel.hidden = panel.getAttribute('data-locale-panel') !== locale;
            });
          });
        });
      });
    </script>
  )}
</CleanLayout>

<style>
  :global(body.kz-passport-preview) { background: #f7f8f4; }
  .passport-page { min-height: 100vh; color: #13233e; background: #f7f8f4; }
  .shell { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
  .passport-hero { padding: 18px 0 72px; color: #fff; background: radial-gradient(circle at 80% 16%, rgba(247,147,26,.22), transparent 30%), linear-gradient(135deg,#091426,#173250); }
  .preview-strip { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 18px; padding: 10px 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; color: #c7d2e1; font-size: 9px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .crumbs { margin-top: 34px; color: #aebed2; font-size: 12px; }
  .crumbs span { padding-inline: 7px; color: #f7931a; }
  .hero-grid { display: grid; gap: 28px; align-items: end; margin-top: 34px; }
  .eyebrow, .card-label { margin: 0 0 10px; color: #f7931a; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed', 'Inter', sans-serif; text-transform: uppercase; letter-spacing: -.025em; }
  h1 { max-width: 820px; margin: 0; font-size: clamp(52px,8vw,86px); line-height: .92; }
  .lede { max-width: 760px; margin: 24px 0 0; color: #d2ddea; font-size: 16px; line-height: 1.75; }
  .state-card { padding: 21px; border: 1px solid rgba(255,255,255,.16); border-radius: 16px; background: rgba(255,255,255,.08); }
  .state-card :global(.review-status small) { color: #cad6e4; }
  .state-card dl { display: grid; gap: 10px; margin: 18px 0 0; }
  .state-card dl div { display: flex; justify-content: space-between; gap: 14px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.12); }
  .state-card dt { color: #b8c5d4; font-size: 10px; }
  .state-card dd { margin: 0; font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .metrics-section { position: relative; margin-top: -27px; }
  .metrics-grid { display: grid; gap: 10px; }
  .metric-card { min-width: 0; padding: 18px; border: 1px solid #dce2dc; border-radius: 14px; background: #fff; box-shadow: 0 12px 28px rgba(19,35,62,.08); }
  .metric-card > span { display: block; color: #738092; font-size: 9px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .metric-card > strong { display: block; margin: 8px 0 4px; color: #13233e; font-family: 'Barlow Condensed', 'Inter', sans-serif; font-size: 29px; line-height: 1; text-transform: uppercase; }
  .metric-card small { color: #718092; font-size: 10px; line-height: 1.45; }
  .content-section { padding: 74px 0 90px; }
  .content-grid { display: grid; gap: 26px; }
  .section-heading h2, .conflict-banner h2, .date-banner h2 { margin: 0; font-size: clamp(38px,6vw,58px); line-height: .96; }
  .section-heading > p:last-child, .conflict-banner p, .date-banner p { max-width: 760px; color: #627080; line-height: 1.7; }
  .section-heading-small { margin-top: 42px; }
  .conflict-banner, .date-banner { margin-bottom: 30px; padding: 25px; border: 1px solid #e2b4af; border-left: 5px solid #a12828; border-radius: 15px; background: #fff4f3; }
  .date-banner { border-color: #ead3bd; border-left-color: #c46a25; background: #fff8ef; }
  .locale-tabs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 26px 0 14px; }
  .locale-tabs button { min-height: 38px; padding: 0 14px; border: 1px solid #d5ddd5; border-radius: 9px; color: #45556a; background: #fff; font-weight: 800; }
  .locale-tabs button.active { border-color: #f7931a; color: #13233e; background: #fff1dc; }
  .locale-tabs span { color: #16834b; font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .localized-profile-copy { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 13px; padding: 13px 15px; border-radius: 10px; color: #405067; background: #eef3f8; }
  .localized-profile-copy strong { color: #13233e; }
  .fact-grid { display: grid; gap: 12px; margin-top: 27px; }
  .locale-panel .fact-grid { margin-top: 0; }
  .fact-card { min-width: 0; padding: 19px; border: 1px solid #dce2dc; border-radius: 14px; background: #fff; box-shadow: 0 7px 22px rgba(19,35,62,.035); }
  .fact-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .fact-head > span { color: #778494; font-size: 9px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .fact-card h3 { margin: 11px 0 8px; color: #13233e; font-family: 'Barlow Condensed', 'Inter', sans-serif; font-size: 27px; line-height: 1; overflow-wrap: anywhere; }
  .fact-card > p { color: #617083; font-size: 11px; line-height: 1.6; }
  .fact-card dl { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-top: 14px; }
  .fact-card dl div { padding: 9px; border-radius: 8px; background: #f5f7f4; }
  .fact-card dt { color: #8290a0; font-size: 8px; text-transform: uppercase; }
  .fact-card dd { margin: 3px 0 0; color: #2f4057; font-size: 9px; font-weight: 800; overflow-wrap: anywhere; }
  .fact-card > small { display: block; margin-top: 12px; color: #758191; font-size: 9px; line-height: 1.5; }
  .fact-limitations { margin-top: 13px; padding-top: 12px; border-top: 1px solid #edf0ec; }
  .fact-limitations strong { font-size: 9px; text-transform: uppercase; }
  .fact-limitations ul { margin: 7px 0 0; padding-left: 17px; color: #687587; font-size: 9px; line-height: 1.5; }
  .source-list { display: grid; gap: 9px; }
