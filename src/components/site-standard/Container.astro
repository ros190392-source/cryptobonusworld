---
import '../../styles/site-standard-v1.css';
import type { ContainerRole } from '../../data/siteStandard/siteStandardV1';

export interface Props {
  size?: ContainerRole;
  as?: 'div' | 'section' | 'article' | 'aside' | 'header' | 'footer' | 'nav';
  class?: string;
}

const {
  size = 'standard',
  as: Tag = 'div',
  class: className = '',
} = Astro.props;
---

<Tag class:list={['cbw-container', `cbw-container--${size}`, className]} data-container-role={size}>
  <slot />
</Tag>
