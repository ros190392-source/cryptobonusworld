---
/**
 * PREVIEW-ONLY exchange surface.
 *
 * This component deliberately exposes no referral code, bonus amount, affiliate
 * URL or /go route. Promotion to a public/commercial state is a separate governed
 * workflow; this owner-preview remains neutral regardless of visual readiness.
 */
import type { ExchangePreviewEntry } from '../../data/exchangePreview/batch-01';
import type { CtaMode } from '../../data/exchangePreview/cta-contract';
import PageFrame from '../site-standard/PageFrame.astro';
import FirstViewport from '../site-standard/FirstViewport.astro';
import Section from '../site-standard/Section.astro';
import StatusBadge from '../site-standard/StatusBadge.astro';

export interface Props {
  entry: ExchangePreviewEntry;
  ctaMode?: CtaMode;
}

const { entry: e, ctaMode = 'preview' } = Astro.props;

if (
  e.status !== 'under_review'
  || e.promoCode !== null
  || e.bonusAmount !== null
  || e.affiliateUrl !== null
  || e.externalCtaEnabled !== false
  || e.productionEligible !== false
) {
  throw new Error(`Preview exchange ${e.slug} violated the neutral preview registry boundary.`);
}

if (ctaMode !== 'preview') {
  throw new Error(`Preview exchange ${e.slug} may render only in preview CTA mode.`);
}

const checks = [
  ['Referral code', 'Not listed'],
  ['Bonus amount', 'Not verified'],
  ['Country availability', 'Not established'],
  ['Commercial action', 'Disabled'],
] as const;

const reviewItems = [
  'Verify current exchange identity and official source coverage.',
  'Review country restrictions, KYC and product access before any local claim.',
  'Verify referral or promotional terms independently before publishing a code or amount.',
  'Complete owner review before any production or commercial activation.',
];
---

<PageFrame family="exchange" class="exchange-preview-product">
  <div data-preview-exchange={e.slug} data-preview-status="under_review" data-preview-commercial="false">
    <FirstViewport
      family="exchange"
      container="standard"
      eyebrow="Exchange owner preview · noindex"
      title={`${e.displayName} review status`}
      lede="This exchange is still in CryptoBonusWorld's review pipeline. No referral code, bonus amount, country availability or commercial action is published from this preview."
    >
      <div class="preview-identity">
        <div class="preview-logo">
          <img src={e.logoSlotPath} alt={`${e.displayName} logo`} width="160" height="50" loading="eager" />
        </div>
        <div>
          <strong>{e.displayName}</strong>
          <StatusBadge label="Under review" tone="review" />
        </div>
      </div>
    </FirstViewport>

    <Section container="standard" spacing="compact" tone="page" ariaLabel={`${e.displayName} preview status`}>
      {e.ownerReviewRequired && e.ownerReviewNotice && (
        <aside class="owner-review-note cbw-card" data-owner-review-note>
          <strong>Owner review required</strong>
          <span>{e.ownerReviewNotice}</span>
        </aside>
      )}

      <header class="cbw-section-header">
        <p class="cbw-section-eyebrow">Current publication state</p>
        <h2 class="cbw-section-title">Nothing commercial is published yet</h2>
        <p class="cbw-section-lede">The preview can look product-ready without becoming claim-ready. Each factual or commercial field stays neutral until its own evidence and approval gate passes.</p>
      </header>

      <div class="preview-check-grid cbw-grid cbw-grid--2" data-preview-check-grid>
        {checks.map(([label, value]) => (
          <article class="cbw-card preview-check">
            <span>{label}</span>
            <strong>{value}</strong>
          </article>
        ))}
      </div>
    </Section>

    <Section container="prose" spacing="compact" tone="secondary" ariaLabel={`${e.displayName} preview review checklist`}>
      <details class="preview-review-details cbw-panel" data-preview-review-details>
        <summary>What still needs review</summary>
        <div class="preview-review-copy">
          <ul>{reviewItems.map(item => <li>{item}</li>)}</ul>
          <p>Visual completion never grants affiliate, ranking, country or offer authority.</p>
        </div>
      </details>

      <div class="preview-actions">
        <a href="/exchanges/">View public exchange directory →</a>
        <span data-preview-primary aria-disabled="true">Commercial action disabled</span>
      </div>
    </Section>
  </div>
</PageFrame>

<style>
  .exchange-preview-product :global(.cbw-first-viewport--exchange) { --cbw-first-viewport-target: 250px; }
  .preview-identity { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 14px; align-items: center; margin-top: 18px; }
  .preview-logo { display: flex; width: 180px; height: 58px; align-items: center; justify-content: center; padding: 6px 10px; border: 1px solid rgba(255,255,255,.14); border-radius: var(--cbw-radius-control); background: rgba(255,255,255,.08); box-sizing: border-box; }
  .preview-logo img { display: block; max-width: 160px; max-height: 46px; width: auto; height: auto; object-fit: contain; }
  .preview-identity > div:last-child { display: grid; gap: 6px; justify-items: start; }
  .preview-identity strong { color: #fff; font-size: 13px; }
  .owner-review-note { display: grid; gap: 4px; margin-bottom: var(--cbw-space-5); border-color: #efd5ae; background: #fff7ea; }
  .owner-review-note strong { color: #7d5206; font-size: 11px; }
  .owner-review-note span { color: #765d39; font-size: 10px; line-height: 1.5; }
  .preview-check-grid { align-items: stretch; }
  .preview-check { display: grid; gap: 7px; min-height: 88px; align-content: center; }
  .preview-check span { color: var(--cbw-text-muted); font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .preview-check strong { color: var(--cbw-text-primary); font-size: 13px; }
  .preview-review-details summary { display: flex; min-height: 46px; align-items: center; justify-content: space-between; color: var(--cbw-text-primary); font-size: 13px; font-weight: 900; cursor: pointer; list-style: none; }
  .preview-review-details summary::-webkit-details-marker { display: none; }
  .preview-review-details summary::after { content: '+'; color: var(--cbw-text-muted); font-size: 18px; font-weight: 500; }
  .preview-review-details[open] summary::after { content: '−'; }
  .preview-review-copy { display: grid; gap: 12px; padding-top: 12px; border-top: 1px solid var(--cbw-border-standard); color: var(--cbw-text-secondary); font-size: 11px; line-height: 1.65; }
  .preview-review-copy ul { margin: 0; padding-left: 18px; }
  .preview-review-copy p { margin: 0; }
  .preview-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; align-items: center; }
  .preview-actions a,.preview-actions span { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; padding: 0 13px; border-radius: var(--cbw-radius-control); font-size: 10px; font-weight: 900; text-decoration: none; }
  .preview-actions a { border: 1px solid var(--cbw-border-standard); color: #925204; background: #fff; }
  .preview-actions span { color: #697486; background: #edf0f3; cursor: not-allowed; }
  @media (max-width: 639px) {
    .exchange-preview-product :global(.cbw-first-viewport--exchange) { --cbw-first-viewport-target: 285px; }
    .preview-identity { grid-template-columns: 1fr; }
    .preview-logo { width: 160px; height: 54px; }
  }
</style>
