---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-shell">
    <section class="footer-brand" aria-label="CryptoBonusWorld information">
      <a href="/" class="footer-logo" aria-label="CryptoBonusWorld home">
        <img src="/brand/cbw-header-mark-final.png" alt="" aria-hidden="true" width="46" height="46" loading="lazy" />
        <span>
          <strong><i>Crypto</i><b>Bonus</b><i>World</i></strong>
          <small>Country-aware exchange evidence</small>
        </span>
      </a>
      <p>
        Compare crypto exchange offers, research status and market limitations without mixing global claims with country-specific facts.
      </p>
      <div class="footer-context" aria-label="Current site context">
        <span>Global market</span><i aria-hidden="true"></i><span>English</span><i aria-hidden="true"></i><span>Country pages in review</span>
      </div>
    </section>

    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-column">
        <h2>Explore</h2>
        <a href="/#exchanges">Top 10 Exchanges</a>
        <a href="/exchanges/">All Exchanges</a>
        <a href="/promo-codes/">Promo Codes</a>
        <a href="/#guide">Bonus Guide</a>
        <a href="/faq/">FAQ</a>
      </div>

      <div class="footer-column">
        <h2>Research</h2>
        <a href="/methodology/">How We Verify</a>
        <a href="/editorial-policy/">Editorial Policy</a>
        <a href="/update-policy/">Update Policy</a>
        <a href="/about/">About CryptoBonusWorld</a>
      </div>

      <div class="footer-column">
        <h2>Legal</h2>
        <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <p>© {year} CryptoBonusWorld. Affiliate relationships do not determine ranking position or editorial status.</p>
    <p>Crypto trading involves significant risk. Verify current eligibility, restrictions and offer terms on the official exchange website. Nothing on this site is financial advice.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    color: rgba(255,255,255,.62);
    background:
      radial-gradient(circle at 12% 0%, rgba(247,147,26,.12), transparent 24%),
      linear-gradient(145deg, #08111f 0%, #0d192b 58%, #13233e 100%);
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .footer-shell {
    width: min(var(--cbw-page-max, 1180px), 100%);
    margin: 0 auto;
    padding: 44px 20px 36px;
    display: grid;
    gap: 36px;
  }

  .footer-brand { max-width: 390px; }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
  }
  .footer-logo img { width: 44px; height: 44px; object-fit: contain; }
  .footer-logo span, .footer-logo strong, .footer-logo small { display: block; }
  .footer-logo strong {
    display: flex;
    align-items: baseline;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -.035em;
  }
  .footer-logo strong i { color: rgba(255,255,255,.82); font-style: normal; font-weight: 800; }
  .footer-logo strong b { color: #f7931a; font-weight: 900; }
  .footer-logo small {
    margin-top: 5px;
    color: rgba(255,255,255,.4);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .footer-brand > p { margin: 18px 0 0; color: rgba(255,255,255,.53); font-size: 13px; line-height: 1.75; }

  .footer-context {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,.46);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .065em;
    text-transform: uppercase;
  }
  .footer-context i { width: 3px; height: 3px; border-radius: 50%; background: #f7931a; }

  .footer-links { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 30px 24px; }
  .footer-column { display: flex; flex-direction: column; gap: 9px; }
  .footer-column h2 {
    margin: 0 0 5px;
    color: rgba(255,255,255,.37);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .footer-column a {
    width: fit-content;
    color: rgba(255,255,255,.64);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
    transition: color .15s, transform .15s;
  }
  .footer-column a:hover, .footer-column a:focus-visible { color: #f7a83b; transform: translateX(2px); }

  .footer-bottom {
    width: min(var(--cbw-page-max, 1180px), 100%);
    margin: 0 auto;
    padding: 18px 20px 24px;
    display: grid;
    gap: 5px;
    border-top: 1px solid rgba(255,255,255,.07);
  }
  .footer-bottom p { margin: 0; color: rgba(255,255,255,.3); font-size: 10px; line-height: 1.65; }

  @media (min-width: 640px) {
    .footer-shell { padding-inline: 24px; }
    .footer-links { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .footer-bottom { padding-inline: 24px; }
  }

  @media (min-width: 900px) {
    .footer-shell { grid-template-columns: minmax(280px, .85fr) minmax(520px, 1.15fr); gap: 80px; padding: 58px 32px 46px; }
    .footer-bottom { grid-template-columns: 1fr 1.25fr; gap: 36px; padding: 18px 32px 26px; }
    .footer-bottom p:last-child { text-align: right; }
  }
</style>
