---
import CleanLayout from '../../../layouts/CleanLayout.astro';
import PageFrame from '../../../components/site-standard/PageFrame.astro';
import FirstViewport from '../../../components/site-standard/FirstViewport.astro';
import Section from '../../../components/site-standard/Section.astro';
import CountryCandidateCard from '../../../components/country/CountryCandidateCard.astro';
import {
  assertPortalRouteRecord,
  resolvePortalRoute,
} from '../../../data/contracts/portalRouteGuards';
import {
  KZ_BINANCE_CANDIDATE,
  KZ_BYBIT_CANDIDATE,
  KZ_OKX_CANDIDATE,
  KZ_P0_MARKET_PROFILE_CANDIDATE_SET,
} from '../../../data/candidates/kzP0MarketProfileCandidates';

const routeRecord = assertPortalRouteRecord({
  routeId: 'country:kz:noindex-preview',
  reviewPath: '/__design/cbw-v2/country/',
  publicPath: '/countries/kazakhstan/',
  publicationState: 'draft',
  indexabilityAuthorized: false,
});

let publicResolutionRejected = false;
try {
  resolvePortalRoute(routeRecord, 'public');
} catch {
  publicResolutionRejected = true;
}

const candidates = [
  {
    name: 'Binance',
    slug: 'binance',
    candidate: KZ_BINANCE_CANDIDATE,
    href: '/countries/kazakhstan/exchanges/binance/',
  },
  {
    name: 'Bybit',
    slug: 'bybit',
    candidate: KZ_BYBIT_CANDIDATE,
    href: '/countries/kazakhstan/exchanges/bybit/',
  },
  {
    name: 'OKX',
    slug: 'okx',
    candidate: KZ_OKX_CANDIDATE,
    href: '/countries/kazakhstan/exchanges/okx/',
  },
] as const;

const boundaryPass =
  publicResolutionRejected
  && KZ_P0_MARKET_PROFILE_CANDIDATE_SET.entries.length === 3
  && candidates.every(({ candidate }) => candidate.publicAuthority === false && candidate.importable === false)
  && KZ_OKX_CANDIDATE.state === 'blocked';

if (!boundaryPass) {
  throw new Error('Kazakhstan country preview failed the governed noindex/candidate boundary.');
}
---

<CleanLayout
  title="Crypto Exchanges in Kazakhstan — Review Preview | CryptoBonusWorld"
  description="Noindex owner preview of Kazakhstan exchange candidates. Local ranking, publication and affiliate actions remain disabled until the governed evidence gates are satisfied."
  noindex={true}
  bodyClass="country-kz-preview"
>
  <PageFrame family="country" class="country-kz-product">
    <div data-country-preview="KZ" data-approved-ranking-rows="0">
      <FirstViewport
        family="country"
        container="wide"
        eyebrow="Kazakhstan · evidence-led owner preview"
        title="Crypto exchanges in Kazakhstan"
        lede="Three governed exchange candidates are shown below without ranking positions. Country availability, product access and referral eligibility remain separate evidence questions."
      >
        <div class="country-fixed-identity" aria-label="Kazakhstan local ranking status">
          <span aria-hidden="true">🇰🇿</span>
          <div>
            <strong>Local ranking under review</strong>
            <small>0 approved ranking rows · no local affiliate recommendation</small>
          </div>
        </div>
      </FirstViewport>

      <Section container="wide" spacing="compact" tone="page" ariaLabel="Kazakhstan exchange candidates">
        <header class="cbw-section-header">
          <p class="cbw-section-eyebrow">Exchange candidates</p>
          <h2 class="cbw-section-title">Evidence first, ranking later</h2>
          <p class="cbw-section-lede">
            These cards summarize the current governed candidate objects. “Non-ranked” means exactly that:
            no position, recommendation or country-specific affiliate eligibility has been approved.
          </p>
        </header>

        <div class="cbw-card-grid cbw-card-grid--3 country-candidate-grid" data-country-candidate-grid>
          {candidates.map((item) => (
            <CountryCandidateCard
              name={item.name}
              slug={item.slug}
              candidate={item.candidate}
              href={item.href}
            />
          ))}
        </div>
      </Section>

      <Section container="standard" spacing="compact" tone="secondary" ariaLabel="How to read the Kazakhstan preview">
        <details class="country-review-details cbw-panel" data-country-review-details>
          <summary>How to read this country preview</summary>
          <div class="country-review-copy">
            <p>
              A candidate can contain useful evidence without being public authority. Freshness, unresolved restrictions,
              account-level eligibility and local campaign terms can still block any later promotion decision.
            </p>
            <p>
              The Kazakhstan page therefore does not convert a global exchange ranking, referral route or historical market signal
              into a local recommendation. The public ranking remains empty until a separate governed approval step succeeds.
            </p>
          </div>
        </details>
      </Section>
    </div>
  </PageFrame>
</CleanLayout>

<style>
  :global(body.country-kz-preview) { background: var(--cbw-surface-page, #f7f8f4); }
  .country-kz-product :global(.cbw-first-viewport--country) {
    --cbw-first-viewport-target: 220px;
  }
  .country-fixed-identity {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    margin-top: 18px;
    padding: 11px 14px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--cbw-radius-control, 10px);
    background: rgba(255,255,255,.07);
  }
  .country-fixed-identity > span { font-size: 30px; line-height: 1; }
  .country-fixed-identity div { display: grid; gap: 2px; }
  .country-fixed-identity strong { color: #fff; font-size: 12px; }
  .country-fixed-identity small { color: rgba(255,255,255,.62); font-size: 9px; line-height: 1.4; }
  .country-candidate-grid { align-items: stretch; }
  .country-review-details summary {
    display: flex;
    min-height: 46px;
    align-items: center;
    justify-content: space-between;
    color: var(--cbw-text-primary);
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
    list-style: none;
  }
  .country-review-details summary::-webkit-details-marker { display: none; }
  .country-review-details summary::after { content: '+'; color: var(--cbw-text-muted); font-size: 18px; font-weight: 500; }
  .country-review-details[open] summary::after { content: '−'; }
  .country-review-copy { padding-top: 12px; border-top: 1px solid var(--cbw-border-standard); color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.7; }
  .country-review-copy p { margin: 0; }
  .country-review-copy p + p { margin-top: 10px; }
  @media (max-width: 639px) {
    .country-kz-product :global(.cbw-first-viewport--country) { --cbw-first-viewport-target: 250px; }
    .country-fixed-identity { width: 100%; }
  }
</style>
