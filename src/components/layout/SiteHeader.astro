---
const currentPath = Astro.url.pathname;
const exchangeActive = [
  '/exchanges', '/bybit', '/mexc', '/okx', '/bitget', '/kucoin', '/bingx',
].some(path => currentPath.startsWith(path));

const exchanges = [
  { href: '/exchanges/', label: 'All Exchanges' },
  { href: '/bybit/', label: 'Bybit' },
  { href: '/mexc/', label: 'MEXC' },
  { href: '/okx/', label: 'OKX' },
  { href: '/bitget/', label: 'Bitget' },
  { href: '/kucoin/', label: 'KuCoin' },
  { href: '/bingx/', label: 'BingX' },
];
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <a href="/" class="brand" aria-label="CryptoBonusWorld home">
      <span class="brand-mark" aria-hidden="true">
        <img
          src="/brand/cbw-header-mark-final.png"
          srcset="/brand/cbw-header-mark-final@1x.png 1x, /brand/cbw-header-mark-final@2x.png 2x"
          alt=""
          width="44"
          height="44"
          fetchpriority="high"
        />
      </span>
      <span class="brand-copy">
        <span class="brand-name"><span>Crypto</span><strong>Bonus</strong><span>World</span></span>
        <small>Country-aware exchange evidence</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/#exchanges" class="nav-link">Top 10</a>

      <details class:list={['nav-dropdown', { 'is-active': exchangeActive }]}
        data-nav-dropdown>
        <summary>Exchanges <span aria-hidden="true">⌄</span></summary>
        <div class="dropdown-panel">
          {exchanges.map(item => (
            <a href={item.href} class:list={{ 'is-current': currentPath === item.href }}>
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <a href="/promo-codes/" class:list={['nav-link', { 'is-active': currentPath.startsWith('/promo-codes') }]}>Promo Codes</a>
      <a href="/methodology/" class:list={['nav-link', { 'is-active': currentPath.startsWith('/methodology') }]}>How We Verify</a>
    </nav>

    <div class="header-actions">
      <div class="context-chip" aria-label="Current context: Global market, English language">
        <span>Global</span><i aria-hidden="true"></i><span>EN</span>
      </div>
      <a href="/#exchanges" class="header-cta">Compare Top 10</a>
      <button
        class="menu-button"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-button
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-navigation" hidden data-mobile-panel>
    <div class="mobile-context">
      <div><span>Market context</span><strong>Global</strong></div>
      <div><span>Language</span><strong>English</strong></div>
      <p>Country facts and language presentation are reviewed separately.</p>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/#exchanges" class="mobile-primary">Compare the Top 10 <span>→</span></a>
      <a href="/promo-codes/">Promo Codes <span>›</span></a>
      <a href="/methodology/">How We Verify <span>›</span></a>

      <details class="mobile-exchanges">
        <summary>Exchanges <span>+</span></summary>
        <div>
          {exchanges.map(item => <a href={item.href}>{item.label}</a>)}
        </div>
      </details>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const button = header?.querySelector('[data-menu-button]');
    const panel = header?.querySelector('[data-mobile-panel]');
    const dropdown = header?.querySelector('[data-nav-dropdown]');

    if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const closeMenu = () => {
      button.setAttribute('aria-expanded', 'false');
      button.setAttribute('aria-label', 'Open navigation menu');
      button.classList.remove('is-open');
      panel.hidden = true;
      document.body.classList.remove('cbw-menu-open');
    };

    const openMenu = () => {
      button.setAttribute('aria-expanded', 'true');
      button.setAttribute('aria-label', 'Close navigation menu');
      button.classList.add('is-open');
      panel.hidden = false;
      document.body.classList.add('cbw-menu-open');
    };

    button.addEventListener('click', () => {
      button.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });

    panel.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeMenu();
        if (dropdown instanceof HTMLDetailsElement) dropdown.open = false;
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeMenu();
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 300;
    color: #fff;
    background: rgba(10, 20, 36, .97);
    border-bottom: 1px solid rgba(255,255,255,.09);
    box-shadow: 0 8px 30px rgba(4, 10, 20, .18);
    backdrop-filter: blur(14px);
  }

  .header-shell {
    width: min(var(--cbw-page-max, 1180px), 100%);
    min-height: 64px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
  }
  .brand-mark img { width: 100%; height: 100%; object-fit: contain; }

  .brand-copy, .brand-name { display: flex; }
  .brand-copy { min-width: 0; flex-direction: column; gap: 3px; }
  .brand-name {
    align-items: baseline;
    white-space: nowrap;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -.035em;
    line-height: 1;
  }
  .brand-name span { color: rgba(255,255,255,.82); }
  .brand-name strong { color: #f7931a; font-weight: 900; }
  .brand-copy small {
    display: none;
    color: rgba(255,255,255,.45);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .075em;
    line-height: 1;
    text-transform: uppercase;
  }

  .desktop-nav { display: none; align-items: center; gap: 2px; }
  .nav-link, .nav-dropdown > summary {
    min-height: 42px;
    padding: 0 11px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 9px;
    color: rgba(255,255,255,.68);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition: color .15s, background .15s;
  }
  .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .nav-link:hover, .nav-link:focus-visible,
  .nav-link.is-active, .nav-dropdown.is-active > summary,
  .nav-dropdown > summary:hover, .nav-dropdown > summary:focus-visible {
    color: #fff;
    background: rgba(255,255,255,.07);
  }

  .nav-dropdown { position: relative; }
  .nav-dropdown[open] > summary { color: #fff; background: rgba(255,255,255,.07); }
  .nav-dropdown[open] > summary span { transform: rotate(180deg); }
  .nav-dropdown > summary span { font-size: 11px; transition: transform .15s; }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px;
    background: #13233e;
    box-shadow: 0 22px 60px rgba(0,0,0,.35);
  }
  .dropdown-panel a {
    min-height: 40px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    border-radius: 9px;
    color: rgba(255,255,255,.72);
    font-size: 13px;
    font-weight: 700;
  }
  .dropdown-panel a:hover, .dropdown-panel a:focus-visible,
  .dropdown-panel a.is-current { color: #13233e; background: #f7931a; }

  .header-actions { display: flex; align-items: center; gap: 8px; }
  .context-chip {
    display: none;
    min-height: 36px;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 999px;
    color: rgba(255,255,255,.72);
    background: rgba(255,255,255,.04);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .context-chip i { width: 1px; height: 13px; background: rgba(255,255,255,.16); }

  .header-cta {
    display: none;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0 15px;
    border-radius: 10px;
    color: #13233e;
    background: #f7931a;
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
    transition: background .15s, transform .15s;
  }
  .header-cta:hover, .header-cta:focus-visible { background: #ffad3d; transform: translateY(-1px); }

  .menu-button {
    width: 40px;
    height: 40px;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    color: #fff;
    background: rgba(255,255,255,.05);
  }
  .menu-button span { width: 18px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .2s, opacity .2s; }
  .menu-button.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-button.is-open span:nth-child(2) { opacity: 0; }
  .menu-button.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-panel {
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    padding: 14px 20px 24px;
    border-top: 1px solid rgba(255,255,255,.08);
    background: #0a1424;
  }
  .mobile-panel[hidden] { display: none; }

  .mobile-context {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 12px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 14px;
    background: rgba(255,255,255,.04);
  }
  .mobile-context div { padding: 8px; border-radius: 9px; background: rgba(255,255,255,.035); }
  .mobile-context span, .mobile-context strong { display: block; }
  .mobile-context span { color: rgba(255,255,255,.42); font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .mobile-context strong { margin-top: 4px; color: #fff; font-size: 14px; }
  .mobile-context p { grid-column: 1 / -1; margin: 3px 8px 0; color: rgba(255,255,255,.48); font-size: 11px; line-height: 1.5; }

  .mobile-nav { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .mobile-nav > a, .mobile-exchanges > summary {
    min-height: 48px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 11px;
    color: rgba(255,255,255,.82);
    background: rgba(255,255,255,.035);
    font-size: 14px;
    font-weight: 800;
    list-style: none;
  }
  .mobile-nav > a:hover, .mobile-nav > a:focus-visible,
  .mobile-exchanges > summary:hover, .mobile-exchanges > summary:focus-visible { border-color: rgba(247,147,26,.5); color: #fff; }
  .mobile-nav .mobile-primary { color: #13233e; border-color: #f7931a; background: #f7931a; }
  .mobile-exchanges > summary::-webkit-details-marker { display: none; }
  .mobile-exchanges[open] > summary span { transform: rotate(45deg); }
  .mobile-exchanges > summary span { font-size: 20px; font-weight: 500; transition: transform .15s; }
  .mobile-exchanges > div { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 8px 0 0; }
  .mobile-exchanges a { min-height: 40px; padding: 0 12px; display: flex; align-items: center; border-radius: 9px; color: rgba(255,255,255,.67); background: rgba(255,255,255,.03); font-size: 12px; font-weight: 700; }
  .mobile-exchanges a:hover, .mobile-exchanges a:focus-visible { color: #13233e; background: #f7931a; }

  @media (min-width: 620px) {
    .header-shell { padding: 0 24px; }
    .brand-copy small { display: block; }
    .context-chip { display: inline-flex; }
  }

  @media (min-width: 900px) {
    .header-shell { min-height: 72px; padding: 0 32px; }
    .brand-mark { width: 44px; height: 44px; flex-basis: 44px; }
    .brand-name { font-size: 20px; }
    .desktop-nav { display: flex; }
    .header-cta { display: inline-flex; }
    .menu-button, .mobile-panel { display: none !important; }
  }

  @media (max-width: 389px) {
    .brand-name { font-size: 15px; }
    .brand-mark { width: 36px; height: 36px; flex-basis: 36px; }
    .context-chip { display: none; }
  }
</style>
