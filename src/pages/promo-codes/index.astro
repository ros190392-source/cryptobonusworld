---
import CleanLayout from '../../layouts/CleanLayout.astro';
import PageFrame from '../../components/site-standard/PageFrame.astro';
import FirstViewport from '../../components/site-standard/FirstViewport.astro';
import Section from '../../components/site-standard/Section.astro';
import PromoCodeCopy from '../../components/promo/PromoCodeCopy.astro';
import { getFeaturedExchanges } from '../../data/exchanges';
import { getOffer } from '../../data/offers';
import { resolvePublicOfferView } from '../../data/publicOfferView';

const exchanges = getFeaturedExchanges();

const BEST_FOR: Record<string, string> = {
  bybit: 'Derivatives & spot trading',
  mexc: 'No-KYC altcoin trading',
  okx: 'Spot, futures & Web3',
  bitget: 'Copy trading',
  kucoin: 'No-KYC altcoin access',
  bingx: 'Copy & social trading',
};

const COUNTRY_NOTE: Record<string, string> = {
  bybit: 'Restricted in several countries (incl. US, UK, CA) — check terms',
  mexc: 'No KYC for base tier; restricted in several countries',
  okx: 'Restricted in several countries — check terms',
  bitget: 'Not available in US, UK, or CA — check terms',
  kucoin: 'No KYC for base tier; check regional terms',
  bingx: 'Available in most regions except the US — check terms',
};

// Public presentation is evidence-driven (Issue #264) against ONE explicit render clock
// (R5): Bybit renders neutralized while under re-verification (no code, neutral bonus
// text, no verified badge, non-commercial action); other exchanges pass through unchanged.
// Ordering uses the PUBLIC view state, never raw Offer.status (R7).
const nowMs = Date.now();
const rows = exchanges
  .map(exchange => ({ exchange, offer: getOffer(exchange.slug)!, view: resolvePublicOfferView(exchange.slug, nowMs)! }))
  .filter(row => row.offer && row.view)
  .sort((a, b) => {
    const bucket = (v: { publicState: string }) => (v.publicState === 'verified' ? 0 : 1);
    return bucket(a.view) - bucket(b.view);
  })
  .map((row, index) => ({ ...row, rank: index + 1 }));

const faqs = [
  {
    q: 'What is a crypto promo code?',
    a: 'A crypto promo code (also called a referral or bonus code) is entered during sign-up at an exchange to link your new account to a partner offer. Applying it can unlock a welcome bonus, fee discount, or other new-user reward.',
  },
  {
    q: 'Is a crypto exchange bonus guaranteed?',
    a: 'No. Advertised bonus figures are maximums, not typical results. Reaching them usually requires completing tasks such as KYC, a qualifying deposit, and trading volume milestones within a set window. Many users receive a partial reward.',
  },
  {
    q: 'Do I need to enter the code manually?',
    a: 'It depends on the exchange. Some referral links prefill the code automatically when you click through; others require you to paste it into a field during sign-up. Copy the code before clicking, just in case.',
  },
  {
    q: 'Why do offers differ by country?',
    a: 'Bonus programs are subject to local regulations, exchange licensing, and KYC requirements. An offer available in one country may be restricted or unavailable in another — always check the exchange’s terms for your region.',
  },
  {
    q: 'How do I check current country context?',
    a: 'Use the country and language context on the homepage and review the country-specific limitations shown on each exchange profile. Country-specific availability is still being verified, so always confirm eligibility against the exchange’s own terms.',
  },
  {
    q: 'Are these affiliate links?',
    a: 'Yes. Links marked “Check offer” are affiliate referral links. If you register through one, CryptoBonusWorld may earn a commission from the exchange. This does not cost you anything extra and does not change your bonus.',
  },
  {
    q: 'How often are codes checked?',
    a: 'We track each listed code and offer against the exchange’s own promotions page. Verified offers and listings under re-verification are shown separately, and where a code is currently shown its verification state is displayed. Listings under re-verification may temporarily hide the code and offer terms until they are re-checked.',
  },
  {
    q: 'Can a promo code expire?',
    a: 'Yes. Exchanges can change or discontinue a promo code or referral offer at any time, without notice. If a code on this page appears outdated, check the individual exchange page for the latest version.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<CleanLayout
  title="Crypto Promo Codes & Referral Codes by Country | CryptoBonusWorld"
  description="Compare tracked crypto exchange promo codes and their verification states, referral links, and sign-up bonus offers. Verified offers and listings under re-verification are shown separately; availability and terms may vary by country and account."
  canonical="https://cryptobonusworld.com/promo-codes/"
>
  <PageFrame family="directory" class="promo-directory-page">
    <FirstViewport
      family="directory"
      container="wide"
      eyebrow="Tracked codes & verification states · country and account terms vary"
      title="Crypto Promo Codes by Exchange"
      lede="Compare six tracked exchange codes, current offer snapshots, evidence status and regional limitations in one governed table."
    >
      <div class="promo-context">
        <span>6 tracked exchange rows</span>
        <span>Official-source checks</span>
        <a href="/#exchanges">Compare the homepage Top 10 →</a>
      </div>
    </FirstViewport>

    <Section container="wide" spacing="compact" tone="primary" id="ranking" class="promo-ranking-section">
      <header class="promo-heading">
        <div>
          <p class="promo-eyebrow">Current comparison</p>
          <h2>Crypto exchange promo-code ranking</h2>
          <p>Terms vary by exchange and account. Confirm current conditions on the official exchange page before signing up.</p>
        </div>
        <a href="/exchanges/">Browse exchange profiles →</a>
      </header>

      <div class="promo-table-wrap">
        <table class="promo-table" data-promo-table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Exchange</th>
              <th>Promo code</th>
              <th>Bonus snapshot</th>
              <th>Best for</th>
              <th>Country note</th>
              <th>Review</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ exchange, view, rank }) => (
              <tr class="promo-row" data-promo-row data-rank={rank} data-exchange-slug={exchange.slug}>
                <td data-label="Rank"><span class="promo-rank">#{rank}</span></td>
                <td data-label="Exchange">
                  <a href={exchange.pageUrl ?? `/${exchange.slug}/`} class="promo-exchange">{exchange.name}</a>
                  {view.showVerifiedBadge && <span class="promo-verified">✓ verified</span>}
                </td>
                <td data-label="Promo code" class="promo-code-cell">
                  {view.promoCode
                    ? <PromoCodeCopy code={view.promoCode} exchange={exchange.name} />
                    : <span class="promo-code-none">Not verified yet</span>}
                </td>
                <td data-label="Bonus snapshot" class="promo-copy">{view.bonusHeadline}</td>
                <td data-label="Best for" class="promo-best">{BEST_FOR[exchange.slug]}</td>
                <td data-label="Country note" class="promo-copy">{view.isCommercial ? COUNTRY_NOTE[exchange.slug] : 'Under re-verification — check the exchange directly'}</td>
                <td data-label="Review">
                  <a href={exchange.pageUrl ?? `/${exchange.slug}/`} class="promo-review">Read review →</a>
                </td>
                <td data-label="Action">
                  {view.isCommercial
                    ? <a href={`/go/${exchange.slug}/`} class="cbw-action promo-action" target="_blank" rel="noopener noreferrer sponsored">Check offer →</a>
                    : <a href={exchange.pageUrl ?? `/${exchange.slug}/`} class="cbw-action promo-action">View status →</a>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <Section container="prose" spacing="standard" tone="secondary">
      <p class="promo-eyebrow">Methodology</p>
      <h2>How this promo-code list works</h2>
      <p class="promo-prose">
        Verified offers appear ahead of records still in public-preview status. The current order also preserves the
        existing CryptoBonusWorld catalog sequence. Affiliate status does not create a verified record or improve its position.
      </p>
    </Section>

    <Section container="prose" spacing="standard" tone="primary">
      <p class="promo-eyebrow">Important</p>
      <h2>Why crypto bonuses differ by country</h2>
      <ul class="promo-list">
        <li>Exchanges may restrict access for residents of certain countries independently of any bonus offer.</li>
        <li>Identity verification rules and required documents can differ by region.</li>
        <li>Bonus campaigns may change or end without notice.</li>
        <li>Deposit minimums and trading-volume requirements can differ by account and reward tier.</li>
        <li>Some referral links prefill the code; others require manual entry during sign-up.</li>
      </ul>
    </Section>

    <Section container="prose" spacing="standard" tone="secondary" id="faq">
      <p class="promo-eyebrow">Common questions</p>
      <h2>Frequently asked questions</h2>
      <div class="promo-faq">
        {faqs.map(item => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </Section>

    <Section container="prose" spacing="compact" tone="page" class="promo-disclosure">
      <p>
        <strong>Disclosure:</strong> CryptoBonusWorld may earn a commission when you register through approved links.
        This does not affect editorial status or the codes listed. Advertised amounts are maximums and depend on meeting
        all exchange requirements. Verify current official terms before registering or depositing. Read the
        <a href="/affiliate-disclosure/">affiliate disclosure</a>.
      </p>
    </Section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </PageFrame>
</CleanLayout>

<style>
  .promo-directory-page { background: var(--cbw-surface-page); }
  :global(.promo-directory-page .cbw-first-viewport) {
    background: radial-gradient(circle at 84% 14%, rgba(247,147,26,.19), transparent 31%), linear-gradient(135deg,#091321,#13233e 70%,#1c355b);
  }
  :global(.promo-directory-page .cbw-first-viewport__inner) { padding-block: var(--cbw-space-6); }
  :global(.promo-directory-page .cbw-display-title) { max-width: var(--cbw-width-standard); font-size: clamp(42px,5vw,64px); }
  .promo-context { display: flex; flex-wrap: wrap; gap: 7px; margin-top: var(--cbw-space-4); }
  .promo-context span,
  .promo-context a { display: inline-flex; min-height: 28px; align-items: center; padding-inline: 10px; border: 1px solid rgba(255,255,255,.15); border-radius: var(--cbw-radius-pill); color: rgba(255,255,255,.75); background: rgba(255,255,255,.05); font-size: 9px; text-decoration: none; }
  .promo-context a { color: #ffd291; border-color: rgba(247,147,26,.34); background: rgba(247,147,26,.1); font-weight: 900; }
  .promo-heading { display: grid; gap: var(--cbw-space-4); align-items: end; margin-bottom: var(--cbw-space-5); }
  .promo-eyebrow { margin: 0 0 var(--cbw-space-2); color: var(--cbw-action); font-size: 9px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .promo-heading h2,
  .promo-directory-page :global(.cbw-section h2) { margin: 0; color: var(--cbw-text-primary); font-family: 'Barlow Condensed', Inter, sans-serif; font-size: clamp(30px,4.4vw,44px); font-weight: 800; line-height: 1; text-transform: uppercase; }
  .promo-heading p:last-child { max-width: var(--cbw-width-prose); margin: var(--cbw-space-2) 0 0; color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.55; }
  .promo-heading > a { color: #925204; font-size: 11px; font-weight: 900; text-decoration: none; }
  .promo-heading > a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .promo-table-wrap { overflow-x: auto; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: #fff; }
  .promo-table { width: 100%; min-width: 1060px; border-collapse: collapse; }
  .promo-table th,
  .promo-table td { padding: 10px 11px; border-bottom: 1px solid #edf0ec; color: var(--cbw-text-secondary); font-size: 10.5px; line-height: 1.45; text-align: left; vertical-align: middle; }
  .promo-table th { color: var(--cbw-text-muted); background: var(--cbw-surface-secondary); font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; white-space: nowrap; }
  .promo-table tr:last-child td { border-bottom: 0; }
  .promo-table tbody tr:hover { background: #fbfcfa; }
  .promo-rank { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; border-radius: var(--cbw-radius-pill); color: var(--cbw-text-primary); background: var(--cbw-action); font-size: 10px; font-weight: 900; }
  .promo-exchange { display: block; color: var(--cbw-text-primary); font-size: 12px; font-weight: 900; text-decoration: none; }
  .promo-exchange:hover { color: #a65400; }
  .promo-verified { color: var(--cbw-evidence); font-size: 8px; font-weight: 900; }
  .promo-code-cell { min-width: 190px; }
  .promo-code-cell :global(.pcc-row) { max-width: 210px; height: 38px; }
  .promo-copy { max-width: 190px; }
  .promo-best { min-width: 132px; color: var(--cbw-text-primary); font-weight: 800; }
  .promo-review { color: var(--cbw-text-secondary); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .promo-review:hover { color: var(--cbw-text-primary); text-decoration: underline; text-underline-offset: 2px; }
  .promo-action { min-height: 40px; padding-inline: 13px; font-size: 10px; white-space: nowrap; }
  .promo-prose { margin: var(--cbw-space-5) 0 0; color: var(--cbw-text-secondary); font-size: 14px; line-height: 1.75; }
  .promo-list { display: grid; gap: var(--cbw-space-3); margin: var(--cbw-space-5) 0 0; padding-left: 20px; color: var(--cbw-text-secondary); font-size: 14px; line-height: 1.65; }
  .promo-list li::marker { color: var(--cbw-action); }
  .promo-faq { display: grid; gap: var(--cbw-space-2); margin-top: var(--cbw-space-5); }
  .promo-faq details { overflow: hidden; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-control); background: #fff; }
  .promo-faq summary { display: flex; justify-content: space-between; gap: var(--cbw-space-4); padding: var(--cbw-space-4) var(--cbw-space-5); color: var(--cbw-text-primary); font-size: 13px; font-weight: 800; cursor: pointer; list-style: none; }
  .promo-faq summary::-webkit-details-marker { display: none; }
  .promo-faq summary::after { content: '+'; color: #9ca3af; font-size: 18px; }
  .promo-faq details[open] summary::after { content: '−'; }
  .promo-faq p { margin: 0; padding: 0 var(--cbw-space-5) var(--cbw-space-4); color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.7; }
  .promo-disclosure p { margin: 0; color: var(--cbw-text-secondary); font-size: 11px; line-height: 1.7; }
  .promo-disclosure strong { color: var(--cbw-text-primary); }
  .promo-disclosure a { color: #166534; font-weight: 800; }
  @media (min-width: 760px) { .promo-heading { grid-template-columns: minmax(0,1fr) auto; } }
  @media (max-width: 760px) {
    .promo-table { min-width: 0; }
    .promo-table thead { display: none; }
    .promo-table,
    .promo-table tbody,
    .promo-table tr,
    .promo-table td { display: block; width: 100%; box-sizing: border-box; }
    .promo-table-wrap { overflow: visible; border: 0; background: transparent; }
    .promo-table tr { margin-bottom: var(--cbw-space-3); padding: var(--cbw-space-4); border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: #fff; box-shadow: 0 5px 18px rgba(19,35,62,.05); }
    .promo-table td { display: flex; justify-content: space-between; gap: var(--cbw-space-3); padding: 6px 0; border: 0; }
    .promo-table td::before { content: attr(data-label); flex: 0 0 104px; color: var(--cbw-text-muted); font-size: 8px; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
    .promo-code-cell { flex-direction: column; align-items: stretch; }
    .promo-code-cell::before { margin-bottom: 3px; }
    .promo-code-cell :global(.pcc-row) { width: 100%; max-width: none; }
    .promo-copy { max-width: 62%; text-align: right; }
    .promo-action { width: 100%; }
  }
  @media (max-width: 620px) {
    :global(.promo-directory-page .cbw-first-viewport__inner) { padding-block: var(--cbw-space-5); }
    :global(.promo-directory-page .cbw-display-title) { font-size: 42px; }
    .promo-context { margin-top: var(--cbw-space-3); gap: 5px; }
    .promo-context span,
    .promo-context a { min-height: 25px; padding-inline: 8px; font-size: 8px; }
  }
</style>
