---
import CleanLayout from '../../../layouts/CleanLayout.astro';
import { runSiteStandardAuditRefined } from '../../../../scripts/audits/site-standard-audit-refined.mjs';

export function getStaticPaths() {
  return [{ params: { designRoot: '__design' } }];
}

const audit = await runSiteStandardAuditRefined();
const familyCounts = Object.entries(audit.routeFamilyCounts).sort((a, b) => b[1] - a[1]);
const widthCounts = Object.entries(audit.maxWidthValueCounts).sort((a, b) => b[1] - a[1]).slice(0, 20);
const nonCanonical = audit.nonCanonicalContainerLikeDeclarations
  .slice()
  .sort((a, b) => (b.px ?? 0) - (a.px ?? 0) || a.path.localeCompare(b.path))
  .slice(0, 30);
const localStylePages = audit.localStylePages.slice().sort((a, b) => b.blocks - a.blocks).slice(0, 24);
const widths = Object.entries(audit.canonicalProposal.widths);
const inventoryPass = audit.summary.unclassifiedPublicPageSources === 0;
---

<CleanLayout
  title="Site Standard Audit 053A | CryptoBonusWorld"
  description="Review-only route-family, container-width and first-screen standardization audit."
  noindex={true}
>
  <section class="audit-hero">
    <div class="audit-wrap">
      <p class="audit-eyebrow">P0 review only · no production authority</p>
      <h1>One site. One governed system.</h1>
      <p class="audit-lead">
        Refined inventory of public page families, true CSS max-width declarations, local style systems
        and migration pressure. Media-query breakpoints and small component widths are separated from page containers.
      </p>
      <div class:list={['audit-state', { pass: inventoryPass }]}> 
        <strong>{inventoryPass ? 'ROUTES CLASSIFIED' : 'ROUTES BLOCKED'}</strong>
        <span>{audit.summary.publicPageSourceFiles} public sources · {audit.summary.routeFamilies} families · {audit.summary.unclassifiedPublicPageSources} unclassified</span>
      </div>
    </div>
  </section>

  <section class="audit-main">
    <div class="audit-wrap audit-stack">
      <section class="metric-grid" aria-label="Audit metrics">
        <article><span>Actual max-width</span><strong>{audit.summary.actualCssMaxWidthDeclarations}</strong><small>{audit.summary.distinctActualCssMaxWidthValues} distinct values</small></article>
        <article><span>Page-local widths</span><strong>{audit.summary.pageLocalMaxWidthDeclarations}</strong><small>Inside page source files</small></article>
        <article><span>Container-like</span><strong>{audit.summary.containerLikeWidthDeclarations}</strong><small>{audit.summary.nonCanonicalContainerLikeDeclarations} require migration/exception</small></article>
        <article><span>Local style pages</span><strong>{audit.summary.pagesWithLocalStyleBlocks}</strong><small>{audit.summary.totalLocalStyleBlocksInPages} embedded style blocks</small></article>
      </section>

      <section class="audit-panel">
        <header><p>Foundation proposal</p><h2>Canonical container model</h2></header>
        <div class="width-grid">
          {widths.map(([name, value]) => <article><span>{name}</span><strong>{value}</strong></article>)}
        </div>
        <p class="audit-note">Gutters: 20 px mobile · 24 px tablet · 32 px desktop. No page-local container width without a documented exception.</p>
      </section>

      <section class="audit-panel">
        <header><p>Refined source scan</p><h2>Most common actual max-width values</h2></header>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Value</th><th>Count</th><th>Classification</th></tr></thead>
            <tbody>
              {widthCounts.map(([value, count]) => (
                <tr><td><code>{value}</code></td><td>{count}</td><td>{Object.values(audit.canonicalProposal.widths).includes(value) ? 'Canonical candidate' : 'Component, migrate or exception'}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="audit-panel">
        <header><p>Migration pressure</p><h2>Non-canonical container-like declarations</h2></header>
        <div class="route-list">
          {nonCanonical.map(item => (
            <article class="route-row">
              <div><strong>{item.value}</strong><small>{item.path}</small></div>
              <div><span>{item.kind}</span><b>{item.px ?? 'token'}{item.px !== null ? ' px' : ''}</b></div>
            </article>
          ))}
        </div>
      </section>

      <section class="audit-panel">
        <header><p>Route architecture</p><h2>Canonical page-family candidates</h2></header>
        <div class="family-grid">
          {familyCounts.map(([family, count]) => <article><strong>{family}</strong><span>{count} source routes</span></article>)}
        </div>
      </section>

      <section class="audit-panel">
        <header><p>Legacy ownership</p><h2>Pages with embedded style systems</h2></header>
        <div class="route-list">
          {localStylePages.map(page => (
            <article class="route-row">
              <div><strong>{page.route}</strong><small>{page.path}</small></div>
              <div><span>{page.family}</span><b>{page.blocks} block{page.blocks === 1 ? '' : 's'}</b></div>
            </article>
          ))}
        </div>
      </section>

      <section class="audit-panel">
        <header><p>Owner freeze target</p><h2>First-screen contracts</h2></header>
        <div class="contract-grid">
          <article><h3>Homepage desktop</h3><p>Header, compact market context, ranking heading and at least three complete real rows inside 1440×900. Target five.</p></article>
          <article><h3>Homepage mobile</h3><p>Compact header/context/hero, ranking heading and the beginning of the first real card inside 390×844.</p></article>
          <article><h3>Exchange detail</h3><p>Identity, evidence/offer state, authorized action, material limitation and first useful facts in the first viewport.</p></article>
          <article><h3>Other families</h3><p>Page purpose, trust context and first useful content without oversized decorative stages.</p></article>
        </div>
      </section>

      <aside class="audit-boundary">
        <strong>Authorization boundary</strong>
        <p>This route changes no ranking, offer, promo code, affiliate destination, GEO/locale activation, public indexability or deployment state.</p>
      </aside>
    </div>
  </section>
</CleanLayout>

<style>
  .audit-wrap { width: min(100%, 1180px); margin-inline: auto; padding-inline: 20px; box-sizing: border-box; }
  .audit-hero { padding: 48px 0 38px; color: #fff; background: radial-gradient(circle at 86% 12%, rgba(247,147,26,.18), transparent 30%), #0a1424; }
  .audit-eyebrow, .audit-panel header p { margin: 0 0 8px; color: #f7a93f; font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .audit-hero h1 { margin: 0 0 12px; max-width: 900px; font: 800 clamp(44px, 7vw, 72px)/.95 'Barlow Condensed','Inter',sans-serif; text-transform: uppercase; }
  .audit-lead { max-width: 760px; margin: 0; color: rgba(255,255,255,.72); line-height: 1.68; }
  .audit-state { display: inline-flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 20px; padding: 10px 14px; border: 1px solid rgba(220,90,90,.3); border-radius: 11px; color: #ffd2d2; background: rgba(150,30,30,.12); }
  .audit-state.pass { color: #a8efc1; border-color: rgba(80,200,125,.32); background: rgba(32,130,72,.13); }
  .audit-state span { color: rgba(255,255,255,.62); font-size: 12px; }
  .audit-main { padding: 30px 0 68px; background: #f7f8f4; }
  .audit-stack { display: grid; gap: 16px; }
  .metric-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; }
  .metric-grid article, .audit-panel, .audit-boundary { border: 1px solid #dce3dc; border-radius: 16px; background: #fff; box-shadow: 0 8px 26px rgba(19,35,62,.05); }
  .metric-grid article { padding: 18px; }
  .metric-grid span { color: #728093; font-size: 9px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .metric-grid strong { display: block; margin: 5px 0 2px; color: #13233e; font: 800 34px/1 'Barlow Condensed','Inter',sans-serif; }
  .metric-grid small { color: #7a8795; font-size: 10px; }
  .audit-panel { padding: 24px; }
  .audit-panel h2 { margin: 0 0 17px; color: #13233e; font: 800 clamp(29px,4vw,41px)/1 'Barlow Condensed','Inter',sans-serif; text-transform: uppercase; }
  .width-grid { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 9px; }
  .width-grid article, .family-grid article, .contract-grid article { padding: 14px; border: 1px solid #e1e6e0; border-radius: 11px; background: #f8faf7; }
  .width-grid span { color: #758293; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .width-grid strong { display: block; margin-top: 4px; color: #13233e; }
  .audit-note { margin: 13px 0 0; color: #5a687b; font-size: 12px; }
  .table-wrap { overflow-x: auto; border: 1px solid #e0e5df; border-radius: 12px; }
  table { width: 100%; min-width: 620px; border-collapse: collapse; }
  th, td { padding: 10px 12px; border-bottom: 1px solid #edf0ec; text-align: left; }
  th { color: #6e7b8b; background: #eef2ed; font-size: 9px; text-transform: uppercase; }
  td { color: #46566a; font-size: 12px; }
  tr:last-child td { border-bottom: 0; }
  code { color: #13233e; font-weight: 800; }
  .route-list { display: grid; gap: 7px; }
  .route-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 11px 13px; border: 1px solid #e5e9e4; border-radius: 10px; background: #fafbf9; }
  .route-row strong { display: block; color: #13233e; font-size: 12px; }
  .route-row small { display: block; margin-top: 2px; color: #8893a0; font-size: 9px; }
  .route-row > div:last-child { text-align: right; }
  .route-row span { display: block; color: #7c8896; font-size: 9px; }
  .route-row b { color: #a65400; font-size: 10px; }
  .family-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 9px; }
  .family-grid strong { display: block; color: #13233e; font-size: 12px; }
  .family-grid span { color: #748192; font-size: 10px; }
  .contract-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
  .contract-grid h3 { margin: 0 0 6px; color: #13233e; font-size: 13px; }
  .contract-grid p { margin: 0; color: #58677a; font-size: 12px; line-height: 1.6; }
  .audit-boundary { padding: 18px; border-left: 5px solid #f7931a; }
  .audit-boundary strong { color: #13233e; }
  .audit-boundary p { margin: 4px 0 0; color: #5b697b; font-size: 12px; }
  @media (min-width: 760px) { .audit-wrap { padding-inline: 32px; } }
  @media (max-width: 900px) { .metric-grid, .family-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .width-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media (max-width: 620px) { .metric-grid, .family-grid, .width-grid, .contract-grid { grid-template-columns: 1fr; } .audit-panel { padding: 18px; } .route-row { align-items: flex-start; flex-direction: column; } .route-row > div:last-child { text-align: left; } }
</style>
