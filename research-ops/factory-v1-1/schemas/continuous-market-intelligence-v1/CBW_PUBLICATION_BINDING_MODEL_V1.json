{
  "schemaVersion": "1.0.0",
  "modelId": "CBW_PUBLICATION_BINDING_MODEL_V1",
  "title": "CBW Publication Binding Model V1",
  "status": "ARCHITECTURE_DRAFT_FOR_OWNER_APPROVAL",
  "auditCorrection": "Owner Audit Correction 026: suppression distinguishes freshness (STALE/EXPIRED) from claim-verification (UNDER_REVIEW/UNSUPPORTED/CONFLICTED); offer status maps to safe public surfaces via the corrected offer/CTA vocabularies.",
  "description": "Binds canonical claims to presentation surfaces and governs preview -> QA -> owner-review -> publish -> live-verify -> rollback. Architecture model only; no real routes are published.",
  "canonicalEnums": {
    "publicationState": ["UNBOUND", "BOUND", "PREVIEW", "QA", "OWNER_REVIEW", "PUBLISHED", "SUPPRESSED", "ROLLED_BACK"],
    "impactStatus": ["NO_IMPACT", "IMPACTED_MINOR", "IMPACTED_MAJOR", "IMPACTED_CRITICAL"],
    "ctaState": ["ENABLED", "DISABLED", "UNDER_REVIEW", "GEO_SUPPRESSED", "FAILSAFE_SUPPRESSED"],
    "affiliateOfferStatus": ["ACTIVE_VERIFIED", "ACTIVE_LIMITED", "UNDER_REVIEW", "CODE_NOT_APPLIED", "GEO_NOT_ELIGIBLE", "LINK_BROKEN", "OFFER_ENDED", "SOURCE_UNAVAILABLE", "CONFLICTED"],
    "freshnessState": ["FRESH", "DUE_SOON", "STALE", "EXPIRED"],
    "claimVerificationState": ["SUPPORTED", "CONFLICTED", "UNDER_REVIEW", "UNSUPPORTED"]
  },
  "entities": {
    "PublicationBinding": {
      "primaryKey": "bindingId",
      "fields": {"bindingId": "example id", "claimId": "Claim.claimId", "surfaceType": "one of [ROUTE, PAGE, BLOCK, RANKING_CARD, ANSWER_BLOCK, COMPARISON_TABLE, FAQ, TITLE_META, STRUCTURED_DATA, AFFILIATE_CTA]", "route": "e.g. /kz/binance", "pageId": "string", "blockId": "string", "rankingCardId": "string or null", "answerBlockId": "string or null", "comparisonTableId": "string or null", "faqId": "string or null", "titleMetaId": "string or null", "structuredDataId": "string or null", "affiliateCtaId": "AffiliateCampaign CTA reference or null", "publicationState": "one of canonicalEnums.publicationState", "requiresOwnerGate": "boolean"},
      "invariants": ["a binding to RANKING_CARD, AFFILIATE_CTA, STRUCTURED_DATA or TITLE_META MUST set requiresOwnerGate = true"]
    },
    "SuppressionRule": {
      "primaryKey": "suppressionRuleId",
      "fields": {"bindingId": "PublicationBinding.bindingId", "trigger": "one of [FRESHNESS_STALE, FRESHNESS_EXPIRED, VERIFICATION_UNDER_REVIEW, VERIFICATION_UNSUPPORTED, VERIFICATION_CONFLICTED, OFFER_STATUS]", "resultingState": "one of canonicalEnums.publicationState or one of canonicalEnums.ctaState"},
      "invariants": ["freshness triggers and verification triggers are independent; a binding may be suppressed by either dimension"]
    },
    "ImpactRecord": {"primaryKey": "impactRecordId", "fields": {"bindingId": "PublicationBinding.bindingId", "changeEventId": "ChangeEvent.changeEventId", "impactStatus": "one of canonicalEnums.impactStatus", "assessedAt": "timestamp"}},
    "PatchProposal": {"primaryKey": "patchProposalId", "fields": {"bindingId": "PublicationBinding.bindingId", "changeType": "one of [SEMANTIC, FORMATTING]", "lane": "one of [GREEN, AMBER, RED]", "diffSummary": "string", "generatedAt": "timestamp", "generatedBy": "agent id"}, "invariants": ["a SEMANTIC change to a critical binding MUST be lane RED and owner-gated"]},
    "PreviewArtifact": {"primaryKey": "previewId", "fields": {"patchProposalId": "PatchProposal.patchProposalId", "previewObjectKey": "non-production preview render key", "createdAt": "timestamp"}},
    "ValidationRecord": {"primaryKey": "validationRecordId", "fields": {"previewId": "PreviewArtifact.previewId", "qaVerdict": "one of [PASS, FAIL, NEEDS_OWNER]", "checks": "array of check ids", "validatedAt": "timestamp"}},
    "PublicationVersion": {"primaryKey": "publicationVersionId", "fields": {"bindingId": "PublicationBinding.bindingId", "sourcePatchProposalId": "PatchProposal.patchProposalId", "ownerApproved": "boolean", "publishedAt": "timestamp or null", "publicationState": "one of canonicalEnums.publicationState"}, "invariants": ["publishedAt is non-null only after ownerApproved is true for owner-gated bindings"]},
    "LiveVerificationRef": {"primaryKey": "liveVerificationId", "fields": {"publicationVersionId": "PublicationVersion.publicationVersionId", "outcome": "one of [MATCH, MISMATCH, ERROR]", "verifiedAt": "timestamp"}},
    "RollbackRef": {"primaryKey": "rollbackId", "fields": {"publicationVersionId": "PublicationVersion.publicationVersionId", "toPublicationVersionId": "PublicationVersion.publicationVersionId", "reason": "string", "rolledBackAt": "timestamp"}}
  },
  "offerStatusToSafePublicSurface": [
    {"offerStatus": "ACTIVE_VERIFIED", "surface": "CTA enabled (owner-gated) + offer block shown"},
    {"offerStatus": "ACTIVE_LIMITED", "surface": "offer block shown with 'check conditions'; CTA owner-gated"},
    {"offerStatus": "UNDER_REVIEW", "surface": "offer block shown as under review; CTA UNDER_REVIEW"},
    {"offerStatus": "CODE_NOT_APPLIED", "surface": "offer block flagged; CTA UNDER_REVIEW until owner review"},
    {"offerStatus": "GEO_NOT_ELIGIBLE", "surface": "GEO notice; CTA GEO_SUPPRESSED"},
    {"offerStatus": "LINK_BROKEN", "surface": "offer hidden; CTA FAILSAFE_SUPPRESSED"},
    {"offerStatus": "OFFER_ENDED", "surface": "offer hidden; CTA DISABLED"},
    {"offerStatus": "SOURCE_UNAVAILABLE", "surface": "last-known with under-review notice; CTA UNDER_REVIEW"},
    {"offerStatus": "CONFLICTED", "surface": "offer hidden; CTA DISABLED pending resolution"}
  ],
  "lifecycle": ["UNBOUND", "BOUND", "PREVIEW", "QA", "OWNER_REVIEW", "PUBLISHED", "ROLLED_BACK or SUPPRESSED"],
  "ownerGatedSurfaces": ["RANKING_CARD", "AFFILIATE_CTA", "STRUCTURED_DATA", "TITLE_META"],
  "crossReferences": ["./CBW_CLAIM_EVIDENCE_FRESHNESS_MODEL_V1.json", "./CBW_CHANGE_EVENT_AND_IMPACT_MODEL_V1.json", "../../templates/continuous-market-intelligence-v1/CBW_AUTONOMOUS_CONTENT_UPDATE_POLICY_V1.md", "../../templates/continuous-market-intelligence-v1/CBW_SEO_QUICK_ANSWER_AND_SEARCH_INTENT_STANDARD_V1.md"]
}
