---
import type { Exchange } from '../../data/exchanges';
import type { Offer } from '../../data/offers';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';
import ExchangeLogo from '../ExchangeLogo.astro';

export interface Props {
  exchange: Exchange;
  offer?: Offer;
}

const { exchange: ex, offer } = Astro.props;
const reviewUrl = ex.pageUrl ?? `/exchanges/${ex.slug}/`;
---

<article class="ec">
  <div class="ec-head">
    <a href={reviewUrl} class="ec-logo-link" tabindex="-1" aria-label={`${ex.name} review`}>
      <ExchangeLogo slug={ex.slug} name={ex.name} size={96} variant="square" lazy={false} class="ec-logo" />
    </a>
    <a href={reviewUrl} class="ec-name">{ex.name}</a>
    {offer?.status === 'verified' && <span class="ec-verified">✓ Verified offer</span>}
  </div>

  {offer && <p class="ec-bonus">{offer.bonusHeadline}</p>}

  {offer && (
    <div class="ec-code-band">
      <span class="ec-code-label">Promo code</span>
      <PromoCodeCopy code={offer.promoCode} exchange={ex.name} />
    </div>
  )}

  <a href={ex.affiliateUrl} class="ec-cta" target="_blank" rel="noopener noreferrer sponsored">Claim Bonus →</a>
  <a href={reviewUrl} class="ec-review-link">Read {ex.name} review</a>
</article>

<style>
  .ec {
    min-width: 0;
    min-height: 100%;
    padding: 24px 20px 19px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid #dce3dc;
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 10px 28px rgba(19,35,62,.065);
    text-align: center;
    transition: box-shadow .18s, transform .18s, border-color .18s;
  }
  .ec:hover {
    border-color: rgba(247,147,26,.38);
    box-shadow: 0 18px 42px rgba(19,35,62,.11);
    transform: translateY(-3px);
  }

  .ec-head { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 9px; }
  .ec-logo-link {
    display: inline-flex;
    border-radius: 22px;
    line-height: 0;
  }
  .ec-logo-link:focus-visible { outline: 3px solid rgba(247,147,26,.55); outline-offset: 4px; }
  .ec-logo-link :global(.ec-logo) {
    border: 1px solid rgba(19,35,62,.08);
    border-radius: 21px;
    box-shadow: 0 5px 18px rgba(19,35,62,.09);
  }

  .ec-name {
    display: block;
    color: #13233e;
    font-family: 'Barlow Condensed', 'Inter', sans-serif;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -.015em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }
  .ec-name:hover, .ec-name:focus-visible { color: #b45f00; }

  .ec-verified {
    padding: 3px 10px;
    border: 1px solid #b7dfc7;
    border-radius: 999px;
    color: #16834b;
    background: #f1fbf5;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .035em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .ec-bonus {
    min-height: 44px;
    margin: 16px 0 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #45556a;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.55;
  }

  .ec-code-band {
    width: 100%;
    margin-bottom: 17px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .ec-code-label {
    color: #7a8795;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ec-cta {
    width: 100%;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(19,35,62,.12);
    border-radius: 11px;
    color: #13233e;
    background: #f7931a;
    box-shadow: 0 9px 22px rgba(247,147,26,.2);
    font-size: 14px;
    font-weight: 900;
    text-decoration: none;
    transition: background .15s, box-shadow .15s, transform .15s;
  }
  .ec-cta:hover, .ec-cta:focus-visible {
    color: #13233e;
    background: #ffad3d;
    box-shadow: 0 12px 28px rgba(247,147,26,.26);
    transform: translateY(-1px);
  }

  .ec-review-link {
    padding: 10px 0 1px;
    display: block;
    color: #647386;
    font-size: 12px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }
  .ec-review-link:hover, .ec-review-link:focus-visible { color: #13233e; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 480px) {
    .ec { padding-inline: 18px; }
    .ec-logo-link :global(.exlogo),
    .ec-logo-link :global(.exlogo-img) { width: 72px !important; height: 72px !important; }
  }
</style>
