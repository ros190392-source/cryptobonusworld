---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ReviewStatus from '../../../../components/portal-v2/ReviewStatus.astro';
import { portalFactoryOwnerFreeze } from '../../../../data/portalFactoryFreeze';
---

<CleanLayout
  title="CBW Portal Factory v2 — Owner Freeze 051J"
  description="Review-only design, data and route freeze for controlled CryptoBonusWorld implementation."
  noindex={true}
  bodyClass="cbw-v2-freeze"
>
  <main class="freeze-page">
    <section class="hero">
      <div class="shell">
        <div class="review-nav">
          <span>Owner freeze · review only · no public authority</span>
          <nav aria-label="Portal v2 review routes">
            <a href="/__design/cbw-v2/homepage/">Homepage</a>
            <a href="/__design/cbw-v2/content-packages/">Content packages</a>
            <a href="/__design/cbw-v2/contracts/">Contracts</a>
          </nav>
        </div>

        <p class="eyebrow">Portal Factory v2 owner freeze</p>
        <h1>Foundation accepted. Production split required.</h1>
        <p class="lede">
          The design system, page family and evidence contracts are frozen as the implementation foundation. The current all-in-one draft cannot be merged or deployed; every public effect requires a smaller controlled PR and a separate owner gate.
        </p>

        <div class="hero-grid">
          <div><span>Freeze status</span><strong>FROZEN</strong></div>
          <div><span>Future route shapes</span><strong>{portalFactoryOwnerFreeze.routes.length}</strong></div>
          <div><span>Controlled workstreams</span><strong>{portalFactoryOwnerFreeze.workstreams.length}</strong></div>
          <div><span>Public authorizations</span><strong>0</strong></div>
        </div>
      </div>
    </section>

    <section class="content">
      <div class="shell">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Accepted foundation</p>
            <h2>What is frozen for implementation</h2>
          </div>
          <ReviewStatus label="Review foundation accepted" detail="Public activation remains false." tone="verified" />
        </header>

        <div class="foundation-grid">
          {Object.entries(portalFactoryOwnerFreeze.acceptedFoundation).map(([key]) => (
            <article><span>✓</span><strong>{key.replace(/([A-Z])/g, ' $1')}</strong></article>
          ))}
        </div>

        <section class="route-section">
          <header>
            <div><p class="eyebrow">Future route contract</p><h2>Shapes frozen, routes not activated</h2></div>
            <ReviewStatus label="Indexability gated" detail="Only the existing homepage is preserved." tone="review" compact={true} />
          </header>
          <div class="route-list">
            {portalFactoryOwnerFreeze.routes.map(route => (
              <article class="route-row" data-route-id={route.routeId}>
                <div><code>{route.routeShape}</code><span>{route.currentState}</span></div>
                <dl>
                  <div><dt>Indexable</dt><dd>{route.indexabilityAuthorized ? 'existing only' : 'no'}</dd></div>
                  <div><dt>Ranking rows</dt><dd>no</dd></div>
                  <div><dt>Affiliate CTA</dt><dd>no</dd></div>
                </dl>
                <p>{route.nextAuthorization}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="split-section">
          <header><p class="eyebrow">Controlled public split</p><h2>Six independent workstreams</h2></header>
          <div class="workstream-grid">
            {portalFactoryOwnerFreeze.workstreams.map(item => (
              <article data-workstream-id={item.workstreamId}>
                <span>{String(item.order).padStart(2, '0')}</span>
                <h3>{item.title}</h3>
                <ul>{item.scope.map(scope => <li>{scope}</li>)}</ul>
                <footer>Production effect: off · Deploy: off</footer>
              </article>
            ))}
          </div>
        </section>

        <section class="boundary">
          <div><p class="eyebrow">Hard boundary</p><h2>PR #139 stays draft</h2><p>The current branch is a validated design and governance laboratory. It is not the production delivery unit.</p></div>
          <div class="flags">
            <span>currentDraftMergeAuthorized = false</span>
            <span>publicImplementationAuthorized = false</span>
            <span>rankingPublicationAuthorized = false</span>
            <span>affiliateActivationAuthorized = false</span>
            <span>deployAuthorized = false</span>
          </div>
        </section>
      </div>
    </section>
  </main>
</CleanLayout>

<style>
  :global(body.cbw-v2-freeze) { background: #f7f8f4; }
  .freeze-page { min-height: 100vh; color: #13233e; background: #f7f8f4; }
  .shell { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
  .hero { padding: 18px 0 60px; color: #fff; background: radial-gradient(circle at 82% 13%, rgba(247,147,26,.22), transparent 27%), linear-gradient(135deg,#0c1729,#19375a); }
  .review-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 10px 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; color: #c7d2e1; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .review-nav nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .review-nav a { color: #f7b75e; }
  .eyebrow { margin: 32px 0 10px; color: #f7931a; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: -.025em; }
  h1 { max-width: 950px; margin: 0; font-size: clamp(48px,8vw,82px); line-height: .92; }
  .lede { max-width: 850px; margin: 22px 0 0; color: #d2ddea; font-size: 16px; line-height: 1.7; }
  .hero-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin-top: 28px; }
  .hero-grid div { padding: 14px; border: 1px solid rgba(255,255,255,.14); border-radius: 11px; background: rgba(255,255,255,.07); }
  .hero-grid span, .hero-grid strong { display: block; }
  .hero-grid span { color: #b8c7d8; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .hero-grid strong { margin-top: 5px; font-size: 21px; }
  .content { padding: 70px 0 90px; }
  .section-heading, .route-section > header { display: grid; gap: 18px; align-items: end; }
  .section-heading .eyebrow, .route-section .eyebrow, .split-section .eyebrow, .boundary .eyebrow { margin-top: 0; }
  h2 { margin: 0; font-size: clamp(36px,5vw,54px); line-height: .96; }
  .foundation-grid { display: grid; gap: 10px; margin-top: 24px; }
  .foundation-grid article { display: flex; gap: 10px; align-items: center; padding: 14px; border: 1px solid #dce2dc; border-radius: 11px; background: #fff; }
  .foundation-grid span { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 8px; background: #16834b; color: #fff; }
  .foundation-grid strong { text-transform: capitalize; }
  .route-section, .split-section { margin-top: 58px; }
  .route-list { display: grid; gap: 10px; margin-top: 22px; }
  .route-row { display: grid; gap: 13px; padding: 18px; border: 1px solid #dce2dc; border-radius: 13px; background: #fff; }
  .route-row code { display: block; color: #925204; font-weight: 900; overflow-wrap: anywhere; }
  .route-row > div > span { display: block; margin-top: 5px; color: #74808e; font-size: 9px; text-transform: uppercase; }
  .route-row dl { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; margin: 0; }
  .route-row dl div { padding: 9px; border-radius: 8px; background: #f3f5f2; }
  dt { color: #74808e; font-size: 8px; text-transform: uppercase; }
  dd { margin: 4px 0 0; font-size: 10px; font-weight: 900; }
  .route-row p { margin: 0; color: #647080; font-size: 11px; line-height: 1.55; }
  .workstream-grid { display: grid; gap: 13px; margin-top: 22px; }
  .workstream-grid article { padding: 18px; border: 1px solid #dce2dc; border-radius: 13px; background: #fff; }
  .workstream-grid article > span { color: #f7931a; font-size: 10px; font-weight: 900; }
  .workstream-grid h3 { margin: 8px 0 0; font-size: 19px; }
  .workstream-grid ul { display: grid; gap: 7px; padding-left: 18px; color: #647080; font-size: 11px; line-height: 1.5; }
  .workstream-grid footer { margin-top: 13px; padding-top: 10px; border-top: 1px solid #e5e9e4; color: #8a4d00; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .boundary { display: grid; gap: 20px; margin-top: 58px; padding: 25px; border-radius: 16px; color: #fff; background: #13233e; }
  .boundary p:last-child { color: #bdc9d8; line-height: 1.6; }
  .flags { display: grid; gap: 8px; }
  .flags span { padding: 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 9px; color: #f7b75e; font-family: monospace; font-size: 9px; overflow-wrap: anywhere; }
  @media (min-width: 720px) {
    .hero-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .section-heading, .route-section > header { grid-template-columns: minmax(0,1fr) auto; }
    .foundation-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .route-row { grid-template-columns: 1fr .8fr 1.4fr; align-items: center; }
    .workstream-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .boundary { grid-template-columns: 1.1fr .9fr; align-items: center; }
  }
  @media (min-width: 1000px) { .foundation-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
</style>
