---
import type { ExchangePromoPageConfig, VerificationStatus } from '../../data/exchangePages/types';
import PageFrame from '../site-standard/PageFrame.astro';
import Container from '../site-standard/Container.astro';
import Section from '../site-standard/Section.astro';
import ActiveCountryContext from '../site-standard/ActiveCountryContext.astro';
import StatusBadge from '../site-standard/StatusBadge.astro';
import FAQList from '../site-standard/FAQList.astro';
import ExchangePromoLogoSlot from '../ExchangePromoLogoSlot.astro';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';
import { resolvePublicOfferView } from '../../data/publicOfferView';

export interface Props {
  config: ExchangePromoPageConfig;
  /** Governed internal /go/<slug>/ hop supplied by GovernedExchangePage. */
  commercialHref: string;
  /** Separately owner-confirmed code; null means do not publish a code. */
  confirmedPromoCode?: string | null;
}

const { config: c, commercialHref, confirmedPromoCode = null } = Astro.props;
const bonusMaxFmt = c.bonusMax.toLocaleString('en-US');
const nowMs = Date.now();

const statusLabel = (status: VerificationStatus) => {
  if (status === 'verified') return 'Verified';
  if (status === 'public-preview') return 'Public preview';
  return `Check in ${c.rewardsAreaName}`;
};

const faqGroups = [{
  title: `${c.name} questions`,
  items: c.faqItems.map(item => ({ q: item.question, a: item.answer })),
}];

const relatedTiles = c.relatedExchanges.map((exchange) => {
  const view = resolvePublicOfferView(exchange.slug, nowMs);
  return {
    ...exchange,
    status: view?.showVerifiedBadge ? 'Verified offer' : (view?.statusLabel ?? 'Under review'),
    tone: view?.showVerifiedBadge ? 'verified' : 'review',
    href: exchange.pageUrl ?? `/${exchange.slug}/`,
  } as const;
});

const faqSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cryptobonusworld.com/' },
        { '@type': 'ListItem', position: 2, name: `${c.name} Review`, item: c.canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: c.faqItems.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
};
---

<PageFrame family="exchange" class="exchange-review-product">
  <section class="exchange-review-hero" aria-labelledby="exchange-review-title" data-exchange={c.slug}>
    <Container size="wide" class="exchange-review-hero__inner">
      <div class="exchange-review-identity">
        <div class="exchange-review-brand">
          <ExchangePromoLogoSlot
            src={c.wordmarkImg}
            alt={c.name}
            mode="clean"
            visualScale={c.logoVisualScale ?? 1}
            fetchpriority="high"
          />
        </div>
        <p class="cbw-eyebrow">Exchange review · verified global offer</p>
        <h1 id="exchange-review-title">{c.name} exchange review</h1>
        <p class="exchange-review-lede">
          Compare the current verified offer, key exchange facts and evidence. Your active country is shown separately because a global offer does not prove local eligibility.
        </p>
        <div class="exchange-review-country">
          <ActiveCountryContext
            compact={true}
            note={`Country context does not guarantee that ${c.name}, its products or this offer are available to you.`}
          />
        </div>
      </div>

      <aside class="exchange-offer-card" aria-label={`${c.name} verified offer`}>
        <StatusBadge label="Verified offer" tone="verified" />
        <span class="exchange-offer-card__label">Advertised maximum</span>
        <strong class="exchange-offer-card__headline">Up to {bonusMaxFmt} {c.currency}</strong>
        {confirmedPromoCode ? (
          <div class="exchange-offer-card__code">
            <span>Owner-confirmed code</span>
            <PromoCodeCopy code={confirmedPromoCode} exchange={c.name} />
          </div>
        ) : (
          <p class="exchange-offer-card__no-code">No promo/referral code is currently published by our commercial authority layer.</p>
        )}
        <a href={commercialHref} class="cbw-action exchange-offer-card__action" target="_blank" rel="noopener noreferrer sponsored">
          Check current {c.name} offer →
        </a>
        <small>
          Checked {c.lastChecked}. Final eligibility, country access and account-level tasks are controlled by {c.name}.
        </small>
      </aside>
    </Container>
  </section>

  <Section container="wide" spacing="compact" tone="page">
    <div class="exchange-fact-grid cbw-card-grid cbw-card-grid--4" aria-label={`${c.name} quick facts`}>
      <article class="cbw-card"><span>Offer status</span><strong>Verified global offer</strong></article>
      <article class="cbw-card"><span>KYC</span><strong>{c.kycNote}</strong></article>
      <article class="cbw-card"><span>Spot fees</span><strong>{c.fees.spot.maker} / {c.fees.spot.taker}</strong></article>
      <article class="cbw-card"><span>Founded</span><strong>{c.founded}</strong></article>
      <article class="cbw-card"><span>Headquarters</span><strong>{c.headquarters}</strong></article>
      <article class="cbw-card"><span>Users</span><strong>{c.users}</strong></article>
      <article class="cbw-card"><span>Evidence checked</span><strong>{c.lastChecked}</strong></article>
      <article class="cbw-card"><span>Local eligibility</span><strong>Check active market</strong></article>
    </div>
  </Section>

  <Section container="prose" spacing="standard" tone="primary">
    <div class="cbw-prose">
      <h2>{c.name} at a glance</h2>
      {c.introParagraphs.slice(0, 2).map(paragraph => <p set:html={paragraph} />)}
      <p>
        CryptoBonusWorld may earn a commission from the governed registration link on this page. That commercial relationship does not change the evidence state or local availability shown for the exchange.
      </p>
    </div>
  </Section>

  <Section container="prose" spacing="compact" tone="secondary">
    <header class="cbw-section-header">
      <p class="cbw-section-eyebrow">How to use the offer</p>
      <h2 class="cbw-section-title">Check the current {c.name} sign-up flow</h2>
      <p class="cbw-section-lede">These are general steps from the verified page configuration. Confirm the live requirements before depositing or trading.</p>
    </header>
    <ol class="exchange-steps">
      {c.howToClaimSteps.map((step, index) => (
        <li><span>{index + 1}</span><div set:html={step} /></li>
      ))}
    </ol>
  </Section>

  <Section container="prose" spacing="standard" tone="primary">
    <header class="cbw-section-header">
      <p class="cbw-section-eyebrow">Offer detail</p>
      <h2 class="cbw-section-title">Bonus tasks and conditions</h2>
      <p class="cbw-section-lede">The advertised maximum combines tasks and tiers; it is not a guaranteed flat payment.</p>
    </header>
    <div class="exchange-table-wrap">
      <table class="exchange-table">
        <thead><tr><th>Task</th><th>Requirement</th><th>Reward type</th><th>Notes</th></tr></thead>
        <tbody>
          {c.bonusLevelRows.map(row => (
            <tr><td>{row.task}</td><td>{row.requirement}</td><td>{row.rewardType}</td><td>{row.notes}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    {(c.bonusExtraSections ?? []).map(section => (
      <div class="cbw-prose exchange-extra"><h3>{section.h3}</h3><p set:html={section.text} /></div>
    ))}
  </Section>

  <Section container="prose" spacing="standard" tone="secondary">
    <header class="cbw-section-header">
      <p class="cbw-section-eyebrow">Trading costs</p>
      <h2 class="cbw-section-title">{c.name} fees</h2>
      <p class="cbw-section-lede">Published standard rates can vary by product, VIP level and account type. Verify the current exchange fee page before trading.</p>
    </header>
    <div class="exchange-table-wrap">
      <table class="exchange-table">
        <thead><tr><th>Market</th><th>Maker</th><th>Taker</th><th>Status</th></tr></thead>
        <tbody>
          {c.feeTableRows.map(row => (
            <tr>
              <td set:html={row.market} />
              <td>{row.maker}</td>
              <td>{row.taker}</td>
              <td set:html={row.statusCellHtml.replace(/^<td[^>]*>|<\/td>$/g, '')} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {c.feeAfterNoteHtml && <div class="exchange-note" set:html={c.feeAfterNoteHtml} />}
    <p class="exchange-source-link"><a href={c.feeUrl} target="_blank" rel="noopener noreferrer nofollow">Official {c.name} fee page →</a></p>
  </Section>

  <Section container="prose" spacing="standard" tone="primary">
    <header class="cbw-section-header">
      <p class="cbw-section-eyebrow">KYC & availability</p>
      <h2 class="cbw-section-title">Account and regional limitations</h2>
    </header>
    <div class="cbw-prose">
      {c.kycAvailabilityParagraphs.map(paragraph => <p set:html={paragraph} />)}
    </div>
  </Section>

  <Section container="prose" spacing="compact" tone="secondary">
    <details class="exchange-evidence" data-exchange-evidence>
      <summary>Evidence & verification details <span aria-hidden="true">+</span></summary>
      <div class="exchange-evidence__body">
        <p>{c.verificationIntroText}</p>
        <div class="exchange-verification-list">
          {c.verificationRows.map(row => (
            <article>
              <div><strong>{row.area}</strong><StatusBadge label={statusLabel(row.status)} tone={row.status === 'verified' ? 'verified' : 'review'} /></div>
              <p>{row.requirement}</p>
              <small>{row.statusNote}</small>
            </article>
          ))}
        </div>
        <p>{c.verificationAfterNote}</p>
        <a href={c.sourceUrl} target="_blank" rel="noopener noreferrer nofollow">Official offer source →</a>
      </div>
    </details>
  </Section>

  <Section container="prose" spacing="standard" tone="primary">
    <div class="cbw-prose">
      <h2>About {c.name}</h2>
      {c.aboutParagraphs.slice(0, 2).map(paragraph => <p set:html={paragraph} />)}
      <h3>Support</h3>
      <p set:html={c.supportText} />
    </div>
  </Section>

  <Section container="prose" spacing="standard" tone="secondary" id="faq">
    <header class="cbw-section-header">
      <p class="cbw-section-eyebrow">Exchange-specific questions</p>
      <h2 class="cbw-section-title">{c.name} FAQ</h2>
      <p class="cbw-section-lede">For general promo-code, country and verification questions, use the site-wide <a href="/faq/">FAQ</a>.</p>
    </header>
    <FAQList groups={faqGroups} />
  </Section>

  <Section container="wide" spacing="compact" tone="page">
    <header class="cbw-section-header cbw-section-header--split">
      <div>
        <p class="cbw-section-eyebrow">Compare alternatives</p>
        <h2 class="cbw-section-title">Other exchange profiles</h2>
      </div>
      <a class="exchange-directory-link" href="/exchanges/">All exchanges →</a>
    </header>
    <div class="related-grid cbw-card-grid cbw-card-grid--3">
      {relatedTiles.slice(0, 3).map(exchange => (
        <a class="cbw-card related-card" href={exchange.href}>
          <strong>{exchange.name}</strong>
          <StatusBadge label={exchange.status} tone={exchange.tone} />
          <span>Read review →</span>
        </a>
      ))}
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</PageFrame>

<style>
  .exchange-review-product { background: var(--cbw-surface-page); }
  .exchange-review-hero { color: #fff; background: radial-gradient(circle at 82% 8%,rgba(247,147,26,.18),transparent 28%),linear-gradient(135deg,#091321,#13233e 70%,#1a3456); }
  .exchange-review-hero__inner { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(300px,.65fr); gap: var(--cbw-space-7); align-items: center; padding-block: var(--cbw-space-7); }
  .exchange-review-brand { width: min(190px,45vw); min-height: 48px; margin-bottom: var(--cbw-space-3); display: flex; align-items: center; }
  .exchange-review-identity h1 { max-width: 760px; margin: 0; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(44px,6vw,70px); line-height: .92; letter-spacing: -.025em; text-transform: uppercase; }
  .exchange-review-lede { max-width: 720px; margin: var(--cbw-space-3) 0 0; color: rgba(255,255,255,.72); font-size: 13px; line-height: 1.6; }
  .exchange-review-country { max-width: 720px; margin-top: var(--cbw-space-4); }
  .exchange-offer-card { display: grid; gap: var(--cbw-space-3); padding: var(--cbw-space-5); border: 1px solid rgba(255,255,255,.15); border-radius: var(--cbw-radius-panel); background: rgba(255,255,255,.075); backdrop-filter: blur(10px); }
  .exchange-offer-card__label { color: rgba(255,255,255,.5); font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .exchange-offer-card__headline { font-family: 'Barlow Condensed','Inter',sans-serif; font-size: 35px; line-height: .95; text-transform: uppercase; }
  .exchange-offer-card__code { display: grid; gap: 5px; }
  .exchange-offer-card__code > span { color: rgba(255,255,255,.5); font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .exchange-offer-card__code :global(.pcc-row) { max-width: 100%; }
  .exchange-offer-card__no-code,.exchange-offer-card small { margin: 0; color: rgba(255,255,255,.56); font-size: 9px; line-height: 1.5; }
  .exchange-offer-card__action { width: 100%; min-height: 44px; font-size: 11px; }
  .exchange-fact-grid { --cbw-card-columns: 4; }
  .exchange-fact-grid article { display: grid; gap: 4px; margin: 0; }
  .exchange-fact-grid span { color: var(--cbw-text-muted); font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .exchange-fact-grid strong { color: var(--cbw-text-primary); font-size: 11px; line-height: 1.45; }
  .exchange-steps { display: grid; gap: var(--cbw-space-2); margin: 0; padding: 0; list-style: none; }
  .exchange-steps li { display: grid; grid-template-columns: 30px minmax(0,1fr); gap: var(--cbw-space-3); align-items: start; padding: var(--cbw-space-3); border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-control); background: #fff; color: var(--cbw-text-secondary); font-size: 12px; line-height: 1.55; }
  .exchange-steps li > span { display: inline-flex; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 50%; color: #13233e; background: var(--cbw-action); font-weight: 900; }
  .exchange-table-wrap { overflow-x: auto; border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: #fff; }
  .exchange-table { width: 100%; min-width: 620px; border-collapse: collapse; }
  .exchange-table th,.exchange-table td { padding: 10px 11px; border-bottom: 1px solid #edf0ec; color: var(--cbw-text-secondary); font-size: 10px; line-height: 1.45; text-align: left; vertical-align: top; }
  .exchange-table th { color: var(--cbw-text-muted); background: var(--cbw-surface-secondary); font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .exchange-table tr:last-child td { border-bottom: 0; }
  .exchange-extra { margin-top: var(--cbw-space-5); }
  .exchange-note,.exchange-source-link { margin: var(--cbw-space-3) 0 0; color: var(--cbw-text-muted); font-size: 10px; line-height: 1.55; }
  .exchange-source-link a,.exchange-directory-link { color: #925204; font-weight: 900; }
  .exchange-evidence { border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-card); background: #fff; }
  .exchange-evidence > summary { display: flex; min-height: 48px; align-items: center; justify-content: space-between; padding: var(--cbw-space-3) var(--cbw-space-4); color: var(--cbw-text-primary); font-size: 12px; font-weight: 900; cursor: pointer; list-style: none; }
  .exchange-evidence > summary::-webkit-details-marker { display: none; }
  .exchange-evidence[open] > summary span { transform: rotate(45deg); }
  .exchange-evidence__body { display: grid; gap: var(--cbw-space-4); padding: 0 var(--cbw-space-4) var(--cbw-space-4); color: var(--cbw-text-secondary); font-size: 11px; line-height: 1.6; }
  .exchange-verification-list { display: grid; gap: var(--cbw-space-2); }
  .exchange-verification-list article { padding: var(--cbw-space-3); border: 1px solid var(--cbw-border-standard); border-radius: var(--cbw-radius-control); background: var(--cbw-surface-secondary); }
  .exchange-verification-list article > div { display: flex; flex-wrap: wrap; gap: var(--cbw-space-2); justify-content: space-between; align-items: center; }
  .exchange-verification-list p { margin: 5px 0; }
  .exchange-verification-list small { color: var(--cbw-text-muted); }
  .related-grid { --cbw-card-columns: 3; }
  .related-card { display: grid; gap: var(--cbw-space-2); color: inherit; text-decoration: none; }
  .related-card > strong { font-family: 'Barlow Condensed','Inter',sans-serif; font-size: 22px; text-transform: uppercase; }
  .related-card > span { color: #925204; font-size: 10px; font-weight: 900; }
  @media (max-width: 820px) {
    .exchange-review-hero__inner { grid-template-columns: 1fr; gap: var(--cbw-space-5); }
    .exchange-offer-card { max-width: 560px; }
    .exchange-fact-grid { --cbw-card-columns: 2; }
  }
  @media (max-width: 699px) { .related-grid { --cbw-card-columns: 1; } }
  @media (max-width: 480px) {
    .exchange-review-identity h1 { font-size: 43px; }
    .exchange-fact-grid { --cbw-card-columns: 1; }
    .exchange-table { min-width: 560px; }
  }
</style>
