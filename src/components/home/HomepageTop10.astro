---
import ExchangeLogo from '../ExchangeLogo.astro';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';
import { homepageTop10 } from '../../data/homepageTop10';
import '../../styles/site-standard-v1.css';
---

<section class="top10-section" id="exchanges" aria-labelledby="top10-title">
  <div class="top10-wrap">
    <div class="top10-heading">
      <div>
        <div class="top10-label">Editorial comparison · 10 exchanges</div>
        <h2 id="top10-title">Top 10 Crypto Exchanges to Compare</h2>
        <p>
          Ranked from the current CryptoBonusWorld editorial inventory. Offer and research badges show
          how far each listing has been verified — availability can still differ by country and account.
        </p>
      </div>
      <a href="/exchanges/" class="top10-directory-link">View full exchange directory →</a>
    </div>

    <div class="top10-column-head" aria-hidden="true">
      <span>Rank</span>
      <span>Exchange</span>
      <span>Best for</span>
      <span>Offer or evidence status</span>
      <span>Actions</span>
    </div>

    <ol class="top10-list">
      {homepageTop10.map((entry) => (
        <li class="top10-row" data-rank={entry.rank}>
          <div class="top10-rank" aria-label={`Rank ${entry.rank}`}>
            <span>{entry.rank}</span>
          </div>

          <div class="top10-exchange">
            <ExchangeLogo
              slug={entry.slug}
              name={entry.name}
              size={48}
              variant="square"
              lazy={entry.rank > 4}
              class="top10-logo"
            />
            <div class="top10-exchange-copy">
              <strong>{entry.name}</strong>
              <span class:list={['top10-status', `top10-status--${entry.statusTone}`]}>
                {entry.statusLabel}
              </span>
            </div>
          </div>

          <div class="top10-fit">
            <span class="top10-mobile-label">Best for</span>
            <p>{entry.bestFor}</p>
          </div>

          <div class="top10-evidence">
            <span class="top10-mobile-label">Offer or evidence status</span>
            <p class="top10-summary">{entry.summary}</p>
            {entry.promoCode && (
              <div class="top10-code">
                <span class="top10-code-label">Promo code</span>
                <PromoCodeCopy code={entry.promoCode} exchange={entry.name} />
              </div>
            )}
            <span class="top10-checked">Last checked: {entry.lastChecked}</span>
          </div>

          <div class="top10-actions">
            {entry.primaryAction && (
              <a
                href={entry.primaryAction.href}
                class="top10-primary"
                target={entry.primaryAction.external ? '_blank' : undefined}
                rel={entry.primaryAction.external
                  ? entry.primaryAction.sponsored
                    ? 'noopener noreferrer sponsored'
                    : 'noopener noreferrer'
                  : undefined}
              >
                {entry.primaryAction.label} →
              </a>
            )}
            <a href={entry.secondaryAction.href} class="top10-secondary">
              {entry.secondaryAction.label}
            </a>
          </div>
        </li>
      ))}
    </ol>

    <div class="top10-method" id="top-10-methodology">
      <strong>How to read this list:</strong>
      rank reflects the current CryptoBonusWorld editorial inventory, not a personalized recommendation.
      A green badge means the clean offer record is verified; amber means a public preview; blue means
      completed country research with campaign eligibility still under review; gray means the profile is
      being re-verified. Always confirm current regional terms on the exchange’s official website.
    </div>
  </div>
</section>

<style>
  .top10-section {
    background: var(--cbw-surface-primary);
    padding: 18px 0 var(--cbw-space-9);
  }

  .top10-wrap {
    width: 100%;
    max-width: var(--cbw-width-wide);
    margin: 0 auto;
    padding-inline: var(--cbw-gutter);
    box-sizing: border-box;
  }

  .top10-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--cbw-space-6);
    margin-bottom: 13px;
  }

  .top10-label {
    margin-bottom: 5px;
    color: var(--cbw-action);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .top10-heading h2 {
    margin: 0 0 5px;
    color: var(--cbw-text-primary);
    font-family: 'Barlow Condensed', 'Inter', sans-serif;
    font-size: clamp(27px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .top10-heading p {
    max-width: var(--cbw-width-prose);
    margin: 0;
    color: var(--cbw-text-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  .top10-directory-link {
    flex: 0 0 auto;
    color: #925204;
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .top10-directory-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .top10-column-head,
  .top10-row {
    display: grid;
    grid-template-columns: 46px minmax(150px, .9fr) minmax(142px, .84fr) minmax(258px, 1.5fr) minmax(142px, .74fr);
    gap: 12px;
    align-items: center;
  }

  .top10-column-head {
    padding: 0 13px 6px;
    color: var(--cbw-text-muted);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .top10-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top10-row {
    min-width: 0;
    padding: 11px 13px;
    border: 1px solid var(--cbw-border-standard);
    border-radius: var(--cbw-radius-card);
    background: var(--cbw-surface-primary);
    box-shadow: 0 1px 3px rgba(17,24,39,.04);
    transition: border-color .18s, box-shadow .18s, transform .18s;
  }

  .top10-row:hover {
    border-color: #cbd3cb;
    box-shadow: 0 7px 24px rgba(17,24,39,.08);
    transform: translateY(-1px);
  }

  .top10-rank {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .top10-rank span {
    display: inline-flex;
    width: 31px;
    height: 31px;
    align-items: center;
    justify-content: center;
    border-radius: var(--cbw-radius-pill);
    background: var(--cbw-text-primary);
    color: #fff;
    font-size: 13px;
    font-weight: 900;
  }

  .top10-row[data-rank='1'] .top10-rank span { color: var(--cbw-text-primary); background: var(--cbw-action); }
  .top10-row[data-rank='2'] .top10-rank span,
  .top10-row[data-rank='3'] .top10-rank span { background: #374151; }

  .top10-exchange {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 9px;
  }

  .top10-exchange-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .top10-exchange-copy strong {
    overflow: hidden;
    max-width: 100%;
    color: var(--cbw-text-primary);
    font-size: 15px;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top10-status {
    display: inline-flex;
    max-width: 100%;
    padding: 2px 7px;
    border: 1px solid transparent;
    border-radius: var(--cbw-radius-pill);
    font-size: 9px;
    font-weight: 900;
    line-height: 1.2;
  }

  .top10-status--verified { border-color: #bbf7d0; color: #166534; background: #f0fdf4; }
  .top10-status--preview { border-color: #fde68a; color: #92400e; background: #fffbeb; }
  .top10-status--research { border-color: #bfdbfe; color: #1d4ed8; background: #eff6ff; }
  .top10-status--review { border-color: #e5e7eb; color: #4b5563; background: #f9fafb; }

  .top10-fit,
  .top10-evidence,
  .top10-actions { min-width: 0; }

  .top10-fit p,
  .top10-summary {
    margin: 0;
    color: #374151;
    font-size: 11.5px;
    line-height: 1.45;
  }

  .top10-summary { color: var(--cbw-text-primary); font-weight: 700; }
  .top10-code { margin-top: 6px; }
  .top10-code-label { display: block; margin-bottom: 3px; color: #92400e; font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .top10-code :global(.pcc-row) { max-width: 240px; height: 36px; }
  .top10-code :global(.pcc-code) { padding: 0 9px; font-size: 13px; }
  .top10-code :global(.pcc-copy) { width: 52px; font-size: 9px; }
  .top10-checked { display: block; margin-top: 5px; color: #929ba7; font-size: 9px; line-height: 1.3; }

  .top10-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
  }

  .top10-primary,
  .top10-secondary {
    display: flex;
    min-height: 35px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-radius: var(--cbw-radius-control);
    font-size: 11px;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .top10-primary {
    border: 1px solid rgba(19,35,62,.12);
    color: var(--cbw-text-primary);
    background: var(--cbw-action);
    box-shadow: 0 2px 7px rgba(247,147,26,.2);
  }

  .top10-primary:hover { background: var(--cbw-action-hover); }
  .top10-secondary { border: 1px solid #d1d5db; color: #374151; background: #fff; }
  .top10-secondary:hover { border-color: #9ca3af; background: #f9fafb; }
  .top10-mobile-label { display: none; }

  .top10-method {
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px solid var(--cbw-border-standard);
    border-radius: var(--cbw-radius-control);
    color: #6b7280;
    background: var(--cbw-surface-secondary);
    font-size: 10px;
    line-height: 1.6;
  }
  .top10-method strong { color: #374151; }

  @media (max-width: 959px) {
    .top10-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
    .top10-column-head { display: none; }
    .top10-row { grid-template-columns: 40px minmax(0,1fr); gap: 9px 11px; align-items: start; padding: 13px; }
    .top10-rank { grid-column: 1; grid-row: 1; padding-top: 6px; }
    .top10-exchange { grid-column: 2; grid-row: 1; }
    .top10-fit,
    .top10-evidence,
    .top10-actions { grid-column: 1 / -1; padding-left: 51px; }
    .top10-mobile-label { display: block; margin-bottom: 3px; color: #9ca3af; font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
    .top10-actions { flex-direction: row; flex-wrap: wrap; }
    .top10-primary,
    .top10-secondary { min-width: 140px; flex: 1 1 140px; padding-inline: 12px; }
  }

  @media (max-width: 520px) {
    .top10-section { padding: 15px 0 var(--cbw-space-8); }
    .top10-heading { margin-bottom: 10px; }
    .top10-heading h2 { font-size: 25px; }
    .top10-heading p { font-size: 11px; line-height: 1.45; }
    .top10-directory-link { font-size: 10px; white-space: normal; }
    .top10-row { grid-template-columns: 36px minmax(0,1fr); padding: 12px 10px; }
    .top10-rank span { width: 29px; height: 29px; font-size: 12px; }
    .top10-exchange :global(.top10-logo) { width: 40px !important; height: 40px !important; }
    .top10-fit,
    .top10-evidence,
    .top10-actions { padding-left: 47px; }
    .top10-actions { flex-direction: column; }
    .top10-primary,
    .top10-secondary { width: 100%; min-width: 0; flex-basis: auto; }
    .top10-code :global(.pcc-row) { max-width: 100%; }
  }
</style>
