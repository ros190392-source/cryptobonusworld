---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ExchangeLogo from '../../../../components/ExchangeLogo.astro';
import ReviewStatus from '../../../../components/portal-v2/ReviewStatus.astro';
import {
  kazakhstanReviewContentPackages,
  type KazakhstanReviewContentPackage,
} from '../../../../data/pilots/kz/contentPackages';

const exchangeNames: Record<string, string> = {
  binance: 'Binance',
  bybit: 'Bybit',
  okx: 'OKX',
};

const packageTitle = (pkg: KazakhstanReviewContentPackage) =>
  pkg.packageKind === 'country_hub'
    ? 'Kazakhstan country hub'
    : `${exchangeNames[pkg.exchangeId ?? ''] ?? pkg.exchangeId} × Kazakhstan passport`;
---

<CleanLayout
  title="CBW Portal Factory v2 — Kazakhstan Review ContentPackages"
  description="Review-only Kazakhstan country and market-passport content package inventory."
  noindex={true}
  bodyClass="cbw-v2-content-packages"
>
  <main class="packages-page">
    <section class="hero">
      <div class="shell">
        <div class="review-nav">
          <span>Review route · noindex · publication disabled</span>
          <nav aria-label="Portal v2 review routes">
            <a href="/__design/cbw-v2/country/">Country hub</a>
            <a href="/__design/cbw-v2/comparative-matrix/">Evidence matrix</a>
            <a href="/__design/cbw-v2/contracts/">Contracts</a>
          </nav>
        </div>

        <p class="eyebrow">Kazakhstan content assembly</p>
        <h1>Draft packages, not published pages.</h1>
        <p class="lede">
          Validated claims are assembled as review candidates without being relabeled as approved. Every package keeps ranking rows, recommendations, affiliate CTAs, publication and indexability disabled.
        </p>

        <div class="hero-grid">
          <div><span>Packages</span><strong>{kazakhstanReviewContentPackages.length}</strong></div>
          <div><span>Approved claims</span><strong>0</strong></div>
          <div><span>Approved locales</span><strong>0</strong></div>
          <div><span>Public routes</span><strong>0</strong></div>
        </div>
      </div>
    </section>

    <section class="content">
      <div class="shell">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Governed package inventory</p>
            <h2>Claims, sources and editorial blocks stay traceable</h2>
            <p>A package may prepare review rendering. It cannot approve a fact, activate a locale or publish itself.</p>
          </div>
          <ReviewStatus
            label="All packages draft"
            detail="Publication authority remains false."
            tone="review"
          />
        </header>

        <div class="package-grid">
          {kazakhstanReviewContentPackages.map(pkg => (
            <article class:list={['package-card', { conflict: pkg.conflictPreserving }]} data-package-id={pkg.packageId}>
              <header>
                <div class="identity">
                  {pkg.exchangeId ? (
                    <ExchangeLogo slug={pkg.exchangeId} name={exchangeNames[pkg.exchangeId] ?? pkg.exchangeId} size={40} variant="square" lazy={false} />
                  ) : (
                    <span class="country-mark">🇰🇿</span>
                  )}
                  <div>
                    <span>{pkg.packageKind === 'country_hub' ? 'Country package' : 'Market-passport package'}</span>
                    <h3>{packageTitle(pkg)}</h3>
                  </div>
                </div>
                <ReviewStatus
                  label={pkg.conflictPreserving ? 'Draft · conflict preserving' : 'Draft · review only'}
                  detail={`Approval ${pkg.approval}`}
                  tone={pkg.conflictPreserving ? 'review' : 'partial'}
                  compact={true}
                />
              </header>

              <div class="counts">
                <div><span>Candidate claims</span><strong>{pkg.candidateClaimIds.length}</strong></div>
                <div><span>Source packets</span><strong>{pkg.sourcePacketIds.length}</strong></div>
                <div><span>Editorial blocks</span><strong>{pkg.editorialBlocks.length}</strong></div>
                <div><span>Approved claims</span><strong>{pkg.approvedClaimIds.length}</strong></div>
              </div>

              <dl>
                <div><dt>Package ID</dt><dd><code>{pkg.packageId}</code></dd></div>
                <div><dt>Preview route</dt><dd><code>{pkg.previewRoute}</code></dd></div>
                <div><dt>Profiles</dt><dd>{pkg.marketProfileIds.join(', ')}</dd></div>
                <div><dt>Ranking usage</dt><dd>{pkg.rankingUsage}</dd></div>
                <div><dt>Locale readiness</dt><dd>{Object.entries(pkg.localeReadiness).map(([locale, state]) => `${locale}:${state}`).join(' · ')}</dd></div>
              </dl>

              <details>
                <summary>Editorial blocks</summary>
                <ul>{pkg.editorialBlocks.map(block => <li><code>{block}</code></li>)}</ul>
              </details>

              <footer>
                <span>Recommendation: off</span>
                <span>Ranking rows: off</span>
                <span>CTA: off</span>
                <span>Indexability: off</span>
              </footer>
            </article>
          ))}
        </div>

        <section class="boundary">
          <div>
            <p class="eyebrow">Approval boundary</p>
            <h2>Validated is not approved</h2>
            <p>The package contract deliberately keeps `approvedClaimIds` empty. Candidate claims may be edited and reviewed, but only a later explicit owner decision may approve factual content and locale publication.</p>
          </div>
          <div class="boundary-list">
            <span>publicationAuthorized = false</span>
            <span>rankingRowsAuthorized = false</span>
            <span>affiliateCtaAuthorized = false</span>
            <span>indexabilityAuthorized = false</span>
          </div>
        </section>
      </div>
    </section>
  </main>
</CleanLayout>

<style>
  :global(body.cbw-v2-content-packages) { background: #f7f8f4; }
  .packages-page { min-height: 100vh; color: #13233e; background: #f7f8f4; }
  .shell { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
  .hero { padding: 18px 0 60px; color: #fff; background: radial-gradient(circle at 82% 13%, rgba(247,147,26,.22), transparent 27%), linear-gradient(135deg,#0c1729,#19375a); }
  .review-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 10px 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; color: #c7d2e1; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .review-nav nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .review-nav a { color: #f7b75e; }
  .eyebrow { margin: 32px 0 10px; color: #f7931a; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: -.025em; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(48px,8vw,82px); line-height: .92; }
  .lede { max-width: 850px; margin: 22px 0 0; color: #d2ddea; font-size: 16px; line-height: 1.7; }
  .hero-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin-top: 28px; }
  .hero-grid div { padding: 14px; border: 1px solid rgba(255,255,255,.14); border-radius: 11px; background: rgba(255,255,255,.07); }
  .hero-grid span, .hero-grid strong { display: block; }
  .hero-grid span { color: #b8c7d8; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .hero-grid strong { margin-top: 5px; font-size: 21px; }
  .content { padding: 70px 0 90px; }
  .section-heading { display: grid; gap: 18px; align-items: end; margin-bottom: 26px; }
  .section-heading .eyebrow, .boundary .eyebrow { margin-top: 0; }
  .section-heading h2, .boundary h2 { margin: 0; font-size: clamp(36px,5vw,54px); line-height: .96; }
  .section-heading p:last-child { max-width: 760px; margin: 10px 0 0; color: #647080; line-height: 1.6; }
  .package-grid { display: grid; gap: 16px; }
  .package-card { padding: 20px; border: 1px solid #d9dfd9; border-radius: 16px; background: #fff; }
  .package-card.conflict { border-color: #eac48e; background: #fffaf1; }
  .package-card > header { display: grid; gap: 14px; }
  .identity { display: flex; gap: 12px; align-items: center; }
  .identity > div > span { color: #7b8793; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .identity h3 { margin: 4px 0 0; font-size: 21px; }
  .country-mark { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 10px; background: #eef2ec; font-size: 21px; }
  .counts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-top: 17px; }
  .counts div { padding: 11px; border-radius: 10px; background: #f4f6f3; }
  .counts span, .counts strong { display: block; }
  .counts span { color: #75808c; font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .counts strong { margin-top: 4px; font-size: 18px; }
  dl { display: grid; gap: 8px; margin: 17px 0 0; }
  dl div { display: grid; gap: 4px; padding-top: 9px; border-top: 1px solid #e6e9e5; }
  dt { color: #74808e; font-size: 9px; }
  dd { margin: 0; font-size: 10px; font-weight: 800; overflow-wrap: anywhere; }
  dd code { color: #925204; }
  details { margin-top: 16px; }
  summary { cursor: pointer; color: #925204; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  details ul { display: grid; gap: 5px; margin: 9px 0 0; padding-left: 17px; }
  details code { color: #66727e; font-size: 9px; overflow-wrap: anywhere; }
  .package-card footer { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 17px; }
  .package-card footer span { padding: 6px 8px; border-radius: 999px; background: #eef1ed; color: #66727e; font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .boundary { display: grid; gap: 20px; margin-top: 24px; padding: 25px; border-radius: 16px; color: #fff; background: #13233e; }
  .boundary p:last-child { color: #bdc9d8; line-height: 1.6; }
  .boundary-list { display: grid; gap: 8px; }
  .boundary-list span { padding: 10px; border: 1px solid rgba(255,255,255,.12); border-radius: 9px; color: #f7b75e; font-family: monospace; font-size: 9px; }
  @media (min-width: 720px) {
    .hero-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .section-heading { grid-template-columns: minmax(0,1fr) auto; }
    .package-card > header { grid-template-columns: minmax(0,1fr) auto; align-items: start; }
    .counts { grid-template-columns: repeat(4,minmax(0,1fr)); }
    dl div { grid-template-columns: 120px minmax(0,1fr); }
    .boundary { grid-template-columns: 1.2fr .8fr; align-items: center; }
  }
  @media (min-width: 960px) { .package-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
</style>
