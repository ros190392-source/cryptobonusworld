---
import CleanLayout from '../../../layouts/CleanLayout.astro';
import {
  currentWidthInventory,
  deletionTargets,
  firstViewportContract,
  layoutFindings,
  routeFamilies,
  sitewideLayoutAuditPass,
  sitewideLayoutAuditValidation,
  targetContainers,
} from '../../../data/layout/sitewideLayoutAudit';

export function getStaticPaths() {
  return [{ params: { designRoot: '__design' } }];
}

const p0Count = layoutFindings.filter(finding => finding.severity === 'P0').length;
const failedCount = layoutFindings.filter(finding => finding.state === 'FAIL').length;
const publicFamilies = routeFamilies.filter(family => family.publicGeometryAuthority);
const guardedReviewFamilies = routeFamilies.filter(family => family.id.startsWith('country-review'));
---

<CleanLayout
  title="Sitewide Layout Standard v3 Audit | CryptoBonusWorld"
  description="Noindex owner review hub for page-family geometry, first-viewport rules, SEO and affiliate preservation."
  noindex={true}
>
  <div class="audit-page" data-layout-audit data-audit-pass={String(sitewideLayoutAuditPass)}>
    <section class="audit-hero">
      <div class="shell">
        <div class="preview-strip"><span>Noindex audit</span><span>No public mutation</span></div>
        <p class="eyebrow">Sitewide Layout Standard v3 · 053A</p>
        <h1>One governed geometry for every public page.</h1>
        <p class="lede">
          The current visual system shares color and typography, but still uses multiple container widths,
          legacy DOM contracts and incompatible first-screen behavior. This hub records the failures before remediation.
        </p>
        <div class:list={['outcome', { pass: sitewideLayoutAuditPass }]}>
          <strong>{sitewideLayoutAuditPass ? 'AUDIT MANIFEST VALID' : 'AUDIT MANIFEST INVALID'}</strong>
          <span>{p0Count} P0 · {failedCount} failures · {publicFamilies.length} public families · {guardedReviewFamilies.length} guarded country-review families</span>
        </div>
      </div>
    </section>

    <main class="shell stack">
      <section class="panel" aria-labelledby="findings-title">
        <header class="section-heading"><p class="eyebrow">Cross-functional audit</p><h2 id="findings-title">Confirmed findings</h2></header>
        <div class="finding-grid">
          {layoutFindings.map(finding => (
            <article class:list={['finding', `severity-${finding.severity.toLowerCase()}`, `state-${finding.state.toLowerCase()}`]} data-finding={finding.id}>
              <div class="finding-meta"><span>{finding.severity}</span><strong>{finding.state}</strong></div>
              <h3>{finding.title}</h3>
              <p>{finding.evidence}</p>
              <div class="remediation"><strong>Remediation</strong><span>{finding.remediation}</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="panel" aria-labelledby="containers-title">
        <header class="section-heading"><p class="eyebrow">Container contract</p><h2 id="containers-title">Current drift → target roles</h2></header>
        <div class="two-col">
          <div>
            <h3>Current active widths</h3>
            <div class="width-list">
              {currentWidthInventory.map(item => (
                <div data-current-width={item.value}><strong>{item.value}px</strong><span>{item.source}</span></div>
              ))}
            </div>
          </div>
          <div>
            <h3>Target named containers</h3>
            <div class="width-list target-list">
              {targetContainers.map(container => (
                <div data-container-role={container.role}><strong>{container.role} · {container.maxWidth}px</strong><span>{container.use}</span></div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="panel" aria-labelledby="viewport-title">
        <header class="section-heading"><p class="eyebrow">First viewport</p><h2 id="viewport-title">Primary intent must appear immediately</h2></header>
        <div class="viewport-grid">
          {Object.entries(firstViewportContract).map(([key, values]) => (
            <article><h3>{key}</h3><ol>{values.map(value => <li>{value}</li>)}</ol></article>
          ))}
        </div>
      </section>

      <section class="panel" aria-labelledby="families-title">
        <header class="section-heading"><p class="eyebrow">Route architecture</p><h2 id="families-title">Every route belongs to a family</h2></header>
        <div class="family-list">
          {routeFamilies.map(family => (
            <article data-family={family.id} data-public-authority={String(family.publicGeometryAuthority)}>
              <div class="family-top"><div><span>{family.id}</span><h3>{family.label}</h3></div><strong>{family.currentState}</strong></div>
              <p>{family.routes.join(' · ')}</p>
              <dl><div><dt>Target</dt><dd>{family.targetTemplate}</dd></div><div><dt>Containers</dt><dd>{family.containerRoles.join(' / ') || 'none'}</dd></div></dl>
            </article>
          ))}
        </div>
      </section>

      <section class="panel" aria-labelledby="deletion-title">
        <header class="section-heading"><p class="eyebrow">Replacement before deletion</p><h2 id="deletion-title">Legacy layers to remove</h2></header>
        <ol class="deletion-list">{deletionTargets.map(target => <li>{target}</li>)}</ol>
      </section>

      <section class="panel validation-panel" aria-labelledby="validation-title">
        <header class="section-heading"><p class="eyebrow">Manifest validation</p><h2 id="validation-title">Fail-closed audit checks</h2></header>
        <div class="validation-grid">
          {Object.entries(sitewideLayoutAuditValidation).map(([name, passed]) => (
            <div data-validation={name} data-passed={String(passed)}><span>{name}</span><strong>{passed ? 'PASS' : 'FAIL'}</strong></div>
          ))}
        </div>
      </section>
    </main>
  </div>
</CleanLayout>

<style>
  .audit-page { min-height: 100vh; color: #13233e; background: #f3f6f2; }
  .shell { width: min(1200px, calc(100% - 40px)); margin-inline: auto; }
  .audit-hero { padding: 48px 0 42px; color: #fff; background: radial-gradient(circle at 82% 8%, rgba(247,147,26,.24), transparent 27%), linear-gradient(135deg,#081426,#13233e); }
  .preview-strip { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 16px; margin-bottom: 30px; color: rgba(255,255,255,.55); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .eyebrow { margin: 0 0 10px; color: #f7b45a; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed','Inter',sans-serif; text-transform: uppercase; letter-spacing: -.025em; overflow-wrap: anywhere; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(48px,8vw,82px); line-height: .92; }
  .lede { max-width: 760px; margin: 20px 0 0; color: #cfdae7; line-height: 1.72; overflow-wrap: anywhere; }
  .outcome { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 28px; padding: 14px 16px; border: 1px solid rgba(255,255,255,.15); border-radius: 12px; background: rgba(255,255,255,.06); }
  .outcome strong, .outcome span { min-width: 0; overflow-wrap: anywhere; }
  .outcome strong { color: #f7b45a; }
  .outcome span { color: #c5d0de; font-size: 12px; }
  .stack { display: grid; gap: 22px; padding-block: 30px 70px; }
  .panel { min-width: 0; padding: 26px; border: 1px solid #d8e0d7; border-radius: 18px; background: #fff; box-shadow: 0 10px 30px rgba(19,35,62,.05); }
  .section-heading { min-width: 0; margin-bottom: 20px; }
  .section-heading h2 { margin: 0; font-size: clamp(32px,5vw,48px); line-height: .96; }
  .finding-grid, .viewport-grid { display: grid; gap: 12px; }
  .finding, .viewport-grid article, .family-list article, .width-list div, .validation-grid div { min-width: 0; }
  .finding { padding: 18px; border: 1px solid #dde4dc; border-radius: 14px; background: #fbfcfa; }
  .severity-p0 { border-left: 5px solid #c84646; }
  .severity-p1 { border-left: 5px solid #f7931a; }
  .severity-p2 { border-left: 5px solid #3b82f6; }
  .finding-meta, .family-top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 8px 14px; }
  .finding-meta span, .family-top span { color: #a65400; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .finding-meta strong, .family-top > strong { max-width: 100%; color: #6b7280; font-size: 10px; overflow-wrap: anywhere; }
  .finding h3, .family-top h3, .viewport-grid h3, .two-col h3 { margin: 10px 0 8px; overflow-wrap: anywhere; }
  .finding p, .family-list p { margin: 0; color: #5d6978; line-height: 1.65; overflow-wrap: anywhere; word-break: break-word; }
  .remediation { display: grid; gap: 4px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #e4e8e3; font-size: 12px; }
  .remediation span { color: #5d6978; overflow-wrap: anywhere; }
  .two-col { display: grid; gap: 20px; }
  .two-col > div { min-width: 0; }
  .width-list { display: grid; gap: 8px; }
  .width-list div { display: grid; gap: 3px; padding: 12px 14px; border: 1px solid #dfe5de; border-radius: 11px; background: #f8faf7; }
  .width-list strong, .width-list span { overflow-wrap: anywhere; }
  .width-list span { color: #667280; font-size: 12px; }
  .target-list strong { color: #8a4d00; }
  .viewport-grid article { padding: 17px; border-radius: 13px; color: #fff; background: #13233e; }
  .viewport-grid h3 { color: #f7b45a; }
  .viewport-grid ol { margin: 0; padding-left: 20px; color: #d4deea; font-size: 13px; line-height: 1.7; }
  .viewport-grid li { overflow-wrap: anywhere; }
  .family-list { display: grid; gap: 10px; }
  .family-list article { padding: 17px; border: 1px solid #dce3dc; border-radius: 14px; }
  .family-top > div { min-width: 0; }
  .family-top h3 { margin: 3px 0 0; }
  .family-list dl { display: grid; gap: 7px; margin: 13px 0 0; }
  .family-list dl div { display: flex; min-width: 0; justify-content: space-between; gap: 16px; padding-top: 7px; border-top: 1px solid #edf0ec; font-size: 12px; }
  .family-list dt { color: #798594; }
  .family-list dd { min-width: 0; margin: 0; text-align: right; overflow-wrap: anywhere; word-break: break-word; }
  .deletion-list { display: grid; gap: 8px; margin: 0; padding-left: 22px; color: #45556a; line-height: 1.65; }
  .deletion-list li { overflow-wrap: anywhere; }
  .deletion-list li::marker { color: #f7931a; font-weight: 900; }
  .validation-grid { display: grid; gap: 8px; }
  .validation-grid div { display: flex; justify-content: space-between; gap: 16px; padding: 11px 13px; border: 1px solid #dce3dc; border-radius: 10px; background: #f8faf7; font-size: 12px; }
  .validation-grid span { min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
  .validation-grid strong { flex: 0 0 auto; color: #16834b; }
  @media (min-width: 760px) {
    .finding-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .two-col { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .viewport-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .family-list { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .validation-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (max-width: 639px) {
    .shell { width: min(calc(100% - 40px), 1200px); }
    .audit-hero { padding: 36px 0 32px; }
    h1 { font-size: clamp(42px,13vw,58px); }
    .panel { padding: 20px; border-radius: 15px; }
    .family-list dl div { display: grid; gap: 3px; }
    .family-list dd { text-align: left; }
    .validation-grid div { align-items: flex-start; }
  }
</style>
