---
import CleanLayout from '../layouts/CleanLayout.astro';
import HomepageTop10 from '../components/home/HomepageTop10.astro';
import '../styles/homepage-v3.css';
import {
  homepageCountryCards,
  homepageFaqSchema,
  homepageFaqs,
  homepageGuideBlocks,
  homepagePathways,
  homepageTrustItems,
  homepageUpdates,
} from '../data/homepageV3';
---

<CleanLayout
  title="Compare Crypto Exchanges by Offer & Evidence | CryptoBonusWorld"
  description="Compare 10 crypto exchanges in one governed view. See verified offers, research status, country context, limitations, and current evidence before choosing an exchange."
  ogImage="/og-default.png"
  bodyClass="cbw-homepage-v2-public cbw-homepage-v3"
>
  <div class="homepage-v3" data-homepage-v3>
    <section class="home-hero" data-first-intent="homepage">
      <div class="cbw-container cbw-container--shell">
        <div class="home-hero-grid">
          <div class="home-hero-copy">
            <p class="eyebrow">Checked by country · backed by evidence</p>
            <h1>Find the right crypto exchange for your market.</h1>
            <p class="home-hero-lede">
              Compare exchange offers and research status without mixing global claims with country-specific facts.
              Verified, limited and under-review states stay clearly separated.
            </p>
            <div class="home-hero-actions">
              <a class="home-button home-button--primary" href="#exchanges">Explore the Top 10</a>
              <a class="home-button home-button--secondary" href="#markets">Explore markets</a>
            </div>
            <div class="home-proof" aria-label="Homepage evidence summary">
              <span><strong>10</strong> governed rows</span>
              <span><strong>1</strong> canonical ranking</span>
              <span><strong>0</strong> unsupported CTAs</span>
            </div>
          </div>

          <aside class="home-market-context" aria-label="Market and language context" data-market-context>
            <div class="home-market-primary">
              <span class="home-market-icon" aria-hidden="true">🌍</span>
              <div>
                <span>Current comparison context</span>
                <strong>Global market view</strong>
                <small>Country evidence remains a separate publication gate</small>
              </div>
            </div>
            <dl>
              <div><dt>Country</dt><dd>Global</dd></div>
              <div><dt>Language</dt><dd>English</dd></div>
            </dl>
            <p class="home-market-note">Country controls market facts. Language controls presentation. They are reviewed separately.</p>
          </aside>
        </div>
      </div>
    </section>

    <div data-first-ranking>
      <HomepageTop10 />
    </div>

    <section class="home-pathways" aria-label="How CryptoBonusWorld works">
      <div class="cbw-container cbw-container--wide home-pathway-grid">
        {homepagePathways.map(path => (
          <article class="home-pathway-card">
            <span>{path.number}</span>
            <h2>{path.title}</h2>
            <p>{path.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-markets" id="markets">
      <div class="cbw-container cbw-container--wide">
        <header class="home-section-heading">
          <div>
            <p class="eyebrow">Country-first discovery</p>
            <h2>Explore markets, not duplicate rankings.</h2>
            <p>Country cards show research readiness only. They do not create a second exchange table on the homepage.</p>
          </div>
          <span class="home-section-state">Country pages in controlled preview</span>
        </header>

        <div class="home-country-grid">
          {homepageCountryCards.map(country => (
            <article class="home-country-card">
              <div class="home-country-top">
                <span class="home-country-flag">{country.flag}</span>
                <span class={`home-country-tone tone-${country.tone}`}></span>
              </div>
              <h3>{country.name}</h3>
              <p>{country.note}</p>
              <strong>{country.status}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-trust">
      <div class="cbw-container cbw-container--wide home-trust-grid">
        <div class="home-trust-copy">
          <p class="eyebrow">Why trust CryptoBonusWorld</p>
          <h2>Evidence is a product feature, not a footnote.</h2>
          <p>We show what was checked, what remains uncertain, and when a profile needs review. Missing evidence produces a visible limitation — not an invented answer.</p>
          <a class="home-button home-button--secondary" href="#guide">Read the bonus guide</a>
        </div>
        <div class="home-trust-list">
          {homepageTrustItems.map(item => (
            <article>
              <span>{item.number}</span>
              <div><strong>{item.title}</strong><p>{item.text}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-updates">
      <div class="cbw-container cbw-container--wide">
        <header class="home-section-heading">
          <div><p class="eyebrow">Research and product changes</p><h2>Latest governed updates</h2></div>
        </header>
        <div class="home-updates-list">
          {homepageUpdates.map(update => (
            <article class="home-update-row">
              <span class="home-update-date">{update.date}</span>
              <div><strong>{update.title}</strong><p>{update.detail}</p></div>
              <span class="home-update-label">{update.label}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-guide" id="guide">
      <div class="cbw-container cbw-container--prose">
        <p class="eyebrow">Guide</p>
        <h2>Crypto exchange bonuses guide</h2>
        <div class="home-guide-list">
          {homepageGuideBlocks.map(block => (
            <article><h3>{block.h3}</h3><p>{block.p}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-faq" id="faq">
      <div class="cbw-container cbw-container--prose">
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked questions</h2>
        <div class="home-faq-list">
          {homepageFaqs.map(item => (
            <details><summary>{item.q}</summary><p>{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="home-disclosure">
      <div class="cbw-container cbw-container--prose">
        <p>
          <strong>Disclosure:</strong> CryptoBonusWorld may earn a commission when you register through approved links on this site.
          This does not affect editorial status or ranking position. Advertised bonus amounts are maximums and depend on eligibility,
          KYC, deposits, trading activity, deadlines, and local terms. Verify current conditions on the official exchange website before
          registering or depositing. Cryptocurrency trading carries significant risk and nothing here is financial advice.
          Read our <a href="/affiliate-disclosure/">affiliate disclosure</a>.
        </p>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(homepageFaqSchema)} />
</CleanLayout>
