---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ExchangeLogo from '../../../../components/ExchangeLogo.astro';
import ReviewStatus from '../../../../components/portal-v2/ReviewStatus.astro';
import { binanceKazakhstanMarketProfile } from '../../../../data/pilots/kz/binanceReview';
import { bybitKazakhstanMarketProfile } from '../../../../data/pilots/kz/bybitReview';
import { okxKazakhstanMarketProfile } from '../../../../data/pilots/kz/okxReview';
import { kazakhstanMethodologyProposal } from '../../../../data/pilots/kz/methodologyProposal';
import { kazakhstanDraftRankingSnapshot } from '../../../../data/pilots/kz/rankingSnapshotDraft';
import {
  kazakhstanMappedEvidenceGaps,
  kazakhstanOpenEvidenceGaps,
  kazakhstanRankingReadiness,
} from '../../../../data/pilots/kz/readiness';

const candidates = [
  {
    slug: 'binance',
    exchange: 'Binance',
    profile: binanceKazakhstanMarketProfile,
    label: 'Validated · limited',
    detail: `${binanceKazakhstanMarketProfile.claimIds.length} claims · offer under review`,
    tone: 'partial' as const,
    evidence: 'Licence, KYC and public P2P route surfaces are mapped; active orders and current direct KZT rails remain unconfirmed.',
    rankingState: 'Draft snapshot · under review',
    reviewHref: '/__design/cbw-v2/market-passport/',
  },
  {
    slug: 'bybit',
    exchange: 'Bybit',
    profile: bybitKazakhstanMarketProfile,
    label: 'Validated · available',
    detail: `${bybitKazakhstanMarketProfile.claimIds.length} claims · offer under review`,
    tone: 'verified' as const,
    evidence: 'AFSA licence, mandatory Standard KYC, dated P2P launch, platform fee and per-ad KZT range are mapped; local offer eligibility remains open.',
    rankingState: 'Draft snapshot · under review',
    reviewHref: null,
  },
  {
    slug: 'okx',
    exchange: 'OKX',
    profile: okxKazakhstanMarketProfile,
    label: 'Validated · conflicting',
    detail: `${okxKazakhstanMarketProfile.claimIds.length} claims · availability unknown`,
    tone: 'review' as const,
    evidence: 'Platform/KZT surfaces are visible, while AFSA warning and regulated-P2P rules retain a local-authorization conflict.',
    rankingState: 'Draft snapshot · excluded',
    reviewHref: null,
  },
];

const gates = [
  {
    label: 'Profile count',
    pass: kazakhstanRankingReadiness.profileCountGate,
    value: `${kazakhstanRankingReadiness.validatedProfileIds.length}/${kazakhstanRankingReadiness.requiredProfileCount}`,
    detail: 'Three validated review profiles are present.',
  },
  {
    label: 'Profile validation',
    pass: kazakhstanRankingReadiness.profileValidationGate,
    value: kazakhstanRankingReadiness.profileValidationGate ? 'PASS' : 'FAIL',
    detail: 'All profiles pass the shared runtime contracts.',
  },
  {
    label: 'Evidence freshness',
    pass: kazakhstanRankingReadiness.evidenceFreshnessGate,
    value: kazakhstanRankingReadiness.evidenceFreshnessGate ? 'PASS' : 'FAIL',
    detail: 'Every profile remains before its next-review timestamp.',
  },
  {
    label: 'Conflict resolution',
    pass: kazakhstanRankingReadiness.conflictResolutionGate,
    value: 'BLOCKED',
    detail: 'OKX remains validated but excluded while the retained authorization conflict is open.',
  },
  {
    label: 'Methodology freeze',
    pass: kazakhstanRankingReadiness.methodologyFrozenGate,
    value: 'FROZEN FOR DRAFT',
    detail: `${kazakhstanMethodologyProposal.version} may assemble only a non-approved snapshot with empty rows.`,
  },
  {
    label: 'Affiliate independence',
    pass: kazakhstanRankingReadiness.affiliateIndependenceGate,
    value: 'PASS · WEIGHT 0',
    detail: 'Affiliate status, promo and CTA cannot create or improve a position.',
  },
  {
    label: 'Owner ranking approval',
    pass: kazakhstanRankingReadiness.ownerApprovalGate,
    value: 'MISSING',
    detail: 'The current snapshot is draft and contains no approved rows or approver.',
  },
  {
    label: 'Public indexability',
    pass: kazakhstanRankingReadiness.publicIndexabilityGate,
    value: 'OFF',
    detail: 'Country ranking remains noindex and review-only.',
  },
];

const p0Gaps = kazakhstanOpenEvidenceGaps.filter(gap => gap.severity === 'P0');
---

<CleanLayout
  title="CBW Portal Factory v2 — Kazakhstan Draft Ranking Snapshot"
  description="Review-only Kazakhstan methodology and empty draft RankingSnapshot backed by three validated market profiles."
  noindex={true}
  bodyClass="cbw-v2-ranking-review"
>
  <main class="page">
    <section class="hero">
      <div class="shell">
        <div class="review-nav">
          <span>Review route · noindex · non-approved snapshot</span>
          <nav aria-label="Portal v2 review routes">
            <a href="/__design/cbw-v2/homepage/">Homepage</a>
            <a href="/__design/cbw-v2/country/">Country hub</a>
            <a href="/__design/cbw-v2/contracts/">Contracts</a>
          </nav>
        </div>

        <p class="eyebrow">Kazakhstan draft RankingSnapshot</p>
        <h1>Methodology frozen. Positions still empty.</h1>
        <p class="lede">
          The owner-approved methodology boundary now permits one governed draft snapshot. It contains no ranked rows: Binance and Bybit remain under review, while OKX remains excluded by the retained authorization conflict.
        </p>

        <div class="snapshot">
          <div><span>Overall ranking state</span><strong>{kazakhstanRankingReadiness.ready ? 'READY' : 'BLOCKED'}</strong></div>
          <ReviewStatus
            label="Draft snapshot · 0 approved rows"
            detail="Conflict resolution, non-empty owner approval and indexability gates remain closed."
            tone="review"
          />
        </div>
      </div>
    </section>

    <section class="content">
      <div class="shell layout">
        <div>
          <header class="section-heading">
            <div>
              <p class="eyebrow">Candidate inventory</p>
              <h2>Snapshot membership is not a ranking</h2>
              <p>Every visible position remains blank. Candidate and exclusion states are controlled by the frozen methodology.</p>
            </div>
            <span class="count">{candidates.length} profiles</span>
          </header>

          <div class="candidate-table" role="table" aria-label="Unranked Kazakhstan profile inventory">
            {candidates.map(candidate => (
              <article class="candidate-row" role="row">
                <div class="identity">
                  <span class="rank-placeholder" aria-label="Not ranked">—</span>
                  <ExchangeLogo slug={candidate.slug} name={candidate.exchange} size={42} variant="square" lazy={false} />
                  <div><strong>{candidate.exchange}</strong><small>{candidate.profile.profileId}</small></div>
                </div>
                <div class="evidence">
                  <ReviewStatus label={candidate.label} detail={candidate.detail} tone={candidate.tone} />
                  <p>{candidate.evidence}</p>
                </div>
                <div class="action">
                  {candidate.reviewHref ? (
                    <a href={candidate.reviewHref}>Open review profile</a>
                  ) : (
                    <span>{candidate.rankingState}</span>
                  )}
                  <small>No affiliate or ranked action</small>
                </div>
              </article>
            ))}
          </div>

          <article class="snapshot-card" data-ranking-snapshot>
            <header>
              <div>
                <p class="eyebrow">Governed draft object</p>
                <h2>RankingSnapshot contract</h2>
              </div>
              <ReviewStatus label="Draft · non-approved" detail="No approvedBy field and no publication authority." tone="review" compact={true} />
            </header>
            <dl>
              <div><dt>Snapshot ID</dt><dd><code>{kazakhstanDraftRankingSnapshot.snapshotId}</code></dd></div>
              <div><dt>Methodology</dt><dd>{kazakhstanDraftRankingSnapshot.methodologyVersion}</dd></div>
              <div><dt>Approval</dt><dd>{kazakhstanDraftRankingSnapshot.approval}</dd></div>
              <div><dt>Ranked rows</dt><dd>{kazakhstanDraftRankingSnapshot.rows.length}</dd></div>
              <div><dt>Under review</dt><dd>{kazakhstanDraftRankingSnapshot.underReviewExchangeIds.join(', ')}</dd></div>
              <div><dt>Excluded</dt><dd>{kazakhstanDraftRankingSnapshot.excludedExchangeIds.join(', ')}</dd></div>
              <div><dt>Evidence checked</dt><dd>{kazakhstanDraftRankingSnapshot.evidenceCheckedAt}</dd></div>
            </dl>
          </article>

          <article class="gate-card">
            <p class="eyebrow">Executable gate matrix</p>
            <div class="gate-grid">
              {gates.map((gate, index) => (
                <div class:list={['gate', { pass: gate.pass }]}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div><strong>{gate.label}</strong><b>{gate.value}</b><p>{gate.detail}</p></div>
                </div>
              ))}
            </div>
          </article>

          <article class="gap-card">
            <header>
              <div><p class="eyebrow">Open P0 evidence and decision gaps</p><h2>What still blocks ordered rows</h2></div>
              <span>{p0Gaps.length} open P0 gaps</span>
            </header>
            <div class="gap-list">
              {p0Gaps.map(gap => (
                <div class="gap-row">
                  <div class="gap-id"><strong>{gap.exchangeId}</strong><span>{gap.topic}</span></div>
                  <p>{gap.currentState}</p>
                  <p><b>Next:</b> {gap.nextAction}</p>
                  <ReviewStatus
                    label={`${gap.severity} · ${gap.status}`}
                    detail={gap.publicationImpact}
                    tone={gap.status === 'blocked' ? 'review' : 'partial'}
                    compact={true}
                  />
                </div>
              ))}
            </div>
          </article>
        </div>

        <aside class="sidebar">
          <article>
            <p class="card-label">Snapshot summary</p>
            <dl>
              <div><dt>Country</dt><dd>KZ</dd></div>
              <div><dt>Profiles</dt><dd>{kazakhstanRankingReadiness.validatedProfileIds.length}/3</dd></div>
              <div><dt>Methodology</dt><dd>frozen</dd></div>
              <div><dt>Draft rows</dt><dd>{kazakhstanDraftRankingSnapshot.rows.length}</dd></div>
              <div><dt>Under review</dt><dd>{kazakhstanDraftRankingSnapshot.underReviewExchangeIds.length}</dd></div>
              <div><dt>Excluded</dt><dd>{kazakhstanDraftRankingSnapshot.excludedExchangeIds.length}</dd></div>
              <div><dt>Open P0 gaps</dt><dd>{p0Gaps.length}</dd></div>
              <div><dt>Mapped gaps</dt><dd>{kazakhstanMappedEvidenceGaps.length}</dd></div>
              <div><dt>Indexability</dt><dd>off</dd></div>
            </dl>
          </article>
          <article class="warning"><strong>Fail-closed by design</strong><p>A frozen methodology can create a review object, but it cannot invent positions or authorize publication.</p></article>
        </aside>
      </div>
    </section>
  </main>
</CleanLayout>

<style>
  :global(body.cbw-v2-ranking-review) { background: #f7f8f4; }
  .page { min-height: 100vh; color: #13233e; background: #f7f8f4; }
  .shell { width: min(1160px, calc(100% - 32px)); margin: 0 auto; }
  .hero { padding: 18px 0 58px; color: #fff; background: radial-gradient(circle at 80% 10%, rgba(247,147,26,.2), transparent 25%), #0e1b30; }
  .review-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 10px 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; color: #c7d2e1; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .review-nav nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .review-nav a { color: #f7b75e; }
  .eyebrow, .card-label { margin: 32px 0 10px; color: #f7931a; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: -.025em; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(48px,8vw,82px); line-height: .92; }
  .lede { max-width: 850px; margin: 22px 0 0; color: #d2ddea; font-size: 16px; line-height: 1.7; }
  .snapshot { display: grid; gap: 16px; align-items: center; margin-top: 28px; padding: 18px; border: 1px solid rgba(255,255,255,.16); border-radius: 14px; background: rgba(255,255,255,.07); }
  .snapshot span, .snapshot strong { display: block; }
  .snapshot span { color: #aebdd0; font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .snapshot strong { margin-top: 5px; font-size: 24px; }
  .content { padding: 70px 0 90px; }
  .layout { display: grid; gap: 24px; }
  .section-heading { display: flex; flex-direction: column; gap: 16px; margin-bottom: 25px; }
  .section-heading .eyebrow, .snapshot-card .eyebrow, .gate-card .eyebrow, .gap-card .eyebrow { margin-top: 0; }
  .section-heading h2, .snapshot-card h2, .gap-card h2 { margin: 0; font-size: clamp(36px,6vw,56px); line-height: .96; }
  .section-heading p:last-child { margin: 10px 0 0; color: #647080; }
  .count { align-self: flex-start; padding: 8px 11px; border-radius: 999px; background: #13233e; color: #fff; font-size: 10px; font-weight: 900; }
  .candidate-table { overflow: hidden; border: 1px solid #d8dfd8; border-radius: 16px; background: #fff; }
  .candidate-row { display: grid; gap: 16px; padding: 18px; border-top: 1px solid #e4e8e3; }
  .candidate-row:first-child { border-top: 0; }
  .identity { display: grid; grid-template-columns: auto auto minmax(0,1fr); gap: 11px; align-items: center; }
  .rank-placeholder { display: grid; width: 30px; height: 30px; place-items: center; border: 1px dashed #bdc7d2; border-radius: 8px; color: #7a8795; font-weight: 900; }
  .identity strong, .identity small { display: block; }
  .identity small { margin-top: 3px; color: #788492; font-size: 9px; overflow-wrap: anywhere; }
  .evidence p { margin: 9px 0 0; color: #697482; font-size: 12px; line-height: 1.55; }
  .action a, .action > span { display: block; padding: 10px 12px; border: 1px solid #d8dde3; border-radius: 9px; background: #f1f3f5; color: #788492; font-size: 12px; font-weight: 900; text-align: center; }
  .action a { border-color: #f0bc73; background: #fff3e2; color: #8a4d00; }
  .action small { display: block; margin-top: 6px; color: #8a939e; font-size: 9px; text-align: center; }
  .snapshot-card, .gate-card, .gap-card { margin-top: 24px; padding: 25px; border-radius: 16px; }
  .snapshot-card, .gap-card { border: 1px solid #d9dfd9; background: #fff; }
  .snapshot-card header, .gap-card header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; align-items: end; }
  .snapshot-card dl { display: grid; gap: 10px; margin: 22px 0 0; }
  .snapshot-card dl div { display: grid; gap: 5px; padding: 12px; border-radius: 10px; background: #f5f7f4; }
  .snapshot-card dt { color: #74808e; font-size: 10px; text-transform: uppercase; font-weight: 900; }
  .snapshot-card dd { margin: 0; color: #13233e; font-size: 12px; font-weight: 900; overflow-wrap: anywhere; }
  .snapshot-card code { color: #925204; }
  .gate-card { color: #fff; background: #13233e; }
  .gate-grid { display: grid; gap: 12px; }
  .gate { display: grid; grid-template-columns: auto 1fr; gap: 10px; padding: 14px; border: 1px solid rgba(255,255,255,.12); border-radius: 11px; background: rgba(255,255,255,.05); }
  .gate > span { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 8px; background: #943b31; color: #fff; font-size: 9px; font-weight: 900; }
  .gate.pass > span { background: #16834b; }
  .gate strong, .gate b { display: block; }
  .gate b { margin-top: 4px; color: #f7b75e; font-size: 10px; }
  .gate p { margin: 6px 0 0; color: #bdc9d8; font-size: 11px; line-height: 1.5; }
  .gap-card header > span { padding: 8px 10px; border-radius: 999px; background: #fff0dc; color: #8a4d00; font-size: 10px; font-weight: 900; }
  .gap-list { display: grid; gap: 10px; margin-top: 22px; }
  .gap-row { display: grid; gap: 10px; padding: 15px; border: 1px solid #e2e6e1; border-radius: 11px; background: #f8faf7; }
  .gap-id { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .gap-id strong { color: #925204; text-transform: uppercase; }
  .gap-id span { color: #677482; font-size: 11px; font-weight: 800; }
  .gap-row p { margin: 0; color: #667280; font-size: 11px; line-height: 1.55; }
  .sidebar { display: grid; align-content: start; gap: 14px; }
  .sidebar article { padding: 18px; border: 1px solid #dce2dc; border-radius: 14px; background: #fff; }
  .sidebar .card-label { margin-top: 0; }
  .sidebar dl { display: grid; gap: 10px; margin: 0; }
  .sidebar dl div { display: flex; justify-content: space-between; gap: 12px; padding-top: 10px; border-top: 1px solid #e6e9e5; }
  .sidebar dt { color: #74808e; font-size: 11px; }
  .sidebar dd { margin: 0; font-size: 11px; font-weight: 900; }
  .sidebar .warning { border-color: #f0cc96; background: #fff8ec; }
  .warning p { margin: 8px 0 0; color: #735d40; font-size: 12px; line-height: 1.6; }
  @media (min-width: 720px) {
    .snapshot { grid-template-columns: 230px 1fr; }
    .section-heading { flex-direction: row; justify-content: space-between; align-items: end; }
    .candidate-row { grid-template-columns: 1.1fr 1.45fr .75fr; }
    .snapshot-card dl { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .gate-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .gap-row { grid-template-columns: .75fr 1.3fr 1.1fr; align-items: start; }
    .gap-row > :last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 980px) { .layout { grid-template-columns: minmax(0,1fr) 290px; } }
</style>