---
export interface Props {
  img: string;
  variant?: 'tall' | 'short';
  class?: string;
}
const { img, variant = 'tall', class: cls = '' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${variant}`, cls]} style={`--ph-img:url('${img}')`}>
  <div class="page-hero__inner">
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background-color: #0a1424;
    background-image: var(--ph-img);
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .page-hero::before,
  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .page-hero::before {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(7,15,28,.98) 0%, rgba(10,20,36,.94) 38%, rgba(13,25,43,.69) 72%, rgba(13,25,43,.26) 100%);
  }
  .page-hero::after {
    z-index: -1;
    background:
      radial-gradient(circle at 18% 10%, rgba(247,147,26,.18), transparent 31%),
      linear-gradient(180deg, transparent 72%, rgba(4,10,18,.28) 100%);
  }

  .page-hero--tall { min-height: 270px; }
  .page-hero--short { min-height: 245px; }

  .page-hero__inner {
    position: relative;
    width: min(var(--cbw-page-max, 1180px), 100%);
    margin: 0 auto;
    padding: 42px 20px;
  }

  .page-hero :global(.ph-content) { max-width: 680px; }
  .page-hero :global(.ph-eyebrow) {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    margin: 0 0 16px;
    padding: 0 11px;
    border: 1px solid rgba(247,147,26,.34);
    border-radius: 999px;
    color: #f7b45a;
    background: rgba(247,147,26,.1);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .page-hero :global(.ph-title) {
    max-width: 760px;
    margin: 0 0 16px;
    color: #fff;
    font-family: 'Barlow Condensed', 'Inter', sans-serif;
    font-size: clamp(42px, 7vw, 70px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: .96;
    text-transform: uppercase;
  }
  .page-hero :global(.ph-sub) {
    max-width: 630px;
    margin: 0 0 10px;
    color: rgba(255,255,255,.78);
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1.68;
  }
  .page-hero :global(.ph-caveat) {
    max-width: 620px;
    margin: 8px 0 0;
    color: rgba(255,255,255,.48);
    font-size: 12px;
    line-height: 1.6;
  }
  .page-hero :global(.ph-content a) {
    color: #f7b45a;
    text-decoration: underline;
    text-decoration-color: rgba(247,180,90,.48);
    text-underline-offset: 3px;
  }
  .page-hero :global(.ph-content a:hover),
  .page-hero :global(.ph-content a:focus-visible) { color: #ffd39a; }

  .page-hero :global(.ph-updated) {
    margin: 14px 0 0;
    color: rgba(255,255,255,.43);
    font-size: 11px;
  }
  .page-hero :global(.ph-updated time) { color: rgba(255,255,255,.62); }

  .page-hero :global(.ph-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .page-hero :global(.ph-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 999px;
    color: rgba(255,255,255,.81);
    background: rgba(255,255,255,.055);
    font-size: 11px;
    font-weight: 800;
  }
  .page-hero :global(.ph-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  @media (min-width: 640px) {
    .page-hero--tall { min-height: 330px; }
    .page-hero--short { min-height: 300px; }
    .page-hero__inner { padding: 54px 24px; }
  }

  @media (min-width: 900px) {
    .page-hero--tall { min-height: 360px; }
    .page-hero--short { min-height: 330px; }
    .page-hero__inner { padding: 66px 32px; }
  }

  @media (max-width: 639px) {
    .page-hero { background-position: center right -70px; }
    .page-hero::before {
      background: linear-gradient(90deg, rgba(7,15,28,.98) 0%, rgba(10,20,36,.93) 58%, rgba(10,20,36,.72) 100%);
    }
    .page-hero :global(.ph-title) { font-size: clamp(38px, 13vw, 52px); }
    .page-hero :global(.ph-chip) { font-size: 10px; }
  }
</style>
