---
import CleanLayout from '../layouts/CleanLayout.astro';
import HomepageTop10 from '../components/home/HomepageTop10.astro';
import PageFrame from '../components/site-standard/PageFrame.astro';
import Container from '../components/site-standard/Container.astro';
---

<CleanLayout
  title="Best Crypto Exchanges by Country | CryptoBonusWorld"
  description="Choose your country and compare CryptoBonusWorld's governed Top 10 crypto exchanges with country and evidence status kept separate."
  ogImage="/og-default.png"
  bodyClass="cbw-homepage-ranking-first"
>
  <PageFrame family="homepage" class="homepage-product">
    <section class="market-hero" aria-labelledby="home-title" data-home-market>
      <Container size="wide" class="market-hero-inner">
        <div class="market-context">
          <p class="kicker">Your market</p>
          <div class="market-identity" aria-live="polite">
            <span class="market-flag" aria-hidden="true" data-home-country-flag>🌍</span>
            <div>
              <strong data-home-country-name>General</strong>
              <span data-home-country-code>Global context</span>
            </div>
          </div>
        </div>

        <div class="market-copy">
          <p class="kicker">Ranking first · country aware</p>
          <h1 id="home-title">Top crypto exchanges to compare</h1>
          <p data-home-ranking-note>
            Choose a country in the header. The Top 10 stays global until a local ranking is approved.
          </p>
          <div class="market-actions">
            <a href="#exchanges">View Top 10 ↓</a>
            <span data-home-ranking-state>Global governed ranking</span>
          </div>
        </div>
      </Container>
    </section>

    <HomepageTop10 />

    <section class="trust-strip" aria-label="Ranking safeguards">
      <Container size="wide" class="trust-grid">
        <article><strong>Country-aware</strong><span>Country context is not proof of availability.</span></article>
        <article><strong>Evidence-bound</strong><span>Unknown or stale facts stay under review.</span></article>
        <article><strong>Affiliate-separated</strong><span>Commercial links cannot create rank or country truth.</span></article>
        <a href="/methodology/">How we verify →</a>
      </Container>
    </section>

    <section class="quick-links">
      <Container size="wide" class="quick-grid">
        <a href="/exchanges/"><strong>All exchanges</strong><span>Directory →</span></a>
        <a href="/countries/kazakhstan/"><strong>🇰🇿 Kazakhstan</strong><span>Market preview →</span></a>
        <a href="/promo-codes/"><strong>Promo codes</strong><span>Offer status →</span></a>
      </Container>
    </section>

    <section class="disclosure">
      <Container size="prose">
        <p><strong>Disclosure:</strong> CryptoBonusWorld may earn a commission from approved links. This does not affect ranking or country evidence. <a href="/affiliate-disclosure/">Details</a>.</p>
      </Container>
    </section>
  </PageFrame>
</CleanLayout>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-home-market]');
    if (!root) return;
    function syncMarket() {
      var header = document.querySelector('[data-site-header]');
      if (!header) return;
      var countryCode = header.dataset.countryContext || 'global';
      var headerFlag = header.querySelector('[data-country-summary] [data-country-flag]');
      var headerName = header.querySelector('[data-country-name]');
      var flag = root.querySelector('[data-home-country-flag]');
      var name = root.querySelector('[data-home-country-name]');
      var code = root.querySelector('[data-home-country-code]');
      var note = root.querySelector('[data-home-ranking-note]');
      var state = root.querySelector('[data-home-ranking-state]');
      var countryName = headerName && headerName.textContent ? headerName.textContent.trim() : 'General';
      if (flag) flag.textContent = headerFlag && headerFlag.textContent ? headerFlag.textContent.trim() : '🌍';
      if (name) name.textContent = countryName;
      if (countryCode === 'global') {
        if (code) code.textContent = 'Global context';
        if (state) state.textContent = 'Global governed ranking';
        if (note) note.textContent = 'Choose a country in the header. The Top 10 stays global until a local ranking is approved.';
      } else {
        if (code) code.textContent = countryCode + ' · active market';
        if (state) state.textContent = 'Local ranking under review';
        if (note) note.textContent = countryName + ' is your active market. The list below remains the global Top 10 until a local ranking is approved.';
      }
    }
    syncMarket();
    document.addEventListener('cbw:country-context-change', syncMarket);
    window.addEventListener('pageshow', syncMarket);
  })();
</script>

<style>
  :global(body.cbw-homepage-ranking-first) { background: #f6f7f3; }
  .homepage-product { color: #13233e; background: #f6f7f3; }
  .market-hero { color: #fff; background: radial-gradient(circle at 85% 12%,rgba(247,147,26,.22),transparent 28%),linear-gradient(135deg,#0a1424,#142945 72%,#1d385c); }
  .market-hero-inner { display: grid; grid-template-columns: minmax(220px,.7fr) minmax(0,1.5fr); gap: 28px; align-items: center; padding-block: 24px 26px; }
  .kicker { margin: 0 0 7px; color: #f7b04a; font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .market-identity { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .market-flag { display: inline-flex; width: 58px; height: 58px; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.16); border-radius: 16px; background: rgba(255,255,255,.08); font-size: 38px; }
  .market-identity strong { display: block; max-width: 230px; overflow: hidden; color: #fff; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(30px,3vw,40px); line-height: .95; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
  .market-identity div > span { display: block; margin-top: 5px; color: #aebdd0; font-size: 10px; font-weight: 800; text-transform: uppercase; }
  .market-copy h1 { max-width: 760px; margin: 0; color: #fff; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(42px,5.8vw,68px); line-height: .9; text-transform: uppercase; }
  .market-copy > p:not(.kicker) { max-width: 720px; margin: 10px 0 0; color: #cbd6e4; font-size: 13px; line-height: 1.5; }
  .market-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 13px; }
  .market-actions a,.market-actions span { display: inline-flex; min-height: 34px; align-items: center; padding: 0 12px; border-radius: 999px; font-size: 10px; font-weight: 900; }
  .market-actions a { color: #13233e; background: #f7931a; }
  .market-actions span { border: 1px solid rgba(255,255,255,.15); color: #d8e1ec; background: rgba(255,255,255,.055); }
  .trust-strip { padding: 20px 0; border-block: 1px solid #dde3dc; background: #fff; }
  .trust-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)) auto; gap: 14px; align-items: center; }
  .trust-grid article { display: grid; gap: 2px; }
  .trust-grid strong { font-size: 12px; }
  .trust-grid span { color: #667386; font-size: 10px; line-height: 1.45; }
  .trust-grid > a { color: #925204; font-size: 11px; font-weight: 900; white-space: nowrap; }
  .quick-links { padding: 16px 0; }
  .quick-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
  .quick-grid a { padding: 13px 15px; border: 1px solid #dce3dc; border-radius: 12px; background: #fff; }
  .quick-grid strong { display: block; font-size: 12px; }
  .quick-grid span { color: #718095; font-size: 10px; }
  .disclosure { padding: 8px 0 22px; color: #778394; }
  .disclosure p { margin: 0; font-size: 9px; line-height: 1.6; }
  .disclosure a { color: #925204; font-weight: 800; text-decoration: underline; }
  @media (max-width: 820px) {
    .market-hero-inner { grid-template-columns: 1fr; gap: 16px; padding-block: 18px 20px; }
    .market-context > .kicker { display: none; }
    .market-flag { width: 48px; height: 48px; font-size: 32px; }
    .market-identity strong { font-size: 30px; }
    .market-copy h1 { font-size: clamp(40px,12vw,56px); }
    .trust-grid,.quick-grid { grid-template-columns: 1fr; }
  }
</style>
