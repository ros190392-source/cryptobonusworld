{
  "schemaVersion": "cbw-sitewide-layout-route-matrix-v2",
  "status": "AUDIT_ONLY",
  "governingIssue": 201,
  "containerStandard": {
    "shell": 1200,
    "wide": 1120,
    "content": 960,
    "prose": 760,
    "gutters": {
      "mobile": 20,
      "tablet": 24,
      "desktop": 32
    },
    "rawPublicMaxWidthAllowed": false
  },
  "firstViewportRules": {
    "homepage": {
      "desktop": {
        "viewport": "1440x900",
        "required": ["header", "compactHero", "rankingHeading", "twoCompleteRankingRows"]
      },
      "mobile": {
        "viewport": "390x844",
        "required": ["header", "compactHero", "countryLanguageContext", "rankingHeading", "firstRankingRowVisible"]
      },
      "forbiddenBeforeRanking": ["pathwayCards", "countryDiscovery", "trustBlocks", "updates", "guides", "faq"]
    },
    "exchangeProfile": {
      "required": ["exchangeIdentity", "offerOrEvidenceState", "primaryActionBoundary", "firstFactsOrContentBlock"]
    },
    "directoryComparison": {
      "required": ["pagePurpose", "firstLiveCardOrTableRow"]
    },
    "editorialLegal": {
      "required": ["pagePurpose", "firstSubstantiveSection"]
    },
    "countryReview": {
      "required": ["countryOrExchangeIdentity", "reviewState", "firstEvidenceOrReadinessBlock"]
    }
  },
  "families": [
    {
      "id": "homepage",
      "routes": ["/"],
      "containerRoles": ["shell", "wide", "prose"],
      "currentState": "FAIL_FIRST_VIEWPORT",
      "targetTemplate": "HomepageTemplateV3"
    },
    {
      "id": "exchange-primary",
      "routes": ["/bybit/", "/mexc/", "/okx/", "/bitget/", "/kucoin/", "/bingx/"],
      "containerRoles": ["shell", "content", "prose"],
      "currentState": "OVERRIDE_NORMALIZED_LEGACY_DOM",
      "targetTemplate": "ExchangeProfileTemplateV3"
    },
    {
      "id": "exchange-generic",
      "routes": [
        "/coinex/",
        "/exchanges/bybit/",
        "/exchanges/mexc/",
        "/exchanges/okx/",
        "/exchanges/bitget/",
        "/exchanges/kucoin/",
        "/exchanges/bingx/",
        "/exchanges/coinex/",
        "/exchanges/gate-io/",
        "/exchanges/htx/",
        "/exchanges/phemex/",
        "/exchanges/bitunix/",
        "/exchanges/binance/",
        "/exchanges/coinbase/"
      ],
      "containerRoles": ["shell", "content", "prose"],
      "currentState": "MIXED_COMPONENT_AND_STUB_CONTRACTS",
      "targetTemplate": "ExchangeProfileTemplateV3"
    },
    {
      "id": "directory-comparison",
      "routes": ["/exchanges/", "/promo-codes/"],
