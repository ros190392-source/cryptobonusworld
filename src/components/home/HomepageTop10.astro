---
import ExchangeLogo from '../ExchangeLogo.astro';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';
import { buildHomepageTop10 } from '../../data/homepageTop10';
import '../../styles/site-standard-v1.css';
import { resolveHomepageTop10Ctas } from '../../data/homepageTop10Cta';
import { gateReasonText, ctaMicrocopy, pickLocalized } from '../../data/contracts/portalCtaI18n';
import type { CtaLocale } from '../../data/contracts/portalCta';
import Top10Disclosure from './Top10Disclosure.astro';
import { resolveDisclosure } from '../../data/contracts/portalDisclosure';
import { getOffer } from '../../data/offers';
import { resolvePublicOfferView } from '../../data/publicOfferView';
import { resolvePublicCommercialRoute } from '../../data/publicCommercialRoute';

const ctaLocale: CtaLocale = 'en';
const nowMs = Date.now();
const homepageTop10 = buildHomepageTop10(nowMs);

const commercialPromoCodes = new Map(
  homepageTop10.map((entry) => {
    const route = resolvePublicCommercialRoute(entry.slug, nowMs);
    return [entry.slug, route.promoCodeAuthority === 'owner_confirmed' ? route.promoCode : null] as const;
  }),
);

const ctaBindings = new Map(
  resolveHomepageTop10Ctas(homepageTop10, ctaLocale, { now: nowMs }).map((binding) => [binding.rank, binding]),
);

const opensNewTab = pickLocalized(ctaMicrocopy.opensNewTab, ctaLocale);
const loadingText = pickLocalized(ctaMicrocopy.loading, ctaLocale);

const disclosures = new Map(
  homepageTop10.map((entry) => {
    const offer = getOffer(entry.slug);
    const binding = ctaBindings.get(entry.rank);
    const view = offer ? resolvePublicOfferView(entry.slug, nowMs) : null;
    const officialHref = view?.isCommercial ? offer?.sourceUrl : undefined;
    return [entry.rank, resolveDisclosure({
      tone: entry.statusTone,
      evidence: entry.evidence ?? null,
      expectedExchangeId: entry.slug,
      now: nowMs,
      isAffiliate: Boolean(binding?.primary.isAffiliate),
      methodologyHref: '/methodology/',
      officialHref,
    }, ctaLocale)] as const;
  }),
);
---

<section class="top10-section" id="exchanges" aria-labelledby="top10-title" data-cta-loading-text={loadingText}>
  <div class="top10-wrap">
    <header class="top10-heading">
      <div>
        <span class="top10-label">10 governed exchange profiles</span>
        <h2 id="top10-title">Top 10 crypto exchanges</h2>
        <p>Start with the card. Open evidence only when you need the detail.</p>
      </div>
      <a href="/exchanges/" class="top10-directory-link">All exchanges →</a>
    </header>

    <ol class="exchange-card-grid">
      {homepageTop10.map((entry) => {
        const cta = ctaBindings.get(entry.rank);
        const primary = cta?.primary;
        const promoCode = commercialPromoCodes.get(entry.slug);
        const disclosure = disclosures.get(entry.rank);
        return (
          <li class="exchange-card" data-rank={entry.rank} data-exchange-slug={entry.slug}>
            <div class="card-head">
              <span class="rank-badge" aria-label={`Rank ${entry.rank}`}>#{entry.rank}</span>
              <ExchangeLogo
                slug={entry.slug}
                name={entry.name}
                size={52}
                variant="square"
                lazy={entry.rank > 4}
                class="card-logo"
              />
              <div class="exchange-name">
                <h3>{entry.name}</h3>
                <span class:list={['status-badge', `status-${entry.statusTone}`]}>{entry.statusLabel}</span>
              </div>
            </div>

            <div class="card-fit">
              <span>Best for</span>
              <strong>{entry.bestFor}</strong>
            </div>

            <p class="card-summary">{entry.summary}</p>

            {promoCode && (
              <div class="card-code">
                <span>Owner-confirmed code</span>
                <PromoCodeCopy code={promoCode} exchange={entry.name} />
              </div>
            )}

            <div class="card-actions">
              {primary && (() => {
                const stateClass = `top10-primary--${primary.visualState}`;
                if (primary.disabled) {
                  const reason = gateReasonText(primary.gateReason, ctaLocale);
                  return (
                    <button
                      type="button"
                      class:list={['top10-primary', 'top10-primary--disabled', stateClass]}
                      disabled
                      aria-label={`${primary.label} at ${entry.name}: ${reason}`}
                    >
                      <span>{primary.label}</span>
                      <small>{reason}</small>
                    </button>
                  );
                }
                const accessibleName = primary.isAffiliate
                  ? `${primary.label} at ${entry.name} (${opensNewTab})`
                  : `${primary.label} — ${entry.name}`;
                return (
                  <a
                    href={primary.href}
                    class:list={['top10-primary', stateClass, { 'is-affiliate': primary.isAffiliate }]}
                    data-cta-affiliate={primary.isAffiliate ? 'true' : undefined}
                    target={primary.isAffiliate ? '_blank' : undefined}
                    rel={primary.isAffiliate ? primary.rel : 'noopener'}
                    aria-label={accessibleName}
                  >
                    <span class="top10-primary-label">{primary.label} →</span>
                    <span class="top10-primary-spinner" aria-hidden="true"></span>
                  </a>
                );
              })()}
              {cta && (
                <a href={cta.secondaryHref} class="top10-secondary" rel="noopener">{cta.secondaryLabel}</a>
              )}
            </div>

            {disclosure && (
              <details class="evidence-details">
                <summary>Evidence &amp; checks <span aria-hidden="true">+</span></summary>
                <div class="evidence-content"><Top10Disclosure model={disclosure} /></div>
              </details>
            )}
          </li>
        );
      })}
    </ol>

    <div class="top10-method">
      <strong>Ranking note:</strong> this is the current global governed comparison. Country context and local eligibility stay separate until an approved local ranking exists.
      <a href="/methodology/">Methodology →</a>
    </div>

    <span class="top10-sr-only" data-cta-live role="status" aria-live="polite"></span>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById('exchanges');
    if (!section) return;
    var loadingText = section.getAttribute('data-cta-loading-text') || 'Opening…';
    var live = section.querySelector('[data-cta-live]');
    var RESET_MS = 1400;
    function reset(el) {
      el.classList.remove('is-loading');
      el.removeAttribute('aria-busy');
      if (live) live.textContent = '';
    }
    function resetAll() {
      section.querySelectorAll('.top10-primary.is-loading').forEach(reset);
    }
    section.querySelectorAll('.top10-primary[data-cta-affiliate="true"]').forEach(function (el) {
      var timer = null;
      el.addEventListener('click', function (e) {
        if (el.classList.contains('is-loading')) { e.preventDefault(); return; }
        el.classList.add('is-loading');
        el.setAttribute('aria-busy', 'true');
        if (live) live.textContent = loadingText;
        clearTimeout(timer);
        timer = setTimeout(function () { reset(el); }, RESET_MS);
      });
    });
    window.addEventListener('pageshow', resetAll);
    window.addEventListener('focus', resetAll);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') resetAll();
    });
  })();
</script>

<style>
  .top10-section { padding: 18px 0 28px; background: #f6f7f3; }
  .top10-wrap { width: 100%; max-width: var(--cbw-width-wide,1180px); margin: 0 auto; padding-inline: var(--cbw-gutter,20px); }
  .top10-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 12px; }
  .top10-label { display: block; margin-bottom: 4px; color: #b86205; font-size: 9px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .top10-heading h2 { margin: 0; color: #13233e; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: clamp(30px,4vw,42px); line-height: .96; text-transform: uppercase; }
  .top10-heading p { margin: 5px 0 0; color: #667386; font-size: 11px; }
  .top10-directory-link { color: #925204; font-size: 11px; font-weight: 900; white-space: nowrap; }

  .exchange-card-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .exchange-card { min-width: 0; padding: 15px; border: 1px solid #dce3dc; border-radius: 15px; background: #fff; box-shadow: 0 2px 8px rgba(19,35,62,.04); }
  .exchange-card:hover { border-color: #c6d0c6; box-shadow: 0 8px 24px rgba(19,35,62,.08); }
  .card-head { display: grid; grid-template-columns: auto 52px minmax(0,1fr); gap: 10px; align-items: center; }
  .rank-badge { display: inline-flex; min-width: 38px; height: 30px; align-items: center; justify-content: center; border-radius: 999px; color: #fff; background: #13233e; font-size: 11px; font-weight: 900; }
  .exchange-card[data-rank='1'] .rank-badge { color: #13233e; background: #f7931a; }
  .exchange-name { min-width: 0; }
  .exchange-name h3 { margin: 0 0 5px; overflow: hidden; color: #13233e; font-family: 'Barlow Condensed','Inter',sans-serif; font-size: 25px; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
  .status-badge { display: inline-flex; max-width: 100%; min-height: 22px; align-items: center; padding: 0 8px; border-radius: 999px; font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .status-verified { color: #12653b; background: #e8f6ed; }
  .status-preview { color: #875000; background: #fff0d7; }
  .status-research { color: #245b8f; background: #e7f0fa; }
  .status-review { color: #596579; background: #edf0f3; }

  .card-fit { display: grid; gap: 3px; margin-top: 13px; padding: 10px 11px; border-radius: 10px; background: #f5f7f4; }
  .card-fit span,.card-code > span { color: #778394; font-size: 8px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .card-fit strong { color: #263750; font-size: 11px; line-height: 1.4; }
  .card-summary { min-height: 34px; margin: 10px 0 0; color: #667386; font-size: 10px; line-height: 1.5; }
  .card-code { display: grid; gap: 6px; margin-top: 10px; }
  .card-code :global(.pcc-row) { max-width: 100%; }

  .card-actions { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; margin-top: 13px; }
  .top10-primary,.top10-secondary { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; border-radius: 10px; font-size: 10px; font-weight: 900; text-align: center; }
  .top10-primary { gap: 6px; padding: 0 12px; border: 1px solid #e17c08; color: #13233e; background: #f7931a; }
  .top10-primary:hover { background: #ffac43; }
  .top10-primary--disabled { display: grid; gap: 1px; border-color: #dce3dc; color: #596579; background: #edf0f3; cursor: not-allowed; }
  .top10-primary--disabled small { font-size: 7px; font-weight: 700; }
  .top10-secondary { padding: 0 11px; border: 1px solid #d5ddd5; color: #46556a; background: #fff; }
  .top10-secondary:hover { background: #f5f7f4; }
  .top10-primary-spinner { display: none; width: 12px; height: 12px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }
  .top10-primary.is-loading .top10-primary-label { opacity: .55; }
  .top10-primary.is-loading .top10-primary-spinner { display: inline-block; }

  .evidence-details { margin-top: 10px; border-top: 1px solid #e4e9e4; }
  .evidence-details summary { display: flex; min-height: 36px; align-items: center; justify-content: space-between; color: #667386; font-size: 9px; font-weight: 900; cursor: pointer; list-style: none; }
  .evidence-details summary::-webkit-details-marker { display: none; }
  .evidence-details[open] summary span { transform: rotate(45deg); }
  .evidence-content { padding: 0 0 5px; }

  .top10-method { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; margin-top: 12px; padding: 10px 12px; border: 1px solid #dce3dc; border-radius: 10px; color: #718095; background: #fff; font-size: 9px; line-height: 1.5; }
  .top10-method strong { color: #34455d; }
  .top10-method a { margin-left: auto; color: #925204; font-weight: 900; white-space: nowrap; }
  .top10-sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 850px) {
    .exchange-card-grid { grid-template-columns: 1fr; }
    .top10-heading { align-items: start; }
  }
  @media (max-width: 520px) {
    .top10-section { padding-top: 14px; }
    .top10-heading { display: grid; gap: 6px; }
    .top10-heading h2 { font-size: 32px; }
    .top10-directory-link { justify-self: start; }
    .exchange-card { padding: 13px; }
    .card-head { grid-template-columns: auto 46px minmax(0,1fr); }
    .exchange-name h3 { font-size: 23px; }
    .card-actions { grid-template-columns: 1fr; }
    .top10-secondary { width: 100%; }
  }
</style>
