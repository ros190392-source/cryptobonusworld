---
import CleanLayout from '../../../../layouts/CleanLayout.astro';
import ExchangeLogo from '../../../../components/ExchangeLogo.astro';
import ReviewStatus from '../../../../components/portal-v2/ReviewStatus.astro';
import {
  kazakhstanComparativeMatrix,
  type KazakhstanComparisonDimension,
  type KazakhstanComparisonState,
} from '../../../../data/pilots/kz/comparativeMatrix';

const exchangeNames = {
  binance: 'Binance',
  bybit: 'Bybit',
  okx: 'OKX',
} as const;

const dimensionNames: Record<KazakhstanComparisonDimension, string> = {
  kyc_account_access: 'KYC & account access',
  kzt_fiat_p2p: 'KZT, fiat & P2P',
  product_coverage: 'Product coverage',
  fees_limits: 'Fees & limits',
  conflicts_freshness: 'Conflicts & freshness',
};

const stateLabels: Record<KazakhstanComparisonState, string> = {
  mapped: 'Mapped',
  partial: 'Partial',
  missing: 'Missing',
  conflicting: 'Conflicting',
};

const stateTones: Record<KazakhstanComparisonState, 'verified' | 'partial' | 'missing' | 'review'> = {
  mapped: 'verified',
  partial: 'partial',
  missing: 'missing',
  conflicting: 'review',
};

const getCell = (dimension: KazakhstanComparisonDimension, exchangeId: 'binance' | 'bybit' | 'okx') => {
  const cell = kazakhstanComparativeMatrix.cells.find(
    item => item.dimension === dimension && item.exchangeId === exchangeId,
  );
  if (!cell) throw new Error(`Missing matrix cell ${exchangeId}/${dimension}`);
  return cell;
};
---

<CleanLayout
  title="CBW Portal Factory v2 — Kazakhstan Comparative Evidence Matrix"
  description="Review-only evidence completeness matrix for Kazakhstan exchange research."
  noindex={true}
  bodyClass="cbw-v2-comparative-matrix"
>
  <main class="matrix-page">
    <section class="hero">
      <div class="shell">
        <div class="review-nav">
          <span>Review route · noindex · no scoring</span>
          <nav aria-label="Portal v2 review routes">
            <a href="/__design/cbw-v2/country-ranking/">Draft snapshot</a>
            <a href="/__design/cbw-v2/market-passport/">Market passport</a>
            <a href="/__design/cbw-v2/contracts/">Contracts</a>
          </nav>
        </div>

        <p class="eyebrow">Kazakhstan comparative ordering evidence</p>
        <h1>Compare completeness, not winners.</h1>
        <p class="lede">
          This matrix exposes mapped, partial, missing and conflicting evidence across the five required ordering dimensions. Missing data stays missing. No score, rank or affiliate value exists.
        </p>

        <div class="hero-grid">
          <div><span>Matrix cells</span><strong>{kazakhstanComparativeMatrix.cells.length}</strong></div>
          <div><span>Aggregate scoring</span><strong>OFF</strong></div>
          <div><span>Ordering ready</span><strong>NO</strong></div>
          <div><span>Ranking positions</span><strong>0</strong></div>
        </div>
      </div>
    </section>

    <section class="content">
      <div class="shell">
        <header class="section-heading">
          <div>
            <p class="eyebrow">Five dimensions × three exchanges</p>
            <h2>Every non-missing cell resolves to validated claims</h2>
            <p>Cells describe evidence completeness only. They do not award points or imply that one exchange is better.</p>
          </div>
          <ReviewStatus
            label="Ordering disabled"
            detail="Required dimensions remain partial, missing or conflicting."
            tone="review"
          />
        </header>

        <div class="matrix" role="table" aria-label="Kazakhstan comparative evidence matrix">
          <div class="matrix-head" role="row">
            <span>Dimension</span>
            {kazakhstanComparativeMatrix.exchanges.map(exchangeId => (
              <div class="exchange-head">
                <ExchangeLogo slug={exchangeId} name={exchangeNames[exchangeId]} size={30} variant="square" lazy={false} />
                <strong>{exchangeNames[exchangeId]}</strong>
              </div>
            ))}
          </div>

          {kazakhstanComparativeMatrix.dimensions.map(dimension => (
            <section class="matrix-row" role="row" data-dimension={dimension}>
              <div class="dimension-cell">
                <span>Dimension</span>
                <strong>{dimensionNames[dimension]}</strong>
                {(() => {
                  const summary = kazakhstanComparativeMatrix.dimensionSummaries.find(item => item.dimension === dimension);
                  return summary ? (
                    <small>{summary.mapped} mapped · {summary.partial} partial · {summary.missing} missing · {summary.conflicting} conflicting</small>
                  ) : null;
                })()}
              </div>

              {kazakhstanComparativeMatrix.exchanges.map(exchangeId => {
                const cell = getCell(dimension, exchangeId);
                return (
                  <article class:list={['evidence-cell', `state-${cell.state}`]} data-cell-id={cell.cellId}>
                    <div class="mobile-exchange">
                      <ExchangeLogo slug={exchangeId} name={exchangeNames[exchangeId]} size={26} variant="square" lazy={false} />
                      <strong>{exchangeNames[exchangeId]}</strong>
                    </div>
                    <ReviewStatus
                      label={stateLabels[cell.state]}
                      detail={`${cell.evidenceClaimIds.length} evidence claims`}
                      tone={stateTones[cell.state]}
                      compact={true}
                    />
                    <p>{cell.summary}</p>
                    <div class="cell-meta">
                      <span>Checked {cell.checkedAt.slice(0, 10)}</span>
                      <span>Review {cell.nextReviewAt.slice(0, 10)}</span>
                    </div>
                    {cell.evidenceClaimIds.length > 0 ? (
                      <details>
                        <summary>Evidence IDs</summary>
                        <ul>{cell.evidenceClaimIds.map(claimId => <li><code>{claimId}</code></li>)}</ul>
                      </details>
                    ) : (
                      <div class="missing-note">No normalized comparable claim is mapped.</div>
                    )}
                  </article>
                );
              })}
            </section>
          ))}
        </div>

        <section class="boundaries">
          <article>
            <p class="eyebrow">Hard boundary</p>
            <h2>No score is a feature</h2>
            <p>Partial, missing and conflicting cells prevent aggregate scoring. The matrix cannot silently replace missing evidence with zero or an availability assumption.</p>
          </article>
          <dl>
            <div><dt>Matrix ID</dt><dd><code>{kazakhstanComparativeMatrix.matrixId}</code></dd></div>
            <div><dt>Methodology</dt><dd>{kazakhstanComparativeMatrix.methodologyVersion}</dd></div>
            <div><dt>Status</dt><dd>{kazakhstanComparativeMatrix.status}</dd></div>
            <div><dt>Scoring enabled</dt><dd>no</dd></div>
            <div><dt>Order authorized</dt><dd>no</dd></div>
            <div><dt>Ordering ready</dt><dd>no</dd></div>
          </dl>
        </section>
      </div>
    </section>
  </main>
</CleanLayout>

<style>
  :global(body.cbw-v2-comparative-matrix) { background: #f7f8f4; }
  .matrix-page { min-height: 100vh; color: #13233e; background: #f7f8f4; }
  .shell { width: min(1240px, calc(100% - 32px)); margin: 0 auto; }
  .hero { padding: 18px 0 60px; color: #fff; background: radial-gradient(circle at 83% 12%, rgba(247,147,26,.22), transparent 27%), linear-gradient(135deg,#0c1729,#19375a); }
  .review-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 10px 13px; border: 1px solid rgba(255,255,255,.14); border-radius: 10px; color: #c7d2e1; font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .review-nav nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .review-nav a { color: #f7b75e; }
  .eyebrow { margin: 32px 0 10px; color: #f7931a; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: -.025em; }
  h1 { max-width: 900px; margin: 0; font-size: clamp(48px,8vw,82px); line-height: .92; }
  .lede { max-width: 850px; margin: 22px 0 0; color: #d2ddea; font-size: 16px; line-height: 1.7; }
  .hero-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin-top: 28px; }
  .hero-grid div { padding: 14px; border: 1px solid rgba(255,255,255,.14); border-radius: 11px; background: rgba(255,255,255,.07); }
  .hero-grid span, .hero-grid strong { display: block; }
  .hero-grid span { color: #b8c7d8; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .hero-grid strong { margin-top: 5px; font-size: 21px; }
  .content { padding: 70px 0 90px; }
  .section-heading { display: grid; gap: 18px; align-items: end; margin-bottom: 26px; }
  .section-heading .eyebrow, .boundaries .eyebrow { margin-top: 0; }
  .section-heading h2, .boundaries h2 { margin: 0; font-size: clamp(36px,5vw,54px); line-height: .96; }
  .section-heading p:last-child { max-width: 760px; margin: 10px 0 0; color: #647080; line-height: 1.6; }
  .matrix { overflow: hidden; border: 1px solid #d9dfd9; border-radius: 16px; background: #fff; }
  .matrix-head { display: none; background: #13233e; color: #fff; }
  .exchange-head { display: flex; gap: 9px; align-items: center; padding: 13px; }
  .matrix-row { display: grid; gap: 0; border-top: 1px solid #e3e7e2; }
  .matrix-row:first-of-type { border-top: 0; }
  .dimension-cell { padding: 17px; background: #eef2ec; }
  .dimension-cell > span { display: block; color: #71808d; font-size: 8px; font-weight: 900; text-transform: uppercase; }
  .dimension-cell strong { display: block; margin-top: 4px; font-size: 15px; }
  .dimension-cell small { display: block; margin-top: 6px; color: #6c7884; font-size: 9px; line-height: 1.45; }
  .evidence-cell { min-width: 0; padding: 16px; border-top: 1px solid #e5e9e4; }
  .evidence-cell p { margin: 10px 0 0; color: #5f6c7a; font-size: 11px; line-height: 1.55; }
  .state-conflicting { background: #fff8ec; }
  .state-missing { background: #f3f4f5; }
  .mobile-exchange { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
  .cell-meta { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 11px; }
  .cell-meta span { padding: 5px 7px; border-radius: 999px; background: #eef1ed; color: #687482; font-size: 8px; font-weight: 800; }
  details { margin-top: 11px; }
  summary { cursor: pointer; color: #925204; font-size: 9px; font-weight: 900; text-transform: uppercase; }
  details ul { display: grid; gap: 5px; margin: 8px 0 0; padding-left: 17px; }
  details code { overflow-wrap: anywhere; color: #5e6975; font-size: 8px; }
  .missing-note { margin-top: 11px; padding: 9px; border: 1px dashed #c8ced4; border-radius: 8px; color: #78828d; font-size: 9px; }
  .boundaries { display: grid; gap: 20px; margin-top: 24px; padding: 25px; border-radius: 16px; color: #fff; background: #13233e; }
  .boundaries p:last-child { color: #bdc9d8; line-height: 1.6; }
  .boundaries dl { display: grid; gap: 9px; margin: 0; }
  .boundaries dl div { display: flex; justify-content: space-between; gap: 12px; padding-top: 9px; border-top: 1px solid rgba(255,255,255,.12); }
  .boundaries dt { color: #9fb0c4; font-size: 9px; }
  .boundaries dd { margin: 0; font-size: 9px; font-weight: 900; text-align: right; overflow-wrap: anywhere; }
  .boundaries code { color: #f7b75e; }
  @media (min-width: 720px) {
    .hero-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .section-heading { grid-template-columns: minmax(0,1fr) auto; }
    .boundaries { grid-template-columns: 1.1fr .9fr; align-items: center; }
  }
  @media (min-width: 940px) {
    .matrix-head { display: grid; grid-template-columns: 190px repeat(3,minmax(0,1fr)); }
    .matrix-head > span { padding: 16px; color: #b9c7d8; font-size: 9px; font-weight: 900; text-transform: uppercase; }
    .matrix-row { grid-template-columns: 190px repeat(3,minmax(0,1fr)); }
    .evidence-cell { border-top: 0; border-left: 1px solid #e5e9e4; }
    .mobile-exchange { display: none; }
  }
</style>
