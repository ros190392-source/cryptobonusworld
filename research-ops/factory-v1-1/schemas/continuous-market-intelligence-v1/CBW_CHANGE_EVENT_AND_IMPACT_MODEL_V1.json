{
  "schemaVersion": "1.0.0",
  "modelId": "CBW_CHANGE_EVENT_AND_IMPACT_MODEL_V1",
  "title": "CBW Change Event and Impact Model V1",
  "status": "ARCHITECTURE_DRAFT_FOR_OWNER_APPROVAL",
  "description": "Deterministic pipeline from a detected source change to impact analysis, patch proposal, policy lane, QA, publication, live verification and rollback. Architecture model only.",
  "sharedEnums": {
    "changeMateriality": ["NONE", "MINOR", "MODERATE", "MAJOR", "CRITICAL"],
    "policyLane": ["GREEN", "AMBER", "RED"],
    "agentWorkflowState": ["DETECTED", "EVIDENCE_CAPTURED", "EXTRACTED", "VALIDATED", "CONFLICTED", "IMPACT_ASSESSED", "PATCH_PROPOSED", "QA_PASSED", "AWAITING_OWNER", "PUBLISH_APPROVED", "PUBLISHED", "LIVE_VERIFIED", "ROLLED_BACK", "REJECTED", "SUPPRESSED"],
    "agentTerminalState": ["LIVE_VERIFIED", "ROLLED_BACK", "REJECTED", "SUPPRESSED"]
  },
  "entities": {
    "ChangeEvent": {
      "primaryKey": "changeEventId",
      "fields": {"sourceId": "SourceRegistryEntry.sourceId", "snapshotChangeId": "SnapshotChange.snapshotChangeId", "workflowState": "one of sharedEnums.agentWorkflowState", "idempotencyKey": "string derived from snapshotChangeId", "createdAt": "timestamp"},
      "invariants": ["duplicate ChangeEvents with the same idempotencyKey MUST be deduplicated"]
    },
    "MaterialityAssessment": {
      "primaryKey": "materialityAssessmentId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "materiality": "one of sharedEnums.changeMateriality", "rationale": "string", "assessedAt": "timestamp"}
    },
    "AffectedClaim": {
      "primaryKey": "affectedClaimId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "claimId": "Claim.claimId", "effect": "one of [CONFIRM, UPDATE, CONTRADICT, EXPIRE]"}
    },
    "AffectedMarketProfile": {
      "primaryKey": "affectedMarketProfileId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "marketProfileId": "marketProfileId"}
    },
    "AffectedPublicationBinding": {
      "primaryKey": "affectedPublicationBindingId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "bindingId": "PublicationBinding.bindingId", "impactStatus": "one of [NO_IMPACT, IMPACTED_MINOR, IMPACTED_MAJOR, IMPACTED_CRITICAL]"}
    },
    "ContentPatchProposal": {
      "primaryKey": "contentPatchProposalId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "bindingId": "PublicationBinding.bindingId", "changeType": "one of [SEMANTIC, FORMATTING]", "lane": "one of sharedEnums.policyLane", "diffSummary": "string"}
    },
    "PolicyLaneDecision": {
      "primaryKey": "policyLaneDecisionId",
      "fields": {"changeEventId": "ChangeEvent.changeEventId", "lane": "one of sharedEnums.policyLane", "autoPublishable": "boolean", "requiresTwoSources": "boolean", "requiresOwner": "boolean"},
      "invariants": [
        "lane GREEN MAY auto-publish formatting/non-critical updates with sufficient fresh evidence",
        "lane AMBER requires two sources or a primary source and holds for QA",
        "lane RED requires owner approval and MUST NOT auto-publish"
      ]
    },
    "QAVerdict": {
      "primaryKey": "qaVerdictId",
      "fields": {"contentPatchProposalId": "ContentPatchProposal.contentPatchProposalId", "verdict": "one of [PASS, FAIL, NEEDS_OWNER]", "checks": "array of check ids", "verifiedAt": "timestamp"}
    },
    "PublicationAction": {
      "primaryKey": "publicationActionId",
      "fields": {"contentPatchProposalId": "ContentPatchProposal.contentPatchProposalId", "action": "one of [PUBLISH, HOLD, SUPPRESS]", "ownerApproved": "boolean", "actedAt": "timestamp"}
    },
    "LiveVerification": {
      "primaryKey": "liveVerificationId",
      "fields": {"publicationActionId": "PublicationAction.publicationActionId", "outcome": "one of [MATCH, MISMATCH, ERROR]", "verifiedAt": "timestamp"}
    },
    "RollbackAction": {
      "primaryKey": "rollbackActionId",
      "fields": {"publicationActionId": "PublicationAction.publicationActionId", "reason": "string", "rolledBackAt": "timestamp"}
    }
  },
  "statusTransitions": [
    "DETECTED -> EVIDENCE_CAPTURED -> EXTRACTED -> VALIDATED",
    "VALIDATED -> CONFLICTED (if disagreement) -> IMPACT_ASSESSED",
    "VALIDATED -> IMPACT_ASSESSED -> PATCH_PROPOSED -> QA_PASSED",
    "QA_PASSED -> AWAITING_OWNER (RED) -> PUBLISH_APPROVED -> PUBLISHED -> LIVE_VERIFIED",
    "QA_PASSED -> PUBLISHED (GREEN auto) -> LIVE_VERIFIED",
    "any -> REJECTED or SUPPRESSED",
    "PUBLISHED/LIVE_VERIFIED -> ROLLED_BACK (on MISMATCH)"
  ],
  "terminalStates": ["LIVE_VERIFIED", "ROLLED_BACK", "REJECTED", "SUPPRESSED"],
  "crossReferences": [
    "../../templates/continuous-market-intelligence-v1/CBW_AUTONOMOUS_CONTENT_UPDATE_POLICY_V1.md",
    "../../templates/continuous-market-intelligence-v1/CBW_AGENT_ROLES_AND_STATE_MACHINE_V1.md",
    "./CBW_PUBLICATION_BINDING_MODEL_V1.json",
    "./CBW_SOURCE_REGISTRY_AND_MONITORING_MODEL_V1.json"
  ]
}
