---
import ExchangeLogo from '../ExchangeLogo.astro';
import PromoCodeCopy from '../promo/PromoCodeCopy.astro';
import { homepageTop10 } from '../../data/homepageTop10';
import '../../styles/site-standard-v1.css';
import { resolveHomepageTop10Ctas } from '../../data/homepageTop10Cta';
import { gateReasonText, ctaMicrocopy, pickLocalized } from '../../data/contracts/portalCtaI18n';
import type { CtaLocale } from '../../data/contracts/portalCta';
import Top10Disclosure from './Top10Disclosure.astro';
import { resolveDisclosure } from '../../data/contracts/portalDisclosure';
import { deriveCheckedDisplay } from '../../data/contracts/evidenceMetadata';
import { getOffer } from '../../data/offers';

// Current published locale for the homepage. All CTA labels and microcopy are
// sourced through the localization contract, so switching this constant
// localizes labels + reasons + microcopy together (facts are unaffected).
const ctaLocale: CtaLocale = 'en';

// Gated commercial CTA bindings, derived from the canonical fail-closed
// contract. In the default 'preview' mode every primary CTA resolves to an
// internal review target; a live /go/ affiliate target appears only when the
// owner enables production mode AND the row is verified + offer-eligible.
const ctaBindings = new Map(
  resolveHomepageTop10Ctas(homepageTop10, ctaLocale).map((b) => [b.rank, b]),
);

const opensNewTab = pickLocalized(ctaMicrocopy.opensNewTab, ctaLocale);
const loadingText = pickLocalized(ctaMicrocopy.loading, ctaLocale);

// Fail-closed evidence disclosure per row, derived from real records only.
// The visible "Checked" date is DERIVED from canonical machine evidence via
// deriveCheckedDisplay — never from the human `lastChecked` editorial string.
// Rows still under re-verification (evidence === null) carry no checked date;
// their honest status is conveyed by the disclosure tone instead. A source link
// is carried only when a real HTTPS promo URL exists.
const nowMs = Date.now();
const disclosures = new Map(
  homepageTop10.map((entry) => {
    const offer = getOffer(entry.slug);
    const binding = ctaBindings.get(entry.rank);
    const checked = deriveCheckedDisplay(entry.evidence ?? null, nowMs, ctaLocale);
    return [entry.rank, resolveDisclosure({
      tone: entry.statusTone,
      lastChecked: checked.display ?? undefined,
      lastCheckedIso: checked.iso ?? undefined,
      sourceHref: offer?.sourceUrl,
      isAffiliate: Boolean(binding?.primary.isAffiliate),
      methodologyHref: '/methodology/',
    }, ctaLocale)];
  }),
);
---

<section class="top10-section" id="exchanges" aria-labelledby="top10-title" data-cta-loading-text={loadingText}>
  <div class="top10-wrap">
    <div class="top10-heading">
      <div>
        <div class="top10-label">Editorial comparison · 10 exchanges</div>
        <h2 id="top10-title">Top 10 Crypto Exchanges to Compare</h2>
        <p>
          Ranked from the current CryptoBonusWorld editorial inventory. Offer and research badges show
          how far each listing has been verified — availability can still differ by country and account.
        </p>
      </div>
      <a href="/exchanges/" class="top10-directory-link">View full exchange directory →</a>
    </div>

    <div class="top10-column-head" aria-hidden="true">
      <span>Rank</span>
      <span>Exchange</span>
      <span>Best for</span>
      <span>Offer or evidence status</span>
      <span>Actions</span>
    </div>

    <ol class="top10-list">
      {homepageTop10.map((entry) => (
        <li class="top10-row" data-rank={entry.rank}>
          <div class="top10-rank" aria-label={`Rank ${entry.rank}`}>
            <span>{entry.rank}</span>
          </div>

          <div class="top10-exchange">
            <ExchangeLogo
              slug={entry.slug}
              name={entry.name}
              size={48}
              variant="square"
              lazy={entry.rank > 4}
              class="top10-logo"
            />
            <div class="top10-exchange-copy">
              <strong>{entry.name}</strong>
              <span class:list={['top10-status', `top10-status--${entry.statusTone}`]}>
                {entry.statusLabel}
              </span>
            </div>
          </div>

          <div class="top10-fit">
            <span class="top10-mobile-label">Best for</span>
            <p>{entry.bestFor}</p>
          </div>

          <div class="top10-evidence">
            <span class="top10-mobile-label">Offer or evidence status</span>
            <p class="top10-summary">{entry.summary}</p>
            {entry.promoCode && (
              <div class="top10-code">
                <span class="top10-code-label">Promo code</span>
                <PromoCodeCopy code={entry.promoCode} exchange={entry.name} />
              </div>
            )}
            {disclosures.get(entry.rank) && (
              <Top10Disclosure model={disclosures.get(entry.rank)!} />
            )}
          </div>

          <div class="top10-actions">
            {(() => {
              const cta = ctaBindings.get(entry.rank);
              if (!cta) return null;
              const p = cta.primary;
              const stateClass = `top10-primary--${p.visualState}`;

              // A withheld commercial action is a genuinely non-actionable
              // control (disabled <button>), never a JS-suppressed anchor. Its
              // accessible name carries the reason so it is unambiguous.
              if (p.disabled) {
                const reason = gateReasonText(p.gateReason, ctaLocale);
                return (
                  <button
                    type="button"
                    class:list={['top10-primary', 'top10-primary--disabled', stateClass]}
                    disabled
                    aria-label={`${p.label} at ${entry.name}: ${reason}`}
                  >
                    <span aria-hidden="true">{p.label}</span>
                    <span class="top10-primary-why" aria-hidden="true">{reason}</span>
                  </button>
                );
              }

              // Affiliate targets open externally with sponsored/nofollow rel;
              // internal review targets stay in-tab and non-sponsored. The
              // accessible name is exchange-qualified so screen-reader users do
              // not hear ten identical "Get bonus" links.
              const accessibleName = p.isAffiliate
                ? `${p.label} at ${entry.name} (${opensNewTab})`
                : `${p.label} — ${entry.name}`;
              return (
                <a
                  href={p.href}
                  class:list={['top10-primary', stateClass, { 'is-affiliate': p.isAffiliate }]}
                  data-cta-affiliate={p.isAffiliate ? 'true' : undefined}
                  target={p.isAffiliate ? '_blank' : undefined}
                  rel={p.isAffiliate ? p.rel : 'noopener'}
                  aria-label={accessibleName}
                >
                  <span class="top10-primary-label" aria-hidden="true">{p.label} →</span>
                  <span class="top10-primary-spinner" aria-hidden="true"></span>
                </a>
              );
            })()}
            {ctaBindings.get(entry.rank) && (
              <a href={ctaBindings.get(entry.rank)!.secondaryHref} class="top10-secondary" rel="noopener">
                {ctaBindings.get(entry.rank)!.secondaryLabel}
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="top10-method" id="top-10-methodology">
      <strong>How to read this list:</strong>
      rank reflects the current CryptoBonusWorld editorial inventory, not a personalized recommendation.
      A green badge means the clean offer record is verified; amber means a public preview; blue means
      completed country research with campaign eligibility still under review; gray means the profile is
      being re-verified. Always confirm current regional terms on the exchange’s official website.
    </div>

    <span class="top10-sr-only" data-cta-live role="status" aria-live="polite"></span>
  </div>
</section>

<script is:inline>
  // Progressive enhancement: a truthful, temporary, accessible "opening" state
  // for affiliate CTAs (which open in a NEW tab, so this page stays visible).
  // Works without JS (plain navigation). The state is always reset: on a short
  // timeout and whenever the user returns to this tab, so it never sticks.
  (function () {
    var section = document.getElementById('exchanges');
    if (!section) return;
    var loadingText = section.getAttribute('data-cta-loading-text') || 'Opening…';
    var live = section.querySelector('[data-cta-live]');
    var RESET_MS = 1400;

    function reset(el) {
      el.classList.remove('is-loading');
      el.removeAttribute('aria-busy');
      if (live) live.textContent = '';
    }
    function resetAll() {
      section.querySelectorAll('.top10-primary.is-loading').forEach(reset);
    }

    section.querySelectorAll('.top10-primary[data-cta-affiliate="true"]').forEach(function (el) {
      var timer = null;
      el.addEventListener('click', function (e) {
        // Ignore repeat activations while already opening (avoid duplicate tabs).
        if (el.classList.contains('is-loading')) { e.preventDefault(); return; }
        el.classList.add('is-loading');
        el.setAttribute('aria-busy', 'true');
        if (live) live.textContent = loadingText;
        clearTimeout(timer);
        timer = setTimeout(function () { reset(el); }, RESET_MS);
      });
    });

    // The affiliate link opens a new tab; clear the state as soon as the user
    // returns here (or the page is restored from bfcache).
    window.addEventListener('pageshow', resetAll);
    window.addEventListener('focus', resetAll);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') resetAll();
    });
  })();
</script>

<style>
  .top10-section {
    background: var(--cbw-surface-primary);
    padding: 18px 0 var(--cbw-space-9);
  }

  .top10-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .top10-wrap {
    width: 100%;
    max-width: var(--cbw-width-wide);
    margin: 0 auto;
    padding-inline: var(--cbw-gutter);
    box-sizing: border-box;
  }

  .top10-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--cbw-space-6);
    margin-bottom: 13px;
  }

  .top10-label {
    margin-bottom: 5px;
    color: var(--cbw-action);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .top10-heading h2 {
    margin: 0 0 5px;
    color: var(--cbw-text-primary);
    font-family: 'Barlow Condensed', 'Inter', sans-serif;
    font-size: clamp(27px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .top10-heading p {
    max-width: var(--cbw-width-prose);
    margin: 0;
    color: var(--cbw-text-secondary);
    font-size: 12px;
    line-height: 1.5;
  }

  .top10-directory-link {
    flex: 0 0 auto;
    color: #925204;
    font-size: 11px;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
  }

  .top10-directory-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .top10-column-head,
  .top10-row {
    display: grid;
    grid-template-columns: 46px minmax(150px, .9fr) minmax(142px, .84fr) minmax(258px, 1.5fr) minmax(142px, .74fr);
    gap: 12px;
    align-items: center;
  }

  .top10-column-head {
    padding: 0 13px 6px;
    color: var(--cbw-text-muted);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .top10-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top10-row {
    min-width: 0;
    padding: 11px 13px;
    border: 1px solid var(--cbw-border-standard);
    border-radius: var(--cbw-radius-card);
    background: var(--cbw-surface-primary);
    box-shadow: 0 1px 3px rgba(17,24,39,.04);
    transition: border-color .18s, box-shadow .18s, transform .18s;
  }

  .top10-row:hover {
    border-color: #cbd3cb;
    box-shadow: 0 7px 24px rgba(17,24,39,.08);
    transform: translateY(-1px);
  }

  .top10-rank {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .top10-rank span {
    display: inline-flex;
    width: 31px;
    height: 31px;
    align-items: center;
    justify-content: center;
    border-radius: var(--cbw-radius-pill);
    background: var(--cbw-text-primary);
    color: #fff;
    font-size: 13px;
    font-weight: 900;
  }

  .top10-row[data-rank='1'] .top10-rank span { color: var(--cbw-text-primary); background: var(--cbw-action); }
  .top10-row[data-rank='2'] .top10-rank span,
  .top10-row[data-rank='3'] .top10-rank span { background: #374151; }

  .top10-exchange {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 9px;
  }

  .top10-exchange-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .top10-exchange-copy strong {
    overflow: hidden;
    max-width: 100%;
    color: var(--cbw-text-primary);
    font-size: 15px;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top10-status {
    display: inline-flex;
    max-width: 100%;
    padding: 2px 7px;
    border: 1px solid transparent;
    border-radius: var(--cbw-radius-pill);
    font-size: 9px;
    font-weight: 900;
    line-height: 1.2;
  }

  .top10-status--verified { border-color: #bbf7d0; color: #166534; background: #f0fdf4; }
  .top10-status--preview { border-color: #fde68a; color: #92400e; background: #fffbeb; }
  .top10-status--research { border-color: #bfdbfe; color: #1d4ed8; background: #eff6ff; }
  .top10-status--review { border-color: #e5e7eb; color: #4b5563; background: #f9fafb; }

  .top10-fit,
  .top10-evidence,
  .top10-actions { min-width: 0; }

  .top10-fit p,
  .top10-summary {
    margin: 0;
    color: #374151;
    font-size: 11.5px;
    line-height: 1.45;
  }

  .top10-summary { color: var(--cbw-text-primary); font-weight: 700; }
  .top10-code { margin-top: 6px; }
  .top10-code-label { display: block; margin-bottom: 3px; color: #92400e; font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .top10-code :global(.pcc-row) { max-width: 240px; height: 36px; }
  .top10-code :global(.pcc-code) { padding: 0 9px; font-size: 13px; }
  .top10-code :global(.pcc-copy) { width: 52px; font-size: 9px; }
  .top10-checked { display: block; margin-top: 5px; color: #929ba7; font-size: 9px; line-height: 1.3; }

  .top10-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
  }

  .top10-primary,
  .top10-secondary {
    position: relative;
    display: flex;
    min-height: 35px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    box-sizing: border-box;
    border-radius: var(--cbw-radius-control);
    font-size: 11px;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .top10-primary {
    /* Site Standard v1 action styling (base) + Split-2 interaction states. */
    border: 1px solid rgba(19,35,62,.12);
    color: var(--cbw-text-primary);
    background: var(--cbw-action);
    box-shadow: 0 2px 7px rgba(247,147,26,.2);
    cursor: pointer;
    font-family: inherit;
    transition: background-color .16s, box-shadow .16s, transform .12s;
  }

  .top10-primary:hover { background: var(--cbw-action-hover); }

  .top10-primary:focus-visible,
  .top10-secondary:focus-visible {
    outline: 2px solid #0f766e;
    outline-offset: 2px;
  }

  .top10-primary:active {
    transform: translateY(1px);
    box-shadow: 0 1px 3px rgba(19, 35, 62, .18);
  }

  /* Withheld commercial action: a real disabled control, not a fake link. */
  .top10-primary--disabled,
  .top10-primary:disabled {
    flex-direction: column;
    gap: 2px;
    background: #f3f4f6;
    border-color: #e5e7eb;
    color: #6b7280;
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
  }

  .top10-primary-why {
    color: #6b7280;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.2;
    text-transform: none;
  }

  /* Loading state (progressive enhancement on affiliate outbound). Spinner
     uses currentColor so it stays legible on the Site Standard action color. */
  .top10-primary-spinner {
    display: none;
    width: 13px;
    height: 13px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    opacity: .85;
  }

  .top10-primary.is-loading { pointer-events: none; }
  .top10-primary.is-loading .top10-primary-label { opacity: .75; }
  .top10-primary.is-loading .top10-primary-spinner {
    display: inline-block;
    animation: top10-spin .6s linear infinite;
  }

  @keyframes top10-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .top10-row,
    .top10-row:hover,
    .top10-primary,
    .top10-primary:active {
      transition: none;
      transform: none;
    }

    .top10-primary.is-loading .top10-primary-spinner {
      animation: none;
    }
  }

  .top10-secondary { border: 1px solid #d1d5db; color: #374151; background: #fff; }
  .top10-secondary:hover { border-color: #9ca3af; background: #f9fafb; }
  .top10-mobile-label { display: none; }

  .top10-method {
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px solid var(--cbw-border-standard);
    border-radius: var(--cbw-radius-control);
    color: #6b7280;
    background: var(--cbw-surface-secondary);
    font-size: 10px;
    line-height: 1.6;
  }
  .top10-method strong { color: #374151; }

  @media (max-width: 959px) {
    .top10-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
    .top10-column-head { display: none; }
    .top10-row { grid-template-columns: 40px minmax(0,1fr); gap: 9px 11px; align-items: start; padding: 13px; }
    .top10-rank { grid-column: 1; grid-row: 1; padding-top: 6px; }
    .top10-exchange { grid-column: 2; grid-row: 1; }
    .top10-fit,
    .top10-evidence,
    .top10-actions { grid-column: 1 / -1; padding-left: 51px; }
    .top10-mobile-label { display: block; margin-bottom: 3px; color: #9ca3af; font-size: 8px; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
    .top10-actions { flex-direction: row; flex-wrap: wrap; }
    .top10-primary,
    .top10-secondary { min-width: 140px; flex: 1 1 140px; padding-inline: 12px; }
  }

  @media (max-width: 520px) {
    .top10-section { padding: 15px 0 var(--cbw-space-8); }
    .top10-heading { margin-bottom: 10px; }
    .top10-heading h2 { font-size: 25px; }
    .top10-heading p { font-size: 11px; line-height: 1.45; }
    .top10-directory-link { font-size: 10px; white-space: normal; }
    .top10-row { grid-template-columns: 36px minmax(0,1fr); padding: 12px 10px; }
    .top10-rank span { width: 29px; height: 29px; font-size: 12px; }
    .top10-exchange :global(.top10-logo) { width: 40px !important; height: 40px !important; }
    .top10-fit,
    .top10-evidence,
    .top10-actions { padding-left: 47px; }
    .top10-actions { flex-direction: column; }
    .top10-primary,
    .top10-secondary { width: 100%; min-width: 0; flex-basis: auto; }
    .top10-code :global(.pcc-row) { max-width: 100%; }
  }
</style>
